	PANEL_TWEEN = 0.18,
}
-- Strings do HUD/KiteRenderer (impl.) ----------------------------------------------------------------
local ptBR, en = Config.STRINGS.ptBR, Config.STRINGS.en
ptBR.close, en.close = "FECHAR", "CLOSE"
