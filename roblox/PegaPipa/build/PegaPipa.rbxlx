      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Remotes — nomes dos RemoteEvents (GDD §7.3), criação no servidor (init), busca no cliente (get),
	limitador token-bucket por jogador (limiter) e validadores numéricos (isFinite / isInt).
	Todo remote é hostil: o servidor valida tipo, faixa e distância antes de agir. Não existe RemoteFunction.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent:WaitForChild("Config"))

local Remotes = {}

Remotes.FOLDER_NAME = "Remotes"

-- C→S (GDD §7.3): Pull, SelectKite, Collect, Buy, ClaimStreak, ClaimDaily, Rebirth, Emote.
--   (impl.) SetPet (kiteId): toque longo na carta do varal marca/desmarca estimação (ShopService.setPet).
--   (impl.) Ready (): o LocalScript acabou de conectar State/Toast/ShopStock; o DataService reenvia o State
--   completo (e o popup Offline pendente) e o ShopService o estoque — o load do perfil pode ter disparado antes.
-- S→C: State, Toast, ShopStock
Remotes.NAMES = {
	"Pull", "SelectKite", "Collect", "Buy", "ClaimStreak", "ClaimDaily", "Rebirth", "Emote", "SetPet", "Ready",
	"State", "Toast", "ShopStock",
} :: { string }

type Bucket = { tokens: number, last: number }

export type Limiter = {
	allow: (self: Limiter, p: Player) -> boolean,
	forget: (self: Limiter, p: Player) -> (),
}

-- Servidor: cria ReplicatedStorage/Remotes/<nome> para cada nome (idempotente).
function Remotes.init(): ()
	local existing = ReplicatedStorage:FindFirstChild(Remotes.FOLDER_NAME)
	local folder: Instance
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name = Remotes.FOLDER_NAME
		created.Parent = ReplicatedStorage
		folder = created
	end
	for _, name in Remotes.NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

-- Cliente (ou servidor depois de init): espera o remote até REMOTE_WAIT s; avisa e continua esperando.
function Remotes.get(name: string): RemoteEvent
	assert(table.find(Remotes.NAMES, name) ~= nil, `[Remotes] nome desconhecido: {name}`)
	local folder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME, Config.REMOTE_WAIT)
	if not folder then
		warn(`[Remotes] pasta {Remotes.FOLDER_NAME} não apareceu em {Config.REMOTE_WAIT}s; continuando a esperar`)
		folder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	end
	local remote = folder:WaitForChild(name, Config.REMOTE_WAIT)
	if not remote then
		warn(`[Remotes] remote {name} não apareceu em {Config.REMOTE_WAIT}s; continuando a esperar`)
		remote = folder:WaitForChild(name)
	end
	return remote :: RemoteEvent
end

-- Token bucket por jogador: `rate` fichas/s, até `burst` acumuladas. Uso: if not lim:allow(p) then return end
function Remotes.limiter(rate: number, burst: number): Limiter
	local buckets: { [Player]: Bucket } = {}
	local limiter: Limiter = {
		allow = function(_self: Limiter, p: Player): boolean
			local now = os.clock()
			local bucket = buckets[p]
			if not bucket then
				bucket = { tokens = burst, last = now }
				buckets[p] = bucket
			end
			bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * rate)
			bucket.last = now
			if bucket.tokens >= 1 then
				bucket.tokens -= 1
				return true
			end
			return false
		end,
		forget = function(_self: Limiter, p: Player)
			buckets[p] = nil
		end,
	}
	return limiter
end

-- true só para number finito (nem NaN nem ±inf).
function Remotes.isFinite(n: unknown): boolean
	return typeof(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- true só para inteiro finito dentro de [min, max].
function Remotes.isInt(n: unknown, min: number, max: number): boolean
	if typeof(n) ~= "number" or n ~= n then
		return false
	end
	return n % 1 == 0 and n >= min and n <= max
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">Services</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	Bootstrap do servidor (GDD §7.1). Ordem fixa:
	Remotes.init → MapGen → DataService → MonetizationService → KiteService → ShopService → EventService → Leaderboard
	Cada módulo é carregado (require) e iniciado (start) dentro de pcall: um módulo quebrado não derruba os outros.
	Os serviços são ModuleScripts filhos deste Script (script.X); entre si usam script.Parent.X.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local function boot(name: string, fn: () -> ())
	local ok, err = pcall(function(): string?
		fn()
		return nil
	end)
	if ok then
		print(`[PegaPipa] {name} ok`)
	else
		warn(`[PegaPipa] {name} falhou: {err}`)
	end
end

boot("Remotes.init", function()
	Remotes.init()
end)
boot("MapGen", function()
	require(script.MapGen).start()
end)
boot("DataService", function()
	require(script.DataService).start()
end)
boot("MonetizationService", function()
	require(script.MonetizationService).start()
end)
boot("KiteService", function()
	require(script.KiteService).start()
end)
boot("ShopService", function()
	require(script.ShopService).start()
end)
boot("EventService", function()
	require(script.EventService).start()
end)
boot("Leaderboard", function()
	require(script.Leaderboard).start()
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	DataService — perfis (ProfileStore), laje do jogador, leaderstats, renda offline,
	Carretel/Vento, atributos do Player (GDD §7.4) e envio de estado ao cliente (State/Toast).

	Regras:
	- É a ÚNICA porta de entrada/saída de Vento: addVento / spendVento / collect.
	- Não requer nenhum outro serviço no topo (o analisador proíbe ciclos de require, mesmo
	  preguiçosos). O que vem "de cima" (KiteService, EventService, MonetizationService,
	  Leaderboard) entra por DataService.hooks, preenchido por esses serviços no start() deles.
	  MapGen (que só depende de Config) é requerido preguiçosamente dentro das funções.
	- Todo número vive em Config.
	- Quem altera profile.Data diretamente (ShopService, KiteService…) chama
	  DataService.pushState(p, { Campo = valor }) com os campos que mudou.
	- Remote Ready: o LocalScript pode conectar State/Toast depois de o perfil carregar; no Ready o State
	  completo é reenviado e o popup Offline que ficou pendente vai junto.
	- Passo 3 do funil (PrimeiraColeta, §5.8) é logado em collect().
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local AnalyticsService = game:GetService("AnalyticsService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local ProfileStore = require(script.Parent.ProfileStore)

export type ProfileData = Config.ProfileData
export type KiteData = Config.KiteData
export type Patch = { [string]: any }
export type WeeklyStat = "Vento" | "CortesPvP"

-- Perfil do ProfileStore visto pelo jogo, com Data/LastSavedData tipados como ProfileData.
-- (O genérico vendorizado `Profile<T>` usa `T & JSONAcceptable`, que o luau-lsp não unifica;
-- o cast para este tipo acontece uma única vez, em onPlayerAdded.)
type Connection = { Disconnect: (self: any) -> () }
export type Profile = {
	Data: ProfileData,
	LastSavedData: ProfileData, -- último snapshot salvo (idempotência do ProcessReceipt)
	Key: string,
	UserIds: { number },
	OnSave: { Connect: (self: any, listener: () -> ()) -> Connection },
	OnLastSave: { Connect: (self: any, listener: (reason: string) -> ()) -> Connection },
	OnSessionEnd: { Connect: (self: any, listener: () -> ()) -> Connection },
	OnAfterSave: { Connect: (self: any, listener: (lastSaved: ProfileData) -> ()) -> Connection },
	IsActive: (self: Profile) -> boolean,
	Reconcile: (self: Profile) -> (),
	EndSession: (self: Profile) -> (),
	AddUserId: (self: Profile, userId: number) -> (),
	Save: (self: Profile) -> (),
}

local STORE_NAME = "PegaPipa_v1"
local KICK_LOAD_FAILED = "Falha ao carregar seus dados. Tente entrar de novo."
local KICK_SESSION_END = "Seus dados foram abertos em outro servidor. Entre de novo."
local STEP_COLETA = table.find(Config.ONBOARDING_STEPS, "PrimeiraColeta") or 3 -- passo do funil (§5.8)

-- MapGen só é requerido dentro das funções (depois de MapGen.start()).
local function map()
	return require(script.Parent.MapGen)
end

local DataService = {}

-- Ganchos preenchidos pelos serviços de cima no start() deles. Os padrões são o comportamento
-- "sem o serviço": nada no ar, sem evento, sem passe, sem ranking.
DataService.hooks = {
	faixaOf = function(_p: Player): number -- KiteService (0 = nada no ar)
		return 0
	end,
	ventoMultiplier = function(): number -- EventService (1 / 2 / 4)
		return 1
	end,
	ventoMult = function(_p: Player): number -- MonetizationService: Vento em Dobro → 2
		return 1
	end,
	hasAutoReel = function(_p: Player): boolean -- MonetizationService: Carretel Automático
		return false
	end,
	isVIP = function(_p: Player): boolean -- MonetizationService
		return false
	end,
	offlineCap = function(_p: Player): number -- MonetizationService: OFFLINE_CAP ou OFFLINE_CAP_VIP
		return Config.OFFLINE_CAP
	end,
	addWeekly = function(_p: Player, _stat: WeeklyStat, _n: number) -- Leaderboard
	end,
}

-- Estado interno -------------------------------------------------------------------------------

local store = ProfileStore.New(STORE_NAME, Config.PROFILE_TEMPLATE)
local activeStore: typeof(store.Mock) = store
local storeDecided = false

local profiles: { [Player]: Profile } = {}
local lajeByPlayer: { [Player]: number } = {}
local rateCache: { [Player]: number } = {}
local rendaAcc: { [Player]: number } = {} -- Renda acumulada para o log de economia (1x/min)
local friendsOf: { [Player]: { [Player]: boolean } } = {}
local loadedCallbacks: { (p: Player, data: ProfileData) -> () } = {}

local stateRemote: RemoteEvent? = nil
local toastRemote: RemoteEvent? = nil
local collectLimiter = Remotes.limiter(Config.RATE.Collect[1], Config.RATE.Collect[2])
local readyLimiter = Remotes.limiter(Config.RATE.Ready[1], Config.RATE.Ready[2])
local clientReady: { [Player]: boolean } = {} -- o LocalScript já mandou Ready (ouve State/Toast)
local pendingOffline: { [Player]: Patch } = {} -- popup Offline esperando o cliente ficar pronto

-- Enum.AnalyticsEconomyTransactionType por fonte/sumidouro (padrão: Gameplay)
local TRANSACTION_TYPE: { [string]: string } = {
	Renda = "Gameplay", Offline = "Gameplay", Streak = "TimedReward", Daily = "TimedReward",
	VendaAuto = "Shop", Kit = "IAP", Produto = "IAP",
	Pipa = "Shop", Linha = "Shop", Vaga = "Shop", Renascer = "ProgressionReward",
}

-- Ajudantes ------------------------------------------------------------------------------------

local function dataOf(p: Player): ProfileData?
	local profile = profiles[p]
	if profile and profile:IsActive() then
		return profile.Data
	end
	return nil
end

local function rootOf(p: Player): BasePart?
	local character = p.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Log de economia: print + AnalyticsService (dentro de pcall; opcional).
local function logEconomy(p: Player, flow: Enum.AnalyticsEconomyFlowType, amount: number, balance: number, kind: string)
	if amount <= 0 then
		return
	end
	print(`[Economia] {p.Name} {flow.Name} {kind} {math.floor(amount)} → saldo {math.floor(balance)}`)
	pcall(function()
		AnalyticsService:LogEconomyEvent(p, flow, "Vento", math.floor(amount), math.floor(balance), TRANSACTION_TYPE[kind] or "Gameplay", kind)
	end)
end

-- Passo do funil de onboarding (§5.8): só avança; loga no AnalyticsService.
local function onboarding(p: Player, data: ProfileData, step: number)
	if data.Onboarding >= step then
		return
	end
	data.Onboarding = step
	DataService.pushState(p, { Onboarding = step })
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(p, step, Config.ONBOARDING_STEPS[step])
	end)
end

local function createLeaderstats(p: Player)
	if p:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in { "Vento", "Pipas", "Cortes", "Temporadas" } do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Value = 0
		value.Parent = folder
	end
	folder.Parent = p
end

local function syncLeaderstats(p: Player, data: ProfileData)
	local folder = p:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local function set(name: string, value: number)
		local stat = folder:FindFirstChild(name)
		if stat and stat:IsA("IntValue") then
			stat.Value = math.floor(value)
		end
	end
	set("Vento", data.Vento)
	set("Pipas", #data.Kites)
	set("Cortes", data.Stats.Cortes)
	set("Temporadas", data.Temporadas)
end

local function hasFriend(p: Player): boolean
	local set = friendsOf[p]
	return set ~= nil and next(set) ~= nil
end

-- Marca amizades com quem já está no servidor (bônus FRIEND_BONUS para os dois).
local function registerFriends(p: Player)
	for _, other in Players:GetPlayers() do
		if other ~= p then
			task.spawn(function()
				local ok, isFriend = pcall(p.IsFriendsWithAsync, p, other.UserId)
				local mine, theirs = friendsOf[p], friendsOf[other]
				if ok and isFriend == true and mine and theirs then
					mine[other] = true
					theirs[p] = true
				end
			end)
		end
	end
end

local function carretelCap(p: Player): number
	local rate = rateCache[p] or DataService.rateOf(p)
	return Config.CARRETEL_CAP_SECONDS * rate
end

local function novatoUntil(data: ProfileData): number
	return Workspace:GetServerTimeNow() + math.max(0, Config.NOVATO_SECONDS - data.PlayTime)
end

-- Patch completo enviado no load (as outras mudanças mandam só os campos alterados).
local function fullState(p: Player, data: ProfileData): Patch
	return {
		Vento = data.Vento,
		Carretel = data.Carretel,
		CarretelCap = carretelCap(p),
		Rate = rateCache[p] or 0,
		Linha = data.Linha,
		Vagas = data.Vagas,
		Temporadas = data.Temporadas,
		Kites = data.Kites,
		Selected = data.Selected,
		Streak = data.Streak,
		Dailies = data.Dailies,
		Novato = data.PlayTime < Config.NOVATO_SECONDS,
		NovatoUntil = novatoUntil(data),
		Onboarding = data.Onboarding,
	}
end

-- Vento entrando de fato no saldo (depois do carretel). Renda é logada agregada 1x/min.
local function creditVento(p: Player, data: ProfileData, n: number, source: string)
	data.Vento += n
	data.Stats.VentoTotal += n
	DataService.hooks.addWeekly(p, "Vento", n)
	if source == "Renda" then
		rendaAcc[p] = (rendaAcc[p] or 0) + n
	else
		logEconomy(p, Enum.AnalyticsEconomyFlowType.Source, n, data.Vento, source)
		DataService.pushState(p, { Vento = data.Vento })
	end
end

-- API pública: Vento ---------------------------------------------------------------------------

-- V/s atual (GDD §3.3). A pipa selecionada usa FAIXA_MULT[faixa]; as outras, VARAL_MULT.
function DataService.rateOf(p: Player): number
	local data = dataOf(p)
	if not data then
		return 0
	end
	local airMult = Config.FAIXA_MULT[DataService.hooks.faixaOf(p)] or Config.VARAL_MULT
	local sum = 0
	for _, k in data.Kites do
		local posMult = if k.id == data.Selected then airMult else Config.VARAL_MULT
		sum += Config.baseRate(k) * posMult
	end
	local friendMult = if hasFriend(p) then Config.FRIEND_BONUS else 1
	return sum
		* (1 + Config.REBIRTH_BONUS * data.Temporadas)
		* DataService.hooks.ventoMult(p)
		* DataService.hooks.ventoMultiplier()
		* friendMult
end

-- Única entrada de Vento. source "Renda" cai no carretel (cap CARRETEL_CAP_SECONDS × V/s),
-- salvo Carretel Automático; qualquer outra fonte (Offline, Streak, Daily, VendaAuto, Kit, Produto)
-- vai direto ao saldo e é logada.
function DataService.addVento(p: Player, n: number, source: string): ()
	local data = dataOf(p)
	if not data or not Remotes.isFinite(n) or n <= 0 then
		return
	end
	if source == "Renda" and not DataService.hooks.hasAutoReel(p) then
		local cap = carretelCap(p)
		data.Carretel = math.max(data.Carretel, math.min(cap, data.Carretel + n))
		return -- o tick de INCOME_TICK envia Carretel/CarretelCap
	end
	creditVento(p, data, n, source)
end

-- Gasta Vento; false se não há saldo. sink: Pipa | Linha | Vaga | Renascer.
function DataService.spendVento(p: Player, n: number, sink: string): boolean
	local data = dataOf(p)
	if not data or not Remotes.isFinite(n) or n < 0 or data.Vento < n then
		return false
	end
	data.Vento -= n
	logEconomy(p, Enum.AnalyticsEconomyFlowType.Sink, n, data.Vento, sink)
	DataService.pushState(p, { Vento = data.Vento })
	return true
end

-- Carretel → Vento se o jogador está a ≤ COLLECT_DIST do próprio carretel. Retorna o valor coletado.
function DataService.collect(p: Player): number
	local data = dataOf(p)
	local laje = lajeByPlayer[p]
	local root = rootOf(p)
	if not data or not laje or laje == 0 or not root then
		return 0
	end
	if (root.Position - map().carretelPos(laje)).Magnitude > Config.COLLECT_DIST then
		return 0
	end
	local n = data.Carretel
	if n <= 0 then
		return 0
	end
	data.Carretel = 0
	creditVento(p, data, n, "Renda")
	DataService.pushState(p, { Vento = data.Vento, Carretel = 0 })
	onboarding(p, data, STEP_COLETA)
	return n
end

-- API pública: pipas ---------------------------------------------------------------------------

local function kiteValue(k: KiteData): number -- venda automática: AUTO_SELL_MULT × base × (dourada ? 5 : 1)
	return Config.AUTO_SELL_MULT * Config.baseRate(k)
end

-- Candidata à venda automática: não é Jornal, não é estimação, não é de Temporada e não está selecionada
-- (a selecionada fica de fora para o KiteService nunca ver sua pipa no ar sumir do varal).
local function canAutoSell(k: KiteData, data: ProfileData): boolean
	return not k.starter and not k.pet and k.season == 0 and k.id ~= data.Selected
end

local function autoSell(p: Player, data: ProfileData, k: KiteData)
	local value = kiteValue(k)
	creditVento(p, data, value, "VendaAuto")
	DataService.toast(p, "VendaAuto", { kite = k.model, rarity = k.rarity, n = value })
end

-- Cria a pipa no varal. Varal cheio (#Kites == Vagas) → venda automática (GDD §3.4):
-- vende a candidata de menor valor, ou a própria pipa nova se ela vale ≤ a candidata (retorna nil).
function DataService.addKite(p: Player, model: string, rarity: number, color: number, golden: boolean?): KiteData?
	local data = dataOf(p)
	if not data then
		return nil
	end
	local newKite: KiteData = {
		id = data.NextKiteId,
		model = model,
		rarity = rarity,
		color = color,
		golden = golden == true,
		pet = false,
		season = 0,
		starter = false,
	}
	data.NextKiteId += 1
	if #data.Kites >= data.Vagas then
		local worstIndex, worstValue = 0, math.huge
		for i, k in data.Kites do
			if canAutoSell(k, data) and kiteValue(k) < worstValue then
				worstIndex, worstValue = i, kiteValue(k)
			end
		end
		if worstIndex == 0 or kiteValue(newKite) <= worstValue then
			autoSell(p, data, newKite)
			DataService.pushState(p, { Kites = data.Kites })
			return nil
		end
		local sold = table.remove(data.Kites, worstIndex) :: KiteData
		autoSell(p, data, sold)
	end
	table.insert(data.Kites, newKite)
	DataService.pushState(p, { Kites = data.Kites, Selected = data.Selected })
	return newKite
end

-- Tira a pipa do varal (corte, renascer). Se era a selecionada, Selected vira 0 (KiteService escolhe outra).
function DataService.removeKite(p: Player, id: number): KiteData?
	local data = dataOf(p)
	if not data then
		return nil
	end
	for i, k in data.Kites do
		if k.id == id then
			table.remove(data.Kites, i)
			if data.Selected == id then
				data.Selected = 0
			end
			DataService.pushState(p, { Kites = data.Kites, Selected = data.Selected })
			return k
		end
	end
	return nil
end

function DataService.findKite(p: Player, id: number): KiteData?
	local data = dataOf(p)
	if not data then
		return nil
	end
	for _, k in data.Kites do
		if k.id == id then
			return k
		end
	end
	return nil
end

-- API pública: consultas -----------------------------------------------------------------------

function DataService.get(p: Player): Profile?
	local profile = profiles[p]
	if profile and profile:IsActive() then
		return profile
	end
	return nil
end

function DataService.lajeOf(p: Player): number
	return lajeByPlayer[p] or 0
end

function DataService.isNovato(p: Player): boolean
	local data = dataOf(p)
	return data ~= nil and data.PlayTime < Config.NOVATO_SECONDS
end

-- Chama cb para todo perfil carregado (inclusive os que já estavam carregados ao registrar).
function DataService.onLoaded(cb: (p: Player, data: ProfileData) -> ()): ()
	table.insert(loadedCallbacks, cb)
	for p in profiles do
		local data = dataOf(p)
		if data then
			task.spawn(cb, p, data)
		end
	end
end

-- API pública: cliente -------------------------------------------------------------------------

-- Envia um patch de State (§7.3) e espelha leaderstats/atributo Temporadas.
function DataService.pushState(p: Player, patch: Patch): ()
	local data = dataOf(p)
	if data then
		syncLeaderstats(p, data)
		p:SetAttribute("Temporadas", data.Temporadas)
	end
	if stateRemote then
		stateRemote:FireClient(p, patch)
	end
end

-- Toast para um jogador ou para todos (p = nil). kinds em §7.3.
function DataService.toast(p: Player?, kind: string, args: Patch): ()
	if not toastRemote then
		return
	end
	if p then
		toastRemote:FireClient(p, kind, args)
	else
		toastRemote:FireAllClients(kind, args)
	end
end

-- Laje -----------------------------------------------------------------------------------------

local function assignLaje(p: Player): number
	for i = 1, Config.LAJE_COUNT do
		local model = map().lajeModel(i)
		if model:GetAttribute("OwnerId") == 0 then
			model:SetAttribute("OwnerId", p.UserId)
			lajeByPlayer[p] = i
			p:SetAttribute("Laje", i)
			return i
		end
	end
	warn(`[DataService] sem laje livre para {p.Name}`)
	return 0
end

local function releaseLaje(p: Player)
	local i = lajeByPlayer[p]
	lajeByPlayer[p] = nil
	if not i or i == 0 then
		return
	end
	local ok, model = pcall(function()
		return map().lajeModel(i)
	end)
	if ok and model:GetAttribute("OwnerId") == p.UserId then
		model:SetAttribute("OwnerId", 0)
	end
end

local function spawnOnLaje(p: Player, character: Model)
	local i = lajeByPlayer[p]
	if not i or i == 0 then
		return
	end
	task.wait()
	character:PivotTo(CFrame.new(map().lajeFloor(i) + Vector3.new(0, 3, 0)))
end

-- Carga do perfil ------------------------------------------------------------------------------

-- Renda offline (§3.3): todas as pipas a OFFLINE_MULT, sem evento/amizade, elapsed limitado ao cap.
local function creditOffline(p: Player, data: ProfileData)
	if data.LastSeen <= 0 then
		return
	end
	local elapsed = math.min(os.time() - data.LastSeen, DataService.hooks.offlineCap(p))
	if elapsed < Config.OFFLINE_MIN then
		return
	end
	local sum = 0
	for _, k in data.Kites do
		sum += Config.baseRate(k)
	end
	local amount = math.floor(sum * Config.OFFLINE_MULT * (1 + Config.REBIRTH_BONUS * data.Temporadas) * DataService.hooks.ventoMult(p) * elapsed)
	if amount <= 0 then
		return
	end
	creditVento(p, data, amount, "Offline")
	local args: Patch = { n = amount, time = elapsed }
	if clientReady[p] then
		DataService.toast(p, "Offline", args)
	else
		pendingOffline[p] = args -- o LocalScript ainda não ouve o Toast: vai junto com o Ready
	end
end

local function onProfileLoaded(p: Player, data: ProfileData)
	createLeaderstats(p)
	p:SetAttribute("Novato", data.PlayTime < Config.NOVATO_SECONDS)
	p:SetAttribute("VIP", DataService.hooks.isVIP(p))
	p:SetAttribute("RabiolaRank", 0)
	p:SetAttribute("Emote", "")
	p:SetAttribute("Temporadas", data.Temporadas)
	creditOffline(p, data)
	data.LastSeen = os.time()
	rateCache[p] = DataService.rateOf(p)
	DataService.pushState(p, fullState(p, data))
	for _, cb in loadedCallbacks do
		task.spawn(cb, p, data)
	end
end

local function onPlayerAdded(p: Player)
	friendsOf[p] = {}
	registerFriends(p)
	assignLaje(p)
	p.CharacterAdded:Connect(function(character)
		spawnOnLaje(p, character)
	end)
	if p.Character then
		task.spawn(spawnOnLaje, p, p.Character)
	end

	while not storeDecided do
		task.wait()
	end
	local raw = activeStore:StartSessionAsync(`User_{p.UserId}`, { Steal = false })
	if raw == nil then
		p:Kick(KICK_LOAD_FAILED)
		return
	end
	local profile = (raw :: any) :: Profile
	profile:AddUserId(p.UserId)
	profile:Reconcile()
	profile.OnSessionEnd:Connect(function()
		profiles[p] = nil
		if p.Parent == Players then
			p:Kick(KICK_SESSION_END)
		end
	end)
	if p.Parent ~= Players then
		profile:EndSession()
		return
	end
	profiles[p] = profile
	onProfileLoaded(p, profile.Data)
end

local function onPlayerRemoving(p: Player)
	local profile = profiles[p]
	if profile then
		if profile:IsActive() then
			local data: ProfileData = profile.Data
			data.LastSeen = os.time()
		end
		profiles[p] = nil
		profile:EndSession()
	end
	releaseLaje(p)
	local set = friendsOf[p]
	if set then
		for other in set do
			local theirs = friendsOf[other]
			if theirs then
				theirs[p] = nil
			end
		end
	end
	friendsOf[p] = nil
	rateCache[p] = nil
	rendaAcc[p] = nil
	collectLimiter:forget(p)
	readyLimiter:forget(p)
	clientReady[p] = nil
	pendingOffline[p] = nil
end

-- Tick de renda (INCOME_TICK s) ------------------------------------------------------------------

local function tickPlayer(p: Player, dt: number)
	local data = dataOf(p)
	if not data then
		return
	end
	data.PlayTime += dt
	data.LastSeen = os.time()
	if p:GetAttribute("Novato") == true and data.PlayTime >= Config.NOVATO_SECONDS then
		p:SetAttribute("Novato", false)
		DataService.pushState(p, { Novato = false })
	end
	local rate = DataService.rateOf(p)
	rateCache[p] = rate
	DataService.addVento(p, rate * dt, "Renda")
	DataService.pushState(p, { Vento = data.Vento, Carretel = data.Carretel, CarretelCap = carretelCap(p), Rate = rate })
end

local function flushRendaLog()
	for p, n in rendaAcc do
		local data = dataOf(p)
		if data and n > 0 then
			logEconomy(p, Enum.AnalyticsEconomyFlowType.Source, n, data.Vento, "Renda")
		end
		rendaAcc[p] = 0
	end
end

local function startTick()
	task.spawn(function()
		local sinceLog = 0
		while true do
			local dt = task.wait(Config.INCOME_TICK)
			for p in profiles do
				local ok, err = pcall(function(): string?
					tickPlayer(p, dt)
					return nil
				end)
				if not ok then
					warn(`[DataService] tick de {p.Name} falhou: {err}`)
				end
			end
			sinceLog += dt
			if sinceLog >= Config.ECONOMY_LOG_EVERY then
				sinceLog = 0
				flushRendaLog()
			end
		end
	end)
end

-- No Studio sem acesso à API do DataStore usa ProfileStore.Mock (nada é salvo).
local function decideStore()
	if RunService:IsStudio() then
		local ok = pcall(function()
			DataStoreService:GetDataStore("PegaPipa_probe"):GetAsync("probe")
		end)
		if not ok then
			warn("[DataService] API do DataStore indisponível no Studio: usando ProfileStore.Mock (nada será salvo)")
			activeStore = store.Mock
		end
	end
	storeDecided = true
end

-- Prompt "Pegar Vento" do carretel (criado pelo MapGen com a tag Carretel).
local function hookCarretel(inst: Instance)
	local prompt = inst:FindFirstChildWhichIsA("ProximityPrompt")
	if prompt then
		prompt.Triggered:Connect(function(p: Player)
			DataService.collect(p)
		end)
	end
end

-- Remote Ready: o LocalScript acabou de conectar State/Toast/ShopStock. Reenvia o State completo (o load do
-- perfil pode ter disparado antes de o cliente ouvir) e o popup Offline que ficou pendente.
local function onReady(p: Player)
	if not readyLimiter:allow(p) then
		return
	end
	clientReady[p] = true
	local data = dataOf(p)
	if not data then
		return -- o perfil ainda não carregou: o load manda tudo
	end
	DataService.pushState(p, fullState(p, data))
	local pending = pendingOffline[p]
	if pending then
		pendingOffline[p] = nil
		DataService.toast(p, "Offline", pending)
	end
end

function DataService.start(): ()
	stateRemote = Remotes.get("State")
	toastRemote = Remotes.get("Toast")
	Remotes.get("Collect").OnServerEvent:Connect(function(p: Player)
		if collectLimiter:allow(p) then
			DataService.collect(p)
		end
	end)
	Remotes.get("Ready").OnServerEvent:Connect(onReady)
	for _, inst in CollectionService:GetTagged("Carretel") do
		hookCarretel(inst)
	end
	CollectionService:GetInstanceAddedSignal("Carretel"):Connect(hookCarretel)

	task.spawn(decideStore)
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
	startTick()
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	EventService — eventos de servidor (GDD §5.3): a cada EVENT_INTERVAL s após o fim do anterior (o 1º
	forçado aos FIRST_EVENT_AT s de vida do servidor) sorteia pela tabela Config.EVENTS:
	  Rajada  → KiteService.setWildBoost (selvagens mais frequentes, tabela Rajada) por `duration`;
	  Chuva   → RAIN_COUNT KiteService.drop de RAIN_FROM_Y em pontos aleatórios do campinho;
	  Dourado → ao fim, 1 jogador aleatório na faixa 4 ganha uma pipa Dourada (ou "passou em branco");
	  Virou   → aviso de `duration` s e depois KiteService.setWind(-WindSign).
	Todo evento tem fase Warn (EVENT_WARN s; o Virou usa a própria duração) e Active.
	Festival do Morro (sábado FESTIVAL.hourUTC UTC, FESTIVAL.minutes min): Chuva a cada rainEvery s,
	ventoMultiplier × FESTIVAL.ventoMult e atributo Festival = true (KiteService pinta pegas de cor 9).
	Boosts pagos (startServerBoost): Rajada no Servidor e Vento Forte por BOOST_SECONDS.

	Escreve em workspace.World: EventName, EventPhase, EventEndsAt, Festival, BoostRajadaUntil,
	BoostVentoUntil, BoostBy. Toasts (broadcast): Evento {event, phase, endsAt}, Boost {kind, name},
	Dourada {name = "", kite = "", blank = true} quando o Vento Dourado passa em branco.
	Requer: Config, Remotes (nada direto), DataService, KiteService. NUNCA requer ShopService/
	MonetizationService. Registra DataService.hooks.ventoMultiplier no start().
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local DataService = require(script.Parent.DataService)
local KiteService = require(script.Parent.KiteService)

export type EventPhase = "Warn" | "Active"
export type CurrentEvent = { name: string, phase: EventPhase, endsAt: number }
export type BoostKind = "Rajada" | "VentoForte"

type EventDef = { name: string, chance: number, duration: number }

local EVENT_RAJADA = "Rajada"
local EVENT_CHUVA = "Chuva"
local EVENT_DOURADO = "Dourado"
local EVENT_VIROU = "Virou"
local EVENT_FESTIVAL = "Festival"
local LOOP_STEP = 1 -- s entre checagens do relógio (não é regra de jogo)

local EventService = {}

local rng = Random.new()
local current: CurrentEvent? = nil
local nextEventAt = 0
local festival = false
local boostVentoUntil = 0
local boostRajadaUntil = 0

-- Ajudantes --------------------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- workspace/World (Configuration criada pelo MapGen; criada aqui se faltar).
local function world(): Configuration
	local found = Workspace:FindFirstChild("World")
	if found and found:IsA("Configuration") then
		return found
	end
	local conf = Instance.new("Configuration")
	conf.Name = "World"
	conf:SetAttribute("WindSign", 1)
	conf.Parent = Workspace
	return conf
end

local function findDef(name: string): EventDef?
	for _, def in Config.EVENTS do
		if def.name == name then
			return def
		end
	end
	return nil
end

-- Sorteio pela coluna `chance` (35/25/20/20).
local function pickEvent(): EventDef
	local total = 0
	for _, def in Config.EVENTS do
		total += def.chance
	end
	local roll = rng:NextNumber() * total
	for _, def in Config.EVENTS do
		if def.chance > 0 and roll < def.chance then
			return def
		end
		roll -= def.chance
	end
	return Config.EVENTS[1]
end

-- Atualiza `current`, os atributos de workspace.World e manda o banner para todos.
local function setPhase(name: string, phase: EventPhase, endsAt: number)
	current = { name = name, phase = phase, endsAt = endsAt }
	local w = world()
	w:SetAttribute("EventName", name)
	w:SetAttribute("EventPhase", phase)
	w:SetAttribute("EventEndsAt", endsAt)
	DataService.toast(nil, "Evento", { event = name, phase = phase, endsAt = endsAt })
end

local function clearEvent()
	current = nil
	local w = world()
	w:SetAttribute("EventName", "")
	w:SetAttribute("EventPhase", "")
	w:SetAttribute("EventEndsAt", 0)
end

local function randomColor(): number
	return rng:NextInteger(1, Config.COSMETIC_COLORS)
end

-- Efeitos ------------------------------------------------------------------------------------------

-- Chuva de Pipas: RAIN_COUNT pipas (tabela Rajada) caem de RAIN_FROM_Y em pontos aleatórios do campinho.
local function rain()
	for _ = 1, Config.RAIN_COUNT do
		local rarity = KiteService.rollRarity(Config.WILD_TABLE_RAJADA)
		local model = Config.MODEL_BY_RARITY[rarity] or Config.MODEL_BY_RARITY[1]
		KiteService.drop(model, rarity, randomColor(), KiteService.randomLandPos(), nil)
	end
end

-- Vento Dourado: 1 jogador aleatório na faixa 4 ganha a pipa Dourada; ninguém → "passou em branco".
local function goldenFinish()
	local candidates = KiteService.playersAtFaixa4()
	if #candidates == 0 then
		DataService.toast(nil, "Dourada", { name = "", kite = "", blank = true })
		return
	end
	local p = candidates[rng:NextInteger(1, #candidates)]
	local profile = DataService.get(p)
	if profile and profile.Data.Selected ~= 0 then
		KiteService.makeGolden(p, profile.Data.Selected)
	end
end

local function currentWindSign(): number
	local sign = world():GetAttribute("WindSign")
	return if sign == -1 then -1 else 1
end

-- Roda um evento completo (Warn → Active → fim) e agenda o próximo. Deve rodar em task.spawn.
local function runEvent(def: EventDef)
	local name = def.name
	local warnTime = if name == EVENT_VIROU then def.duration else Config.EVENT_WARN
	setPhase(name, "Warn", now() + warnTime)
	task.wait(warnTime)

	local t = now()
	if name == EVENT_RAJADA then
		local endsAt = t + def.duration
		setPhase(name, "Active", endsAt)
		KiteService.setWildBoost(Config.RAJADA.interval[1], Config.RAJADA.interval[2], Config.RAJADA.maxInAir, Config.WILD_TABLE_RAJADA, endsAt)
		task.wait(def.duration)
	elseif name == EVENT_CHUVA then
		setPhase(name, "Active", t + def.duration)
		rain()
		task.wait(def.duration)
	elseif name == EVENT_DOURADO then
		setPhase(name, "Active", t + def.duration)
		task.wait(def.duration)
		goldenFinish()
	elseif name == EVENT_VIROU then
		KiteService.setWind(-currentWindSign())
		setPhase(name, "Active", t + Config.EVENT_WARN) -- banner "Virou o Vento" por EVENT_WARN s
		task.wait(Config.EVENT_WARN)
	end

	clearEvent()
	nextEventAt = now() + rng:NextNumber(Config.EVENT_INTERVAL[1], Config.EVENT_INTERVAL[2])
end

-- Festival do Morro ----------------------------------------------------------------------------------

local function inFestivalWindow(): boolean
	local date = os.date("!*t")
	local f = Config.FESTIVAL
	return date.wday == f.wday and date.hour == f.hourUTC and date.min < f.minutes
end

-- Chuva a cada rainEvery s enquanto o Festival durar (como evento quando o céu está livre).
local function festivalRains()
	task.spawn(function()
		while festival do
			if current == nil then
				local def = findDef(EVENT_CHUVA)
				if def then
					task.spawn(runEvent, def)
				end
			else
				rain()
			end
			task.wait(Config.FESTIVAL.rainEvery)
		end
	end)
end

local function setFestival(on: boolean)
	if festival == on then
		return
	end
	festival = on
	world():SetAttribute("Festival", on)
	if on then
		local endsAt = now() + Config.FESTIVAL.minutes * 60
		DataService.toast(nil, "Evento", { event = EVENT_FESTIVAL, phase = "Active", endsAt = endsAt })
		festivalRains()
	end
end

-- Laço ---------------------------------------------------------------------------------------------

local function loop()
	while true do
		task.wait(LOOP_STEP)
		local ok, err = pcall(function(): string?
			setFestival(inFestivalWindow())
			if current == nil and now() >= nextEventAt then
				nextEventAt = math.huge -- runEvent reagenda ao terminar
				task.spawn(runEvent, pickEvent())
			end
			return nil
		end)
		if not ok then
			warn(`[EventService] laço falhou: {err}`)
		end
	end
end

-- API pública -----------------------------------------------------------------------------------------

function EventService.start(): ()
	DataService.hooks.ventoMultiplier = EventService.ventoMultiplier
	local w = world()
	w:SetAttribute("Festival", false)
	w:SetAttribute("BoostRajadaUntil", 0)
	w:SetAttribute("BoostVentoUntil", 0)
	w:SetAttribute("BoostBy", "")
	clearEvent()
	nextEventAt = now() + Config.FIRST_EVENT_AT
	task.spawn(loop)
end

function EventService.current(): CurrentEvent?
	return current
end

-- 1 normal; ×FESTIVAL.ventoMult no Festival; ×BOOST_VENTO_MULT com Vento Forte (acumulam → 4).
function EventService.ventoMultiplier(): number
	local mult = 1
	if festival then
		mult *= Config.FESTIVAL.ventoMult
	end
	if boostVentoUntil > now() then
		mult *= Config.BOOST_VENTO_MULT
	end
	return mult
end

function EventService.isFestival(): boolean
	return festival
end

-- Força um evento agora (Rajada | Chuva | Dourado | Virou); ignorado se já há um em andamento.
function EventService.force(name: string): ()
	local def = findDef(name)
	if not def then
		warn(`[EventService] evento desconhecido: {name}`)
		return
	end
	if current ~= nil then
		warn(`[EventService] já há um evento em andamento ({current.name}); force({name}) ignorado`)
		return
	end
	nextEventAt = math.huge
	task.spawn(runEvent, def)
end

-- Boost pago por BOOST_SECONDS para todo o servidor (prolonga se já ativo); banner "Fulano pagou…".
function EventService.startServerBoost(kind: BoostKind, by: Player): ()
	local t = now()
	local w = world()
	if kind == "Rajada" then
		boostRajadaUntil = math.max(t, boostRajadaUntil) + Config.BOOST_SECONDS
		KiteService.setWildBoost(Config.BOOST_RAJADA.interval[1], Config.BOOST_RAJADA.interval[2], Config.BOOST_RAJADA.maxInAir, Config.WILD_TABLE_RAJADA, boostRajadaUntil)
		w:SetAttribute("BoostRajadaUntil", boostRajadaUntil)
	else
		boostVentoUntil = math.max(t, boostVentoUntil) + Config.BOOST_SECONDS
		w:SetAttribute("BoostVentoUntil", boostVentoUntil)
	end
	w:SetAttribute("BoostBy", by.DisplayName)
	DataService.toast(nil, "Boost", { kind = kind, name = by.DisplayName })
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">KiteService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	KiteService — a mecânica central (GDD §2): uma pipa no ar por jogador, faixas 0-4, o botão PUXAR
	(remote Pull "Down"/"Up": toque < TAP_MAX sobe ou rabeia, segurar desce 1 faixa a cada
	HOLD_DESCEND_EVERY), deriva no anel compartilhado (§2.4), selvagens (§2.8), rabeio/duelo (§2.3),
	queda e pega pública (§2.5), Árvore do Campinho (§2.6), escudo de novato e Pipa de Jornal (§2.7),
	anti-AFK "linha frouxa" (§3.3), tutorial da Pipa de Treino aos TUTORIAL_AT s e passos do funil
	1/2/4/5 (§5.8).

	Servidor-autoritativo: nenhuma pipa tem física. As posições são calculadas aqui e escritas como
	Attributes (GDD §7.4) em workspace/KiteStates/<id> (Configuration com tag Kite) a SYNC_HZ; o cliente
	só interpola. Tempos replicados usam workspace:GetServerTimeNow(); os tempos do dedo (toque/segurar)
	usam os.clock().

	Dono de profile.Data.Selected: no load escolhe a pipa de maior base×(dourada ? 5 : 1) e a sobe;
	quando Selected == 0 (corte, venda, renascer) escolhe outra. Pipa cortada sai do perfil NA HORA
	(DataService.removeKite) e volta por DataService.addKite na pega ou quando a árvore expira.
	Escreve VaralCodes na laje do dono: "model:rarity:color:golden,…" (golden = "true"/"false") das pipas
	fora do ar.

	Requer: Config, Remotes, DataService, MapGen. NUNCA requer ShopService/EventService/MonetizationService/
	Leaderboard: eles assinam onDuelEnd/onCatch ou entram por DataService.hooks (addWeekly, hasAutoReel);
	o Festival é lido de workspace.World (atributo Festival).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local AnalyticsService = game:GetService("AnalyticsService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local DataService = require(script.Parent.DataService)
local MapGen = require(script.Parent.MapGen)

export type KiteState = {
	id: number, -- id único no servidor (nome da Configuration)
	owner: number, -- userId; 0 = selvagem
	model: string,
	rarity: number,
	color: number,
	golden: boolean,
	faixa: number,
	theta: number, -- ângulo no anel (rad)
	pos: Vector3,
	status: string, -- Flying | Dueling | Falling | Ground | Tree
	statusUntil: number, -- fim do estado atual (GetServerTimeNow); 0 em Flying
	duelWith: number?, -- id da pipa adversária
	immuneUntil: number, -- não pode ser rabeada até aqui
	wild: boolean,
	tutorialFor: Player?, -- Pipa de Treino deste novato
	landPos: Vector3?, -- ponto de pouso (Falling/Ground) ou TREE_TOP (Tree)
	conf: Configuration,
	-- internos (não fazem parte do contrato §7.2)
	profileId: number?, -- id da pipa no perfil do dono (KiteData.id)
	laje: number?, -- laje do dono
	ownerName: string?, -- nome exibido do dono (sobrevive à saída dele)
	points: number?, -- pontos fixos (Pipa de Treino = 0); nil = WILD_POINTS[raridade]
	wildPhase: string?, -- Enter | Orbit | Exit | Tutorial
	wildTarget: Vector3?, -- destino nas fases Enter/Exit
	orbitLeft: number?, -- radianos que faltam da volta contra o vento
	diveTarget: Vector3?, -- destino do mergulho de quem rabeou
	rain: boolean?, -- Chuva de Pipas: some se ninguém pegar (não vai à árvore)
}

export type WildOpts = { tutorialFor: Player?, points: number? }
export type DuelEndCallback = (winner: Player?, loser: Player?, wild: boolean) -> ()
export type CatchCallback = (p: Player, k: KiteState) -> ()

type ProfileData = Config.ProfileData
type KiteData = Config.KiteData
type Duel = { a: KiteState, b: KiteState, endsAt: number }
type WildBoost = { intervalMin: number, intervalMax: number, maxInAir: number, weights: { number }, untilTime: number }
type Sample = { pos: Vector3, t: number }

local STATUS_FLYING = "Flying"
local STATUS_DUELING = "Dueling"
local STATUS_FALLING = "Falling"
local STATUS_GROUND = "Ground"
local STATUS_TREE = "Tree"
local STARTER_MODEL = "Jornal" -- só a starter usa este modelo (GDD §3.2)
local WILD_TUTORIAL_RARITY = 1 -- Pipa de Treino é Comum

local KiteService = {}

local rng = Random.new()

-- Estado -----------------------------------------------------------------------------------------

local kites: { [number]: KiteState } = {} -- por id do servidor
local flying: { [Player]: KiteState } = {} -- a pipa no ar de cada jogador
local duels: { Duel } = {}
local nextId = 1
local windSign = 1

-- botão PUXAR (os.clock)
local holdStart: { [Player]: number } = {}
local holding: { [Player]: boolean } = {}
local holdSeq: { [Player]: number } = {} -- invalida o laço de descida anterior num Down→Up→Down rápido
local lastHoldEnd: { [Player]: number } = {}
local tapCooldown: { [Player]: number } = {}

-- anti-AFK e anti-teleport
local lastPull: { [Player]: number } = {}
local afkNextDrop: { [Player]: number } = {}
local moveSample: { [Player]: Sample } = {}
local catchBanUntil: { [Player]: number } = {}
local tutorialGiven: { [Player]: boolean } = {}

-- selvagens
local wildBoost: WildBoost? = nil
local nextWildAt = 0

local duelEndCallbacks: { DuelEndCallback } = {}
local catchCallbacks: { CatchCallback } = {}

local pullLimiter = Remotes.limiter(Config.RATE.Pull[1], Config.RATE.Pull[2])
local selectLimiter = Remotes.limiter(Config.RATE.SelectKite[1], Config.RATE.SelectKite[2])
local emoteLimiter = Remotes.limiter(Config.RATE.Emote[1], Config.RATE.Emote[2])

-- Ajudantes --------------------------------------------------------------------------------------

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- workspace/World (Configuration criada pelo MapGen; criada aqui se faltar).
local function world(): Configuration
	local found = Workspace:FindFirstChild("World")
	if found and found:IsA("Configuration") then
		return found
	end
	local conf = Instance.new("Configuration")
	conf.Name = "World"
	conf:SetAttribute("WindSign", 1)
	conf.Parent = Workspace
	return conf
end

-- workspace/KiteStates (Folder criada pelo MapGen; criada aqui se faltar).
local function statesFolder(): Folder
	local found = Workspace:FindFirstChild("KiteStates")
	if found and found:IsA("Folder") then
		return found
	end
	local folder = Instance.new("Folder")
	folder.Name = "KiteStates"
	folder.Parent = Workspace
	return folder
end

local function setAttr(inst: Instance, name: string, value: any)
	if inst:GetAttribute(name) ~= value then
		inst:SetAttribute(name, value)
	end
end

local function rootOf(p: Player): BasePart?
	local character = p.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function dataOf(p: Player): ProfileData?
	local profile = DataService.get(p)
	return if profile then profile.Data else nil
end

local function ownerPlayer(k: KiteState): Player?
	if k.owner == 0 then
		return nil
	end
	return Players:GetPlayerByUserId(k.owner)
end

local function isFestival(): boolean
	return world():GetAttribute("Festival") == true
end

local function ringPos(r: number, h: number, theta: number): Vector3
	return Vector3.new(r * math.cos(theta), h, r * math.sin(theta))
end

-- Anda de `from` para `to` no máximo `maxStep` studs.
local function moveToward(from: Vector3, to: Vector3, maxStep: number): Vector3
	local delta = to - from
	local dist = delta.Magnitude
	if dist <= maxStep then
		return to
	end
	return from + delta * (maxStep / dist)
end

local function toast(p: Player?, kind: string, args: { [string]: any })
	DataService.toast(p, kind, args)
end

-- Passo do funil de onboarding (§5.8): só avança; loga no AnalyticsService.
local function onboarding(p: Player, step: number)
	local data = dataOf(p)
	if not data or data.Onboarding >= step then
		return
	end
	data.Onboarding = step
	DataService.pushState(p, { Onboarding = step })
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(p, step, Config.ONBOARDING_STEPS[step])
	end)
end

-- Ponto aleatório do campinho (x ∈ [-landX, landX], z ∈ [-landZ, landZ], y = LAND_Y).
function KiteService.randomLandPos(): Vector3
	local c = Config.CAMPINHO
	return Vector3.new(rng:NextNumber(-c.landX, c.landX), Config.LAND_Y, rng:NextNumber(-c.landZ, c.landZ))
end

-- Sorteia uma raridade (1..6) por uma tabela de pesos (WILD_TABLE, WILD_TABLE_RAJADA…).
function KiteService.rollRarity(weights: { number }): number
	local total = 0
	for _, w in weights do
		total += w
	end
	local roll = rng:NextNumber() * total
	for i, w in weights do
		if w > 0 and roll < w then
			return i
		end
		roll -= w
	end
	return 1
end

-- Pipa de maior base×(dourada ? 5 : 1) do varal (seleção padrão, §2.1).
local function bestKite(data: ProfileData): KiteData?
	local best: KiteData? = nil
	local bestRate = -1
	for _, k in data.Kites do
		local rate = Config.baseRate(k)
		if rate > bestRate then
			best, bestRate = k, rate
		end
	end
	return best
end

-- Posição-alvo de uma pipa de jogador pela faixa (§2.2).
local function lajeGoal(k: KiteState): Vector3
	local laje = k.laje or 1
	if k.faixa >= 3 then
		local ring = Config.RING[k.faixa]
		return ringPos(ring.r, ring.h, k.theta)
	elseif k.faixa >= 1 then
		return MapGen.lajeFloor(laje) + Vector3.new(0, Config.FAIXA_HEIGHT_ABOVE_LAJE[k.faixa], 0)
	end
	local c = MapGen.carretelPos(laje) -- faixa 0: pousada logo acima do carretel
	return Vector3.new(c.X, Config.LAJE_FLOOR_Y + Config.FAIXA_HEIGHT_ABOVE_LAJE[0], c.Z)
end

local function linhaOf(k: KiteState): number
	if k.wild then
		return k.points or Config.WILD_POINTS[k.rarity]
	end
	local p = ownerPlayer(k)
	local data = if p then dataOf(p) else nil
	return if data then data.Linha else 1
end

-- Configuration ---------------------------------------------------------------------------------

local function syncConf(k: KiteState)
	local conf = k.conf
	setAttr(conf, "Faixa", k.faixa)
	setAttr(conf, "Pos", k.pos)
	setAttr(conf, "Status", k.status)
	setAttr(conf, "StatusUntil", k.statusUntil)
	setAttr(conf, "DuelWith", k.duelWith or 0)
	setAttr(conf, "DuelEndsAt", if k.status == STATUS_DUELING then k.statusUntil else 0)
	setAttr(conf, "LandPos", k.landPos or Vector3.zero)
	setAttr(conf, "Golden", k.golden)
	setAttr(conf, "Linha", linhaOf(k))
end

-- Cria o estado + a Configuration (tag Kite) em workspace/KiteStates/<id>.
local function newState(owner: number, ownerName: string, model: string, rarity: number, color: number, golden: boolean, wild: boolean): KiteState
	local id = nextId
	nextId += 1
	local conf = Instance.new("Configuration")
	conf.Name = tostring(id)
	conf:SetAttribute("Id", id)
	conf:SetAttribute("Owner", owner)
	conf:SetAttribute("OwnerName", ownerName)
	conf:SetAttribute("Model", model)
	conf:SetAttribute("Rarity", rarity)
	conf:SetAttribute("Color", color)
	conf:SetAttribute("Wild", wild)
	conf:AddTag("Kite")
	local k: KiteState = {
		id = id,
		owner = owner,
		model = model,
		rarity = rarity,
		color = color,
		golden = golden,
		faixa = 0,
		theta = 0,
		pos = Vector3.zero,
		status = STATUS_FLYING,
		statusUntil = 0,
		immuneUntil = 0,
		wild = wild,
		conf = conf,
		ownerName = ownerName,
	}
	kites[id] = k
	syncConf(k)
	conf.Parent = statesFolder()
	return k
end

local function destroyKite(k: KiteState)
	kites[k.id] = nil
	local p = ownerPlayer(k)
	if p and flying[p] == k then
		flying[p] = nil
	end
	k.conf:Destroy()
end

-- Varal ------------------------------------------------------------------------------------------

-- VaralCodes da laje do dono: pipas fora do ar, "model:rarity:color:golden,…".
local function updateVaral(p: Player, data: ProfileData)
	local laje = DataService.lajeOf(p)
	if laje == 0 then
		return
	end
	local k = flying[p]
	local inAir = if k then k.profileId else nil
	local codes = {}
	for _, kd in data.Kites do
		if kd.id ~= inAir then
			table.insert(codes, `{kd.model}:{kd.rarity}:{kd.color}:{tostring(kd.golden)}`)
		end
	end
	setAttr(MapGen.lajeModel(laje), "VaralCodes", table.concat(codes, ","))
end

-- Pipa do jogador ---------------------------------------------------------------------------------

local function setFaixa(k: KiteState, faixa: number)
	local old = k.faixa
	k.faixa = math.clamp(faixa, 0, 4)
	if k.faixa >= 3 and old < 3 then
		k.theta = MapGen.lajeAngle(k.laje or 1) -- entra no anel no ângulo da própria laje
	end
end

-- Sobe a pipa `profileId` do perfil de p na faixa 0.
local function putUp(p: Player, profileId: number)
	local kd = DataService.findKite(p, profileId)
	local laje = DataService.lajeOf(p)
	if not kd or laje == 0 then
		return
	end
	local k = newState(p.UserId, p.DisplayName, kd.model, kd.rarity, kd.color, kd.golden, false)
	k.profileId = kd.id
	k.laje = laje
	k.theta = MapGen.lajeAngle(laje)
	k.pos = lajeGoal(k)
	flying[p] = k
	syncConf(k)
end

-- Garante que a pipa no ar é a Selected do perfil (e que Selected aponta para uma pipa que existe).
local function watchSelection(p: Player, data: ProfileData)
	local k: KiteState? = flying[p]
	if k and k.status ~= STATUS_FLYING then
		return -- em duelo: espera resolver
	end
	if k and DataService.findKite(p, k.profileId or 0) == nil then
		destroyKite(k) -- a pipa sumiu do perfil (renascer, venda)
		k = nil
	end
	if data.Selected ~= 0 and DataService.findKite(p, data.Selected) == nil then
		data.Selected = 0
	end
	if data.Selected == 0 then
		local best = bestKite(data)
		if not best then
			return
		end
		data.Selected = best.id
		DataService.pushState(p, { Selected = best.id })
	end
	if k == nil or k.profileId ~= data.Selected then
		if k then
			destroyKite(k)
		end
		putUp(p, data.Selected)
	end
end

-- Queda, chão, árvore e pega (§2.5 / §2.6) ----------------------------------------------------------

local function startFall(k: KiteState, t: number, landPos: Vector3?)
	k.status = STATUS_FALLING
	k.faixa = 0
	k.duelWith = nil
	k.diveTarget = nil
	k.landPos = landPos or KiteService.randomLandPos()
	k.statusUntil = t + Config.FALL_TIME
	toast(nil, "Voada", {
		name = k.ownerName or "",
		kite = k.model,
		rarity = k.rarity,
		landPos = k.landPos,
		untilTime = t + Config.FALL_TIME + Config.GROUND_TIME,
		wild = k.wild,
	})
end

local function toTree(k: KiteState, t: number)
	k.status = STATUS_TREE
	k.pos = Config.TREE_TOP
	k.landPos = Config.TREE_TOP
	k.statusUntil = t + Config.TREE_TIME
	local p = ownerPlayer(k)
	if p then
		toast(p, "Arvore", { time = Config.TREE_TIME })
	end
end

-- Árvore expirou: dono online → volta ao varal; senão a pipa é destruída.
local function treeExpire(k: KiteState)
	local p = ownerPlayer(k)
	if p and dataOf(p) then
		DataService.addKite(p, k.model, k.rarity, k.color, k.golden)
	end
	destroyKite(k)
end

local function catchKite(p: Player, k: KiteState)
	local data = dataOf(p)
	if not data then
		return
	end
	local color = if isFestival() then Config.FESTIVAL.color else k.color
	DataService.addKite(p, k.model, k.rarity, color, k.golden)
	data.Stats.Pegas += 1
	toast(p, "Pegou", { kite = k.model, rarity = k.rarity })
	if k.owner ~= 0 and k.owner ~= p.UserId then
		local ex = ownerPlayer(k)
		if ex then
			toast(ex, "PegaramSua", { name = p.DisplayName, kite = k.model })
		end
	end
	onboarding(p, 5)
	destroyKite(k)
	for _, cb in catchCallbacks do
		task.spawn(cb, p, k)
	end
end

-- Anti-teleport: salto > TELEPORT_JUMP studs em TELEPORT_WINDOW s → TELEPORT_PENALTY s fora da pega.
local function sampleMovement(p: Player, t: number)
	local root = rootOf(p)
	if not root then
		moveSample[p] = nil
		return
	end
	local sample = moveSample[p]
	if not sample then
		moveSample[p] = { pos = root.Position, t = t }
		return
	end
	if t - sample.t >= Config.TELEPORT_WINDOW then
		if (root.Position - sample.pos).Magnitude > Config.TELEPORT_JUMP then
			catchBanUntil[p] = t + Config.TELEPORT_PENALTY
		end
		moveSample[p] = { pos = root.Position, t = t }
	end
end

-- HumanoidRootPart mais próximo a ≤ radius da pipa (qualquer jogador, inclusive o dono).
local function nearestCatcher(k: KiteState, radius: number, t: number): Player?
	local best: Player? = nil
	local bestDist = radius
	for _, p in Players:GetPlayers() do
		if (catchBanUntil[p] or 0) > t or not DataService.get(p) then
			continue
		end
		local root = rootOf(p)
		if not root then
			continue
		end
		local d = (root.Position - k.pos).Magnitude
		if d <= bestDist then
			best, bestDist = p, d
		end
	end
	return best
end

-- Duelo (§2.3 passos 3-6) ---------------------------------------------------------------------------

local function isHolding(p: Player): boolean
	return holding[p] == true or (os.clock() - (lastHoldEnd[p] or -math.huge)) <= Config.HOLD_GRACE
end

local function duelPoints(k: KiteState): number
	if k.wild then
		return k.points or Config.WILD_POINTS[k.rarity]
	end
	local p = ownerPlayer(k)
	local data = if p then dataOf(p) else nil
	local linha = if data then data.Linha else 1
	local bonus = if p and isHolding(p) then Config.HOLD_BONUS else 0
	return linha + bonus + rng:NextInteger(0, Config.DUEL_RANDOM)
end

-- Alvo do rabeio: pipa Flying de outro dono (ou selvagem) sem imunidade a ≤ RABEIO_RANGE; precisa da
-- própria faixa ≥ 3, salvo a Pipa de Treino deste jogador (vale em qualquer faixa ≥ 1).
local function findRabeioTarget(p: Player, k: KiteState, t: number): KiteState?
	local best: KiteState? = nil
	local bestDist = Config.RABEIO_RANGE
	for _, o in kites do
		if o == k or o.status ~= STATUS_FLYING or o.owner == k.owner or o.immuneUntil > t then
			continue
		end
		local tutorial = o.tutorialFor == p
		if not o.wild and o.faixa < 3 then
			continue
		end
		if tutorial and k.faixa < 1 then
			continue
		end
		if not tutorial and k.faixa < 3 then
			continue
		end
		local d = (o.pos - k.pos).Magnitude
		if d <= bestDist then
			best, bestDist = o, d
		end
	end
	return best
end

local function duelToast(k: KiteState, opponent: KiteState, endsAt: number)
	local p = ownerPlayer(k)
	if not p then
		return
	end
	local name = if opponent.wild then Config.str("wild", "pt-BR") else (opponent.ownerName or "")
	toast(p, "Duelo", { opponent = name, linha = linhaOf(opponent), endsAt = endsAt, wild = opponent.wild })
end

local function startRabeio(a: KiteState, b: KiteState, t: number)
	local endsAt = t + Config.RABEIO_TIME + Config.DUEL_TIME
	a.status, b.status = STATUS_DUELING, STATUS_DUELING
	a.duelWith, b.duelWith = b.id, a.id
	a.statusUntil, b.statusUntil = endsAt, endsAt
	local dir = b.pos - a.pos
	if dir.Magnitude > 0 then
		a.diveTarget = a.pos + dir.Unit * Config.RABEIO_DIVE
	end
	table.insert(duels, { a = a, b = b, endsAt = endsAt })
	duelToast(a, b, endsAt)
	duelToast(b, a, endsAt)
end

local function backToFlying(k: KiteState)
	k.status = STATUS_FLYING
	k.statusUntil = 0
	k.duelWith = nil
	k.diveTarget = nil
end

-- Perdedor: selvagem cai; novato/Jornal/Carretel Automático volta à laje; senão sai do perfil e cai.
local function loseKite(k: KiteState, lp: Player?, t: number)
	if k.wild or not lp then
		backToFlying(k)
		startFall(k, t, nil)
		return
	end
	local shield = DataService.isNovato(lp) or k.model == STARTER_MODEL or DataService.hooks.hasAutoReel(lp)
	if shield then
		backToFlying(k)
		setFaixa(k, 0)
		k.pos = lajeGoal(k)
		k.immuneUntil = t + Config.POST_DUEL_IMMUNITY
		toast(lp, "Voou", { shield = true })
		return
	end
	DataService.removeKite(lp, k.profileId or 0) -- Selected vira 0; watchSelection sobe outra
	flying[lp] = nil
	toast(lp, "Voou", { shield = false })
	backToFlying(k)
	startFall(k, t, nil)
	local data = dataOf(lp)
	if data then
		updateVaral(lp, data)
	end
end

local function resolveDuel(d: Duel, t: number)
	local a, b = d.a, d.b
	if kites[a.id] ~= a or kites[b.id] ~= b then
		-- um lado sumiu (jogador saiu): o outro volta a voar sem vencedor
		for _, k in { a, b } do
			if kites[k.id] == k then
				backToFlying(k)
			end
		end
		return
	end
	local pa, pb = duelPoints(a), duelPoints(b)
	local tie = pa == pb
	local aWins = if tie then rng:NextInteger(0, 1) == 0 else pa > pb
	local winner = if aWins then a else b
	local loser = if aWins then b else a
	local wp, lp = ownerPlayer(winner), ownerPlayer(loser)
	if tie then
		for _, p in { wp, lp } do
			if p then
				toast(p, "Sorte", {})
			end
		end
	end
	backToFlying(winner)
	winner.immuneUntil = t + Config.POST_DUEL_IMMUNITY
	if wp then
		toast(wp, "Cortou", {})
		local data = dataOf(wp)
		if data then
			data.Stats.Cortes += 1
			if not loser.wild then
				data.Stats.CortesPvP += 1
				DataService.hooks.addWeekly(wp, "CortesPvP", 1)
			end
		end
		onboarding(wp, 4)
	end
	loseKite(loser, lp, t)
	for _, cb in duelEndCallbacks do
		task.spawn(cb, wp, lp, a.wild or b.wild)
	end
end

-- Botão PUXAR (§2.3 passos 2-3) -----------------------------------------------------------------------

local function onTap(p: Player)
	local clock = os.clock()
	if (tapCooldown[p] or 0) > clock then
		return
	end
	local k = flying[p]
	if not k or k.status ~= STATUS_FLYING then
		return
	end
	local t = now()
	local target = findRabeioTarget(p, k, t)
	if target then
		startRabeio(k, target, t)
	elseif k.faixa < 4 then
		setFaixa(k, k.faixa + 1)
	end
	tapCooldown[p] = clock + Config.TAP_COOLDOWN
end

-- Segurar: desce 1 faixa agora e a cada HOLD_DESCEND_EVERY enquanto o dedo estiver no botão.
local function beginHold(p: Player)
	local seq = (holdSeq[p] or 0) + 1
	holdSeq[p] = seq
	holding[p] = true
	task.spawn(function()
		while holding[p] and holdSeq[p] == seq do
			local k = flying[p]
			if k and k.status == STATUS_FLYING and k.faixa > 0 then
				setFaixa(k, k.faixa - 1)
			end
			task.wait(Config.HOLD_DESCEND_EVERY)
		end
	end)
end

local function endHold(p: Player)
	holding[p] = nil
end

local function onPull(p: Player, phase: unknown)
	if not pullLimiter:allow(p) then
		return
	end
	if phase ~= "Down" and phase ~= "Up" then
		return
	end
	lastPull[p] = os.clock()
	afkNextDrop[p] = nil
	onboarding(p, 2)
	if phase == "Down" then
		if holdStart[p] then
			return -- já pressionado
		end
		local t0 = os.clock()
		holdStart[p] = t0
		task.delay(Config.TAP_MAX, function()
			if holdStart[p] == t0 then
				beginHold(p)
			end
		end)
	else
		local t0 = holdStart[p]
		if not t0 then
			return
		end
		holdStart[p] = nil
		if os.clock() - t0 < Config.TAP_MAX then
			onTap(p)
		else
			endHold(p)
		end
		lastHoldEnd[p] = os.clock()
	end
end

-- Anti-AFK (§3.3): AFK_SECONDS sem Pull → desce 1 faixa a cada AFK_DROP_EVERY.
local function antiAfk(p: Player)
	local k = flying[p]
	local clock = os.clock()
	if not k or k.status ~= STATUS_FLYING or k.faixa == 0 then
		return
	end
	if clock - (lastPull[p] or clock) < Config.AFK_SECONDS then
		return
	end
	if clock >= (afkNextDrop[p] or 0) then
		setFaixa(k, k.faixa - 1)
		afkNextDrop[p] = clock + Config.AFK_DROP_EVERY
	end
end

-- Selvagens (§2.8) -----------------------------------------------------------------------------------

local function countWilds(): number
	local n = 0
	for _, k in kites do
		if k.wild and k.tutorialFor == nil and (k.status == STATUS_FLYING or k.status == STATUS_DUELING) then
			n += 1
		end
	end
	return n
end

local function activeBoost(t: number): WildBoost?
	local boost = wildBoost
	if boost and boost.untilTime > t then
		return boost
	end
	return nil
end

local function wildInterval(t: number): number
	local boost = activeBoost(t)
	if boost then
		return rng:NextNumber(boost.intervalMin, boost.intervalMax)
	end
	return rng:NextNumber(Config.WILD_INTERVAL[1], Config.WILD_INTERVAL[2])
end

-- Ponto onde a Pipa de Treino paira: ao lado da pipa do novato (ou da laje dele), rumo ao centro.
local function tutorialHover(k: KiteState): Vector3
	local p = k.tutorialFor
	local mine = if p then flying[p] else nil
	local base: Vector3
	if mine and mine.faixa >= 1 then
		base = mine.pos
	else
		base = MapGen.lajeFloor(k.laje or 1) + Vector3.new(0, Config.FAIXA_HEIGHT_ABOVE_LAJE[1], 0)
	end
	local flat = Vector3.new(base.X, 0, base.Z)
	local dir = if flat.Magnitude > 0 then -flat.Unit else Vector3.xAxis
	return base + dir * (Config.RABEIO_RANGE / 2)
end

local function wildStep(k: KiteState, dt: number)
	if k.status ~= STATUS_FLYING then
		return
	end
	local phase = k.wildPhase
	local h = Config.RING[math.max(3, k.faixa)].h
	if phase == "Tutorial" then
		k.pos = moveToward(k.pos, tutorialHover(k), Config.WILD_SPEED * dt)
	elseif phase == "Enter" then
		local target = k.wildTarget or k.pos
		k.pos = moveToward(k.pos, target, Config.WILD_SPEED * dt)
		if k.pos == target then
			k.wildPhase = "Orbit"
			k.orbitLeft = 2 * math.pi
		end
	elseif phase == "Orbit" then
		k.theta -= windSign * Config.WILD_OMEGA * dt -- contra o vento
		k.orbitLeft = (k.orbitLeft or 0) - Config.WILD_OMEGA * dt
		k.pos = ringPos(Config.WILD_RING_R, h, k.theta)
		if (k.orbitLeft or 0) <= 0 then
			k.wildPhase = "Exit"
			k.wildTarget = ringPos(Config.MAP_RADIUS, h, k.theta)
		end
	elseif phase == "Exit" then
		local target = k.wildTarget or k.pos
		k.pos = moveToward(k.pos, target, Config.WILD_SPEED * dt)
		if k.pos == target then
			destroyKite(k)
		end
	end
end

-- Tick (SYNC_HZ) ---------------------------------------------------------------------------------------

-- Deriva no anel (§2.4) e transições a KITE_MOVE_SPEED; quem rabeou mergulha RABEIO_DIVE.
local function playerStep(k: KiteState, dt: number)
	if k.status == STATUS_FLYING and k.faixa >= 3 then
		local peso = 1 - Config.RARITY_WEIGHT_STEP * (k.rarity - 1)
		k.theta += windSign * Config.RING[k.faixa].omega * peso * dt
	end
	local goal = if k.status == STATUS_DUELING and k.diveTarget then k.diveTarget else lajeGoal(k)
	k.pos = moveToward(k.pos, goal, Config.KITE_MOVE_SPEED * dt)
end

local function fallStep(k: KiteState, t: number, dt: number)
	local land = k.landPos or k.pos
	local remaining = k.statusUntil - t
	if remaining <= 0 then
		k.pos = land
		k.status = STATUS_GROUND
		k.statusUntil = t + Config.GROUND_TIME
	else
		k.pos = k.pos:Lerp(land, math.min(1, dt / remaining))
	end
end

local function stepKite(k: KiteState, t: number, dt: number)
	if k.status == STATUS_FLYING or k.status == STATUS_DUELING then
		if k.wild then
			if k.status == STATUS_DUELING and k.diveTarget then
				k.pos = moveToward(k.pos, k.diveTarget, Config.KITE_MOVE_SPEED * dt)
			else
				wildStep(k, dt)
			end
		else
			playerStep(k, dt)
		end
	elseif k.status == STATUS_FALLING then
		fallStep(k, t, dt)
	elseif k.status == STATUS_GROUND then
		local catcher = nearestCatcher(k, Config.CATCH_RADIUS, t)
		if catcher then
			catchKite(catcher, k)
		elseif t >= k.statusUntil then
			if k.rain then
				destroyKite(k) -- Chuva de Pipas: não pegas somem
			else
				toTree(k, t)
			end
		end
	elseif k.status == STATUS_TREE then
		local catcher = nearestCatcher(k, Config.TREE_CATCH_RADIUS, t)
		if catcher then
			catchKite(catcher, k)
		elseif t >= k.statusUntil then
			treeExpire(k)
		end
	end
end

local function spawnWildIfDue(t: number)
	if t < nextWildAt then
		return
	end
	local boost = activeBoost(t)
	local maxInAir = if boost then boost.maxInAir else Config.WILD_MAX
	if countWilds() < maxInAir then
		KiteService.spawnWild(nil, nil, nil)
	end
	nextWildAt = t + wildInterval(t)
end

local function tick(t: number, dt: number)
	for _, p in Players:GetPlayers() do
		sampleMovement(p, t)
		local data = dataOf(p)
		if data then
			watchSelection(p, data)
			antiAfk(p)
			updateVaral(p, data)
		end
	end
	local snapshot = {}
	for _, k in kites do
		table.insert(snapshot, k)
	end
	for _, k in snapshot do
		if kites[k.id] == k then
			stepKite(k, t, dt)
		end
	end
	for i = #duels, 1, -1 do
		local d = duels[i]
		if t >= d.endsAt then
			table.remove(duels, i)
			resolveDuel(d, t)
		end
	end
	spawnWildIfDue(t)
	for _, k in kites do
		syncConf(k)
	end
end

-- Jogadores -------------------------------------------------------------------------------------------

local function onLoaded(p: Player, data: ProfileData)
	lastPull[p] = os.clock()
	onboarding(p, 1)
	watchSelection(p, data)
	updateVaral(p, data)
	-- Pipa de Treino aos TUTORIAL_AT s de sessão, se ainda é novato e nunca cortou
	task.delay(Config.TUTORIAL_AT, function()
		local current = dataOf(p)
		if p.Parent ~= Players or tutorialGiven[p] or not current then
			return
		end
		if not DataService.isNovato(p) or current.Onboarding >= 4 then
			return
		end
		tutorialGiven[p] = true
		KiteService.spawnWild(WILD_TUTORIAL_RARITY, nil, { tutorialFor = p, points = Config.TUTORIAL_WILD_POINTS })
	end)
end

local function onPlayerRemoving(p: Player)
	local mine = flying[p]
	if mine then
		destroyKite(mine)
	end
	local tutorials = {}
	for _, k in kites do
		if k.tutorialFor == p then
			table.insert(tutorials, k)
		end
	end
	for _, k in tutorials do
		destroyKite(k)
	end
	holdStart[p] = nil
	holding[p] = nil
	holdSeq[p] = nil
	lastHoldEnd[p] = nil
	tapCooldown[p] = nil
	lastPull[p] = nil
	afkNextDrop[p] = nil
	moveSample[p] = nil
	catchBanUntil[p] = nil
	tutorialGiven[p] = nil
	pullLimiter:forget(p)
	selectLimiter:forget(p)
	emoteLimiter:forget(p)
end

local function onEmote(p: Player, id: unknown)
	if not emoteLimiter:allow(p) then
		return
	end
	local max = if p:GetAttribute("VIP") == true then 5 else 4
	if not Remotes.isInt(id, 1, max) then
		return
	end
	local name = `emote{id}`
	p:SetAttribute("Emote", name)
	task.delay(Config.EMOTE_SECONDS, function()
		if p.Parent == Players and p:GetAttribute("Emote") == name then
			p:SetAttribute("Emote", "")
		end
	end)
end

-- API pública -------------------------------------------------------------------------------------------

function KiteService.start(): ()
	DataService.hooks.faixaOf = KiteService.faixaOf
	local w = world()
	local sign = w:GetAttribute("WindSign")
	windSign = if sign == -1 then -1 else 1
	statesFolder()

	Remotes.get("Pull").OnServerEvent:Connect(onPull)
	Remotes.get("SelectKite").OnServerEvent:Connect(function(p: Player, kiteId: unknown)
		if not selectLimiter:allow(p) then
			return
		end
		local data = dataOf(p)
		if not data or not Remotes.isInt(kiteId, 1, data.NextKiteId) then
			return
		end
		KiteService.select(p, kiteId :: number)
	end)
	Remotes.get("Emote").OnServerEvent:Connect(onEmote)

	DataService.onLoaded(onLoaded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	nextWildAt = now() + wildInterval(now())
	task.spawn(function()
		while true do
			local dt = task.wait(1 / Config.SYNC_HZ)
			local ok, err = pcall(function(): string?
				tick(now(), dt)
				return nil
			end)
			if not ok then
				warn(`[KiteService] tick falhou: {err}`)
			end
		end
	end)
end

function KiteService.flyingOf(p: Player): KiteState?
	return flying[p]
end

-- Faixa da pipa no ar (0 se nada no ar).
function KiteService.faixaOf(p: Player): number
	local k = flying[p]
	return if k then k.faixa else 0
end

-- Troca a pipa selecionada; só com a atual Flying na faixa 0 (ou nada no ar).
function KiteService.select(p: Player, kiteId: number): boolean
	local data = dataOf(p)
	if not data or DataService.findKite(p, kiteId) == nil then
		return false
	end
	local k = flying[p]
	if k and (k.status ~= STATUS_FLYING or k.faixa ~= 0) then
		return false
	end
	if k and k.profileId == kiteId then
		return true
	end
	if k then
		destroyKite(k)
	end
	data.Selected = kiteId
	DataService.pushState(p, { Selected = kiteId })
	putUp(p, kiteId)
	updateVaral(p, data)
	return true
end

-- Puxa a pipa para a faixa 0 na hora (se estiver em duelo, vale depois dele).
function KiteService.recall(p: Player): ()
	local k = flying[p]
	if not k then
		return
	end
	setFaixa(k, 0)
	if k.status == STATUS_FLYING then
		k.pos = lajeGoal(k)
	end
end

-- Selvagem: entra pela borda, uma volta contra o vento no anel WILD_RING_R e sai; com tutorialFor,
-- é a Pipa de Treino que paira ao lado da pipa do novato.
function KiteService.spawnWild(rarity: number?, color: number?, opts: WildOpts?): KiteState
	local t = now()
	local boost = activeBoost(t)
	local weights = if boost then boost.weights else Config.WILD_TABLE
	local r = rarity or KiteService.rollRarity(weights)
	local c = color or rng:NextInteger(1, Config.COSMETIC_COLORS)
	local k = newState(0, "", Config.MODEL_BY_RARITY[r] or Config.MODEL_BY_RARITY[1], r, c, false, true)
	local tutorialFor = if opts then opts.tutorialFor else nil
	if tutorialFor then
		local laje = DataService.lajeOf(tutorialFor)
		k.tutorialFor = tutorialFor
		k.points = if opts and opts.points ~= nil then opts.points else Config.WILD_POINTS[r]
		k.laje = math.max(1, laje)
		k.faixa = 1
		k.wildPhase = "Tutorial"
		local angle = MapGen.lajeAngle(k.laje or 1)
		k.pos = ringPos(Config.MAP_RADIUS, Config.LAJE_FLOOR_Y + Config.FAIXA_HEIGHT_ABOVE_LAJE[1], angle)
	else
		local faixa = if rng:NextInteger(0, 1) == 0 then 3 else 4
		local h = Config.RING[faixa].h
		local phi = rng:NextNumber(0, 2 * math.pi)
		k.faixa = faixa
		k.theta = phi
		k.wildPhase = "Enter"
		k.pos = ringPos(Config.MAP_RADIUS, h, phi)
		k.wildTarget = ringPos(Config.WILD_RING_R, h, phi)
		if opts and opts.points ~= nil then
			k.points = opts.points
		end
	end
	syncConf(k)
	return k
end

-- Pipa caindo de RAIN_FROM_Y em RAIN_FALL_TIME até landPos (Chuva de Pipas). Sem dono (nil/0) ela some
-- se ninguém pegar em GROUND_TIME; com dono vai à árvore como uma pipa cortada.
function KiteService.drop(model: string, rarity: number, color: number, landPos: Vector3, ownerId: number?): KiteState
	local owner = ownerId or 0
	local ownerPl = if owner ~= 0 then Players:GetPlayerByUserId(owner) else nil
	local k = newState(owner, if ownerPl then ownerPl.DisplayName else "", model, rarity, color, false, false)
	k.status = STATUS_FALLING
	k.pos = Vector3.new(landPos.X, Config.RAIN_FROM_Y, landPos.Z)
	k.landPos = landPos
	k.statusUntil = now() + Config.RAIN_FALL_TIME
	k.rain = owner == 0
	syncConf(k)
	return k
end

-- Produto "Resgatar da Árvore": devolve ao varal a própria pipa presa na árvore.
function KiteService.rescueFromTree(p: Player): boolean
	if not dataOf(p) then
		return false
	end
	for _, k in kites do
		if k.status == STATUS_TREE and k.owner == p.UserId then
			DataService.addKite(p, k.model, k.rarity, k.color, k.golden)
			destroyKite(k)
			return true
		end
	end
	return false
end

-- +1 ou -1 (atributo WindSign de workspace.World).
function KiteService.setWind(sign: number): ()
	windSign = if sign < 0 then -1 else 1
	world():SetAttribute("WindSign", windSign)
end

-- Rajada / Rajada no Servidor: intervalo, máximo no ar e tabela de raridade até untilTime.
function KiteService.setWildBoost(intervalMin: number, intervalMax: number, maxInAir: number, weights: { number }, untilTime: number): ()
	wildBoost = { intervalMin = intervalMin, intervalMax = intervalMax, maxInAir = maxInAir, weights = weights, untilTime = untilTime }
	nextWildAt = math.min(nextWildAt, now() + rng:NextNumber(intervalMin, intervalMax))
end

-- Jogadores com a pipa no Céu Aberto (faixa 4) agora.
function KiteService.playersAtFaixa4(): { Player }
	local list = {}
	for p, k in flying do
		if k.faixa == 4 and (k.status == STATUS_FLYING or k.status == STATUS_DUELING) then
			table.insert(list, p)
		end
	end
	return list
end

-- Vento Dourado: golden = true permanente (×GOLDEN_MULT) + Toast("Dourada") para todos.
function KiteService.makeGolden(p: Player, kiteId: number): ()
	local data = dataOf(p)
	local kd = DataService.findKite(p, kiteId)
	if not data or not kd or kd.golden then
		return
	end
	kd.golden = true
	DataService.pushState(p, { Kites = data.Kites })
	local k = flying[p]
	if k and k.profileId == kiteId then
		k.golden = true
		syncConf(k)
	end
	updateVaral(p, data)
	toast(nil, "Dourada", { name = p.DisplayName, kite = kd.model })
end

-- (winner, loser, wild): wild = o duelo envolveu uma selvagem. ShopService usa para "Corte 3 selvagens".
function KiteService.onDuelEnd(cb: DuelEndCallback): ()
	table.insert(duelEndCallbacks, cb)
end

-- (p, k) a cada pega no campinho/árvore. ShopService usa para "Pegue 1 pipa".
function KiteService.onCatch(cb: CatchCallback): ()
	table.insert(catchCallbacks, cb)
end

return KiteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Leaderboard — ranking semanal (GDD §5.5).

	- Dono de profile.Data.Weekly: addWeekly(p, stat, n) soma em Weekly.Vento / Weekly.CortesPvP e zera o
	  bloco quando a semana (weekIndex: segunda 00:00 UTC) muda. DataService (todo Vento creditado) e
	  KiteService (CortesPvP) chamam via DataService.hooks.addWeekly — ninguém requer este módulo.
	- OrderedDataStores "Rei_{semana}" (Vento) e "Tesoura_{semana}" (CortesPvP): a cada LEADERBOARD_PERIOD s,
	  SetAsync por jogador só se o valor mudou (inteiros, pcall) e GetSortedAsync(false, LEADERBOARD_TOP)
	  com cache → SurfaceGui do Poste (Part com a tag Poste). O MapGen cria o SurfaceGui "Ranking" com as
	  colunas "Rei" e "Tesoura" (TextLabel); se faltar, uma placa simples é criada aqui.
	- Top RABIOLA_TOP da semana anterior (Rei_{semana-1}), lido 1× por TOP3_CACHE_SECONDS → atributo
	  RabiolaRank 1..3 do Player (0 para os demais; o DataService inicializa 0 no load).
	Studio sem acesso à API: toda chamada está em pcall; avisa uma vez e segue (a placa fica vazia).
	Requer: Config, DataService (nada mais).
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local DataService = require(script.Parent.DataService)

export type WeeklyStat = "Vento" | "CortesPvP"
type ProfileData = Config.ProfileData
type Weekly = { Week: number, Vento: number, CortesPvP: number }
type Entry = { userId: number, value: number }

local STATS: { WeeklyStat } = { "Vento", "CortesPvP" }
local STORE_PREFIX: { [string]: string } = { Vento = "Rei_", CortesPvP = "Tesoura_" }
local LABEL_NAME: { [string]: string } = { Vento = "Rei", CortesPvP = "Tesoura" }
local EMPTY_TEXT = "—"
-- Placa de reserva (só se o MapGen não criou as colunas): mesma geometria da placa do MapGen.
local FALLBACK = { x = { Vento = 0.02, CortesPvP = 0.51 } :: { [string]: number }, y = 0.32, w = 0.47, h = 0.66 }

local Leaderboard = {}

-- Semana desde segunda 00:00 UTC: (os.time() - WEEK_EPOCH_OFFSET) // WEEK_SECONDS.
function Leaderboard.weekIndex(): number
	return (os.time() - Config.WEEK_EPOCH_OFFSET) // Config.WEEK_SECONDS
end

local boards: { [string]: { Entry } } = { Vento = {}, CortesPvP = {} }
local lastWritten: { [Player]: { [string]: number } } = {} -- week + último valor enviado por stat
local nameCache: { [number]: string } = {}
local top: { number } = {} -- userIds do top da semana anterior
local topWeek = -1
local topAt = 0 -- os.clock() da última leitura do top
local apiDown = false

-- Ajudantes --------------------------------------------------------------------------------------

local function dataOf(p: Player): ProfileData?
	local profile = DataService.get(p)
	return if profile then profile.Data else nil
end

-- Avisa uma vez quando o DataStore falha (Studio sem API, throttling) e de novo só depois de recuperar.
local function reportError(err: any)
	if not apiDown then
		apiDown = true
		warn(`[Leaderboard] DataStore indisponível (seguindo sem ranking): {err}`)
	end
end

local function reportOk()
	if apiDown then
		apiDown = false
		print("[Leaderboard] DataStore voltou")
	end
end

local function storeFor(stat: WeeklyStat, week: number): OrderedDataStore
	return DataStoreService:GetOrderedDataStore(`{STORE_PREFIX[stat]}{week}`)
end

local function weeklyGet(w: Weekly, stat: WeeklyStat): number
	return if stat == "Vento" then w.Vento else w.CortesPvP
end

-- Zera Weekly quando a semana mudou. Retorna true se zerou.
local function ensureWeek(w: Weekly): boolean
	local week = Leaderboard.weekIndex()
	if w.Week == week then
		return false
	end
	w.Week = week
	w.Vento = 0
	w.CortesPvP = 0
	return true
end

-- DataStore (tudo em pcall) ------------------------------------------------------------------------

local function writeScore(stat: WeeklyStat, week: number, userId: number, value: number): boolean
	local ok, err = pcall(function(): string?
		storeFor(stat, week):SetAsync(tostring(userId), value)
		return nil
	end)
	if ok then
		reportOk()
	else
		reportError(err)
	end
	return ok
end

-- Top `n` de uma loja (decrescente); nil se o DataStore falhou.
local function readTop(stat: WeeklyStat, week: number, n: number): { Entry }?
	local ok, result = pcall(function(): { Entry }
		local page = storeFor(stat, week):GetSortedAsync(false, n):GetCurrentPage()
		local list: { Entry } = {}
		for _, item in page do
			table.insert(list, { userId = tonumber(item.key) or 0, value = tonumber(item.value) or 0 })
		end
		return list
	end)
	if ok then
		reportOk()
		return result
	end
	reportError(result)
	return nil
end

-- Placa do Poste --------------------------------------------------------------------------------------

-- Nome exibido de um userId (presente → DisplayName; senão GetNameFromUserIdAsync com cache).
local function nameOf(userId: number): string
	local present = Players:GetPlayerByUserId(userId)
	if present then
		return present.DisplayName
	end
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok then
		nameCache[userId] = name
		return name
	end
	return tostring(userId)
end

-- 12400 → "12,4K"; 1200000 → "1,2M"; 340 → "340".
local function fmt(n: number): string
	local text: string
	if n >= 1e6 then
		text = string.format("%.1fM", n / 1e6)
	elseif n >= 1e3 then
		text = string.format("%.1fK", n / 1e3)
	else
		return tostring(math.floor(n))
	end
	return (string.gsub(text, "%.", ","))
end

-- SurfaceGui do Poste (o do MapGen, ou uma placa simples na face -Z do próprio poste).
local function posteGui(): SurfaceGui?
	for _, inst in CollectionService:GetTagged("Poste") do
		local gui = inst:FindFirstChildWhichIsA("SurfaceGui")
		if gui then
			return gui
		end
		if inst:IsA("BasePart") then
			local created = Instance.new("SurfaceGui")
			created.Name = "Ranking"
			created.Face = Enum.NormalId.Front
			created.LightInfluence = 0
			created.Parent = inst
			return created
		end
	end
	return nil
end

-- Coluna "Rei" / "Tesoura" da placa (criada se o MapGen não a fez).
local function columnLabel(gui: SurfaceGui, stat: WeeklyStat): TextLabel
	local name = LABEL_NAME[stat]
	local found = gui:FindFirstChild(name)
	if found and found:IsA("TextLabel") then
		return found
	end
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(FALLBACK.x[stat], FALLBACK.y)
	label.Size = UDim2.fromScale(FALLBACK.w, FALLBACK.h)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Text = EMPTY_TEXT
	label.Parent = gui
	return label
end

-- Escreve as duas colunas ("1. Nome — 12,4K" por linha). Pode yield (nomes de quem não está no servidor).
local function render()
	local gui = posteGui()
	if not gui then
		return
	end
	for _, stat: WeeklyStat in STATS do
		local lines = {}
		for i, e in boards[stat] do
			table.insert(lines, `{i}. {nameOf(e.userId)} — {fmt(e.value)}`)
		end
		columnLabel(gui, stat).Text = if #lines > 0 then table.concat(lines, "\n") else EMPTY_TEXT
	end
end

-- Rabiola (top da semana anterior) --------------------------------------------------------------------

local function applyRank(p: Player, ids: { number })
	local rank = table.find(ids, p.UserId) or 0
	if p:GetAttribute("RabiolaRank") ~= rank then
		p:SetAttribute("RabiolaRank", rank)
	end
end

-- userIds do top RABIOLA_TOP da semana anterior (Rei_{semana-1}); lido 1× por TOP3_CACHE_SECONDS. Pode yield.
function Leaderboard.previousTop3(): { number }
	local week = Leaderboard.weekIndex()
	if topWeek == week and os.clock() - topAt < Config.TOP3_CACHE_SECONDS then
		return top
	end
	local list = readTop("Vento", week - 1, Config.RABIOLA_TOP)
	if list then
		top = {}
		for _, e in list do
			table.insert(top, e.userId)
		end
	elseif topWeek ~= week then
		top = {} -- semana nova e leitura falhou: o top antigo não vale mais
	end
	topWeek = week
	topAt = os.clock()
	return top
end

-- Ciclo de LEADERBOARD_PERIOD ------------------------------------------------------------------------------

-- Últimos valores enviados por p nesta semana (novo bloco quando a semana muda).
local function lastFor(p: Player, week: number): { [string]: number }
	local last = lastWritten[p]
	if last and last.week == week then
		return last
	end
	local fresh: { [string]: number } = { week = week }
	lastWritten[p] = fresh
	return fresh
end

-- Envia ao OrderedDataStore os valores que mudaram desde o último envio (inteiros > 0).
local function pushScores()
	local week = Leaderboard.weekIndex()
	for _, p in Players:GetPlayers() do
		local data = dataOf(p)
		if not data then
			continue
		end
		ensureWeek(data.Weekly)
		local last = lastFor(p, week)
		for _, stat: WeeklyStat in STATS do
			local value = math.floor(weeklyGet(data.Weekly, stat))
			if value > 0 and value ~= last[stat] and writeScore(stat, week, p.UserId, value) then
				last[stat] = value
			end
		end
	end
end

local function refreshBoards()
	local week = Leaderboard.weekIndex()
	for _, stat: WeeklyStat in STATS do
		local list = readTop(stat, week, Config.LEADERBOARD_TOP)
		if list then
			boards[stat] = list
		end
	end
	render()
end

local function cycle()
	pushScores()
	refreshBoards()
	local ids = Leaderboard.previousTop3()
	for _, p in Players:GetPlayers() do
		applyRank(p, ids)
	end
end

local function loop()
	while true do
		local ok, err = pcall(function(): string?
			cycle()
			return nil
		end)
		if not ok then
			warn(`[Leaderboard] ciclo falhou: {err}`)
		end
		task.wait(Config.LEADERBOARD_PERIOD)
	end
end

-- API pública -------------------------------------------------------------------------------------------------

-- Soma n em Weekly[stat] (zera Weekly se a semana mudou).
function Leaderboard.addWeekly(p: Player, stat: WeeklyStat, n: number): ()
	local data = dataOf(p)
	if not data or n ~= n or n <= 0 then
		return
	end
	ensureWeek(data.Weekly)
	if stat == "Vento" then
		data.Weekly.Vento += n
	else
		data.Weekly.CortesPvP += n
	end
end

local function onLoaded(p: Player, data: ProfileData)
	ensureWeek(data.Weekly)
	applyRank(p, Leaderboard.previousTop3())
end

function Leaderboard.start(): ()
	DataService.hooks.addWeekly = Leaderboard.addWeekly
	DataService.onLoaded(onLoaded)
	Players.PlayerRemoving:Connect(function(p: Player)
		lastWritten[p] = nil
	end)
	task.spawn(loop)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">MapGen</string>
          <string name="Source"><![CDATA[--!strict
--[[
	MapGen — gera o "Morro do Vento" (GDD §4) inteiro no início do servidor, só com Terrain e Parts
	(nenhum asset externo). Determinístico: Random.new(Config.SEED) → todo servidor tem o mesmo mapa.

	O que constrói (tudo Anchored, agrupado em workspace/Map):
	- Terreno: disco verde r 200, degrau 2 (y 12), centro escavado (y 0), rua de asfalto, água em volta.
	- Campinho (Part Ground + 5 linhas + círculo central + 2 traves), SpawnLocation, 4 rampas.
	- Bar do Vento (corpo, balcão com tag Bar + ProximityPrompt "Ver estoque", toldo, placa SurfaceGui).
	- Poste do Ranking (Part tag Poste + placa; SurfaceGui "Ranking" na face −Z, que o Leaderboard preenche).
	- Árvore do Campinho (tronco tag Tree, 3 copas, TrussPart para subir).
	- 12 lajes: Model "Laje_i" com tag Laje e Attributes Index / OwnerId (0 = livre) / Angle (rad) /
	  VaralCodes (escrito pelo KiteService). Dentro: casa pastel, piso "Floor", muretas (Neon para VIP),
	  caixa-d'água, carretel (tag Carretel, Attribute LajeIndex, ProximityPrompt "PEGAR VENTO"), varal, porta,
	  janelas Neon e TrussPart da rua até o piso.
	- 36 casas de enfeite + igrejinha no morro, 4 paredes invisíveis em r 210.
	- Luz (§4.4) e os contêineres de runtime: workspace/KiteStates (Folder) e workspace/World (Configuration).

	API: MapGen.start() (idempotente: destrói workspace.Map antes), lajeModel(i), lajeFloor(i),
	carretelPos(i), lajeAngle(i). Depende SÓ de Config — nunca de outro serviço.
	As medidas do §4 que não estão no bloco Config do §7.5 vivem na tabela GEO abaixo.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapGen = {}

-- Paleta (GDD §1) ------------------------------------------------------------------------------

local PAL = {
	Pipa = Color3.fromRGB(235, 60, 50),
	Sol = Color3.fromRGB(255, 205, 60),
	Morro = Color3.fromRGB(95, 185, 90),
	Terra = Color3.fromRGB(150, 105, 60),
	Asfalto = Color3.fromRGB(60, 60, 65),
	Laje = Color3.fromRGB(255, 140, 60),
	Lilas = Color3.fromRGB(170, 130, 230),
	Branco = Color3.fromRGB(245, 245, 245),
	UIFundo = Color3.fromRGB(30, 30, 45),
	UITexto = Color3.fromRGB(255, 255, 255),
	Contorno = Color3.fromRGB(20, 20, 30),
	Cinza = Color3.fromRGB(120, 120, 130),
	Agua = Color3.fromRGB(60, 140, 255),
	Madeira = Color3.fromRGB(120, 80, 45),
	Porta = Color3.fromRGB(70, 45, 35),
	Janela = Color3.fromRGB(255, 245, 180), -- Neon: luz acesa
	Folha = Color3.fromRGB(70, 160, 75),
}

-- 12 cores pastel (uma por laje; as casas de enfeite sorteiam entre elas).
local PASTEL: { Color3 } = {}
for i = 1, 12 do
	PASTEL[i] = Color3.fromHSV((i - 1) / 12, 0.38, 1)
end

-- Geometria do mapa (GDD §4, em studs). Só o que o bloco Config (§7.5) não cobre. --------------------

local GEO = {
	-- §4.1 terreno
	BASE_TOP = 24, -- disco verde: topo em y 24
	BASE_BOTTOM = -12, -- (impl.) o disco desce até o fundo da água para o centro escavado ficar em grama
	STEP2_Y = 12, -- degrau 2 (r 90–150)
	STEP2_R = 150,
	CENTER_R = 90, -- centro escavado até y 0
	ROAD_R_OUT = 105,
	ROAD_R_IN = 95,
	ROAD_THICK = 4, -- (impl.) 1 voxel de terreno (y 8–12), alinhado ao grid: sem lascas de meio-voxel
	WATER_SIZE = 1200,
	WATER_DEPTH = 12,
	WALL_R = 210,
	WALL_LEN = 420,
	WALL_H = 60,
	WALL_T = 1,
	RAMP_SIZE = Vector3.new(16, 12, 24),
	RAMP_R = 78,
	RAMP_ANGLES = { 45, 135, 225, 315 },
	-- §4.2 campinho / spawn
	FIELD_Y = 0.5,
	LINE_W = 0.3, -- espessura das linhas brancas
	LINE_H = 0.2,
	CIRCLE_R = 8,
	CIRCLE_SEGMENTS = 8,
	GOAL_POST = Vector3.new(0.6, 8, 0.6),
	GOAL_HALF_Z = 6,
	GOAL_BAR = Vector3.new(0.6, 0.6, 12.6),
	GOAL_BAR_Y = 8.2,
	SPAWN_SIZE = Vector3.new(8, 1, 8),
	-- §4.2 Bar do Vento
	BAR_BODY = Vector3.new(16, 10, 12),
	BAR_BODY_POS = Vector3.new(0, 5, -46),
	BAR_COUNTER = Vector3.new(16, 3, 2),
	BAR_AWNING = Vector3.new(2, 0.4, 6),
	BAR_AWNING_Y = 10.5,
	BAR_AWNING_Z = -39,
	BAR_AWNING_N = 8,
	BAR_SIGN = Vector3.new(14, 3, 0.5),
	BAR_SIGN_POS = Vector3.new(0, 8, -39.7),
	-- §4.2 Poste do Ranking (o poste do GDD tem 2 studs de largura: a placa dá área legível ao SurfaceGui)
	POSTE_SIZE = Vector3.new(2, 24, 2),
	POSTE_BOARD = Vector3.new(12, 8, 0.5),
	POSTE_BOARD_OFFSET = Vector3.new(0, 7, 1.3), -- relativo a POSTE_POS, na frente (lado do campinho)
	-- §4.2 Árvore do Campinho
	TREE_TRUNK = Vector3.new(18, 4, 4),
	TREE_TRUNK_POS = Vector3.new(46, 9, 30),
	TREE_BALL = Vector3.new(12, 12, 12),
	TREE_BALLS = { Vector3.new(46, 18, 30), Vector3.new(42, 21, 33), Vector3.new(50, 21, 27) },
	TREE_TRUSS = Vector3.new(2, 18, 2),
	TREE_TRUSS_POS = Vector3.new(43, 9, 30),
	-- §4.2 laje (coordenadas locais: −Z = frente, virada para o centro; X = direita; y = mundial)
	HOUSE = Vector3.new(22, 14, 22),
	HOUSE_Y = 19,
	FLOOR = Vector3.new(24, 1, 24),
	MURETA_H = 2,
	MURETA_T = 1,
	MURETA_Y = 28,
	MURETA_HALF = 11.5,
	GATE_W = 4, -- (impl.) vão na mureta da frente, onde a escada chega
	TANK = Vector3.new(5, 5, 5),
	TANK_LOCAL = Vector3.new(-8, 29.5, 8), -- canto traseiro-esquerdo
	CARRETEL = Vector3.new(2, 3, 3),
	CARRETEL_LOCAL = Vector3.new(-6, 28.5, -9.5), -- borda frontal, ao lado do vão
	CARRETEL_PROMPT_DIST = 10, -- ≤ Config.COLLECT_DIST (o servidor revalida a distância)
	VARAL_POST = Vector3.new(0.4, 4, 0.4),
	VARAL_LINE = Vector3.new(16, 0.2, 0.2), -- 16 studs ao longo do X local: 8 vagas a cada 2 studs
	VARAL_Y = 30,
	VARAL_Z = 3,
	VARAL_HALF = 8,
	DOOR = Vector3.new(4, 7, 0.3),
	DOOR_Y = 15.5,
	WINDOW = Vector3.new(3, 3, 0.3),
	WINDOW_X = 6,
	WINDOW_Y = 20,
	FACADE_Z = -11.15, -- porta/janelas encostadas na frente da casa
	TRUSS = Vector3.new(2, 15, 2), -- da rua (y 12) ao topo do piso (y 27)
	TRUSS_LOCAL = Vector3.new(0, 19.5, -13),
	-- §4.2 casas de enfeite e igrejinha
	HILL_Y = 24,
	DECO_COUNT = 36,
	DECO_R = { 160, 190 },
	DECO_SX = { 8, 16 },
	DECO_SY = { 8, 14 },
	DECO_SZ = { 8, 16 },
	DECO_ARC_START = 30, -- os 36 enfeites ocupam 30°..360°; 0°..30° fica para a igrejinha
	DECO_JITTER = 1.5, -- ± graus
	DECO_WINDOW = Vector3.new(2, 2, 0.3),
	CHURCH_ANGLE = 15,
	CHURCH_R = 175,
	CHURCH = Vector3.new(14, 18, 14),
	TOWER = Vector3.new(6, 26, 6),
	TOWER_X = 10, -- ao lado direito do corpo
	CROSS_V = Vector3.new(0.6, 4, 0.6),
	CROSS_H = Vector3.new(2.4, 0.6, 0.6),
	-- placas
	SIGN_PPS = 40, -- PixelsPerStud dos SurfaceGui
}

-- Luz (GDD §4.4)
local LIGHT = {
	ClockTime = 16.5,
	Brightness = 2,
	OutdoorAmbient = Color3.fromRGB(140, 160, 190),
	Density = 0.25,
	Haze = 1.0,
	Glare = 0.1,
}

-- Atributos iniciais de workspace/World (GDD §7.4)
local WORLD_DEFAULTS: { [string]: any } = {
	WindSign = 1,
	EventName = "",
	EventPhase = "",
	EventEndsAt = 0,
	Festival = false,
	RestockAt = 0,
	BoostRajadaUntil = 0,
	BoostVentoUntil = 0,
	BoostBy = "",
}

-- Estado interno ---------------------------------------------------------------------------------

local built = false
local partCount = 0
local lajes: { [number]: Model } = {}
local carretels: { [number]: Vector3 } = {}
local muretasOf: { [number]: { Part } } = {}
local connections: { RBXScriptConnection } = {}
local vipConnections: { [Player]: RBXScriptConnection } = {}

-- Ajudantes de construção ------------------------------------------------------------------------

type PartOpts = { shape: Enum.PartType?, material: Enum.Material?, collide: boolean?, transparency: number? }

-- Part Anchored, SmoothPlastic por padrão. O Parent é um Model/Folder ainda fora do workspace:
-- o mapa inteiro replica de uma vez quando workspace/Map é parentado no fim de start().
local function newPart(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance, opts: PartOpts?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = if opts and opts.material then opts.material else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if opts then
		if opts.shape then
			p.Shape = opts.shape
		end
		if opts.collide ~= nil then
			p.CanCollide = opts.collide
		end
		if opts.transparency then
			p.Transparency = opts.transparency
		end
	end
	partCount += 1
	p.Parent = parent
	return p
end

local function newWedge(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, parent: Instance): WedgePart
	local w = Instance.new("WedgePart")
	w.Name = name
	w.Anchored = true
	w.Size = size
	w.CFrame = cf
	w.Color = color
	w.Material = material
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	partCount += 1
	w.Parent = parent
	return w
end

local function newTruss(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance): TrussPart
	local t = Instance.new("TrussPart")
	t.Name = name
	t.Anchored = true
	t.Size = size
	t.CFrame = cf
	t.Color = color
	t.Material = Enum.Material.SmoothPlastic
	partCount += 1
	t.Parent = parent
	return t
end

local function newModel(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	return m
end

-- SurfaceGui de texto (sem imagens). face Front = −Z do adornee.
local function newSign(parent: BasePart, adornee: BasePart?, name: string): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = GEO.SIGN_PPS
	gui.LightInfluence = 0
	if adornee then
		gui.Adornee = adornee
	end
	gui.Parent = parent
	return gui
end

local function newLabel(parent: Instance, name: string, text: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Position = pos
	label.Size = size
	label.Font = font
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = PAL.Contorno
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- Cilindro em pé: o eixo de um Cylinder é o X local; girar 90° em Z põe o eixo na vertical.
local function upright(cf: CFrame): CFrame
	return cf * CFrame.Angles(0, 0, math.pi / 2)
end

-- Referencial virado para o centro do mapa (−Z aponta para (0, y, 0)); sem inclinação.
local function facingCenter(pos: Vector3): CFrame
	return CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
end

-- Part girada 180° em Y: a face Front (−Z) passa a olhar para +Z (lado do campinho, para quem está ao sul).
local function facingNorth(pos: Vector3): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, math.pi, 0)
end

local function ptBR(key: string): string
	return Config.str(key, "pt-BR")
end

-- Geometria das lajes ----------------------------------------------------------------------------

-- Ângulo (rad) da laje i: (i-1) × 360°/LAJE_COUNT.
function MapGen.lajeAngle(i: number): number
	return (i - 1) * (2 * math.pi / Config.LAJE_COUNT)
end

-- Referencial da laje i: origem em (R·cos, 0, R·sin), −Z para o centro, y mundial.
local function lajeFrame(i: number): CFrame
	local a = MapGen.lajeAngle(i)
	return facingCenter(Vector3.new(Config.LAJE_RADIUS * math.cos(a), 0, Config.LAJE_RADIUS * math.sin(a)))
end

-- Centro do piso da laje i (y = LAJE_FLOOR_Y).
function MapGen.lajeFloor(i: number): Vector3
	local a = MapGen.lajeAngle(i)
	return Vector3.new(Config.LAJE_RADIUS * math.cos(a), Config.LAJE_FLOOR_Y, Config.LAJE_RADIUS * math.sin(a))
end

-- Terreno (§4.1) ---------------------------------------------------------------------------------

local function buildTerrain()
	local terrain = Workspace.Terrain
	terrain:Clear()
	-- água em volta do mundo (y −12 → 0)
	terrain:FillBlock(CFrame.new(0, -GEO.WATER_DEPTH / 2, 0), Vector3.new(GEO.WATER_SIZE, GEO.WATER_DEPTH, GEO.WATER_SIZE), Enum.Material.Water)
	-- disco verde r 200: do fundo da água até y 24 (assim o centro escavado fica em grama, não em água)
	local baseH = GEO.BASE_TOP - GEO.BASE_BOTTOM
	terrain:FillCylinder(CFrame.new(0, GEO.BASE_BOTTOM + baseH / 2, 0), baseH, Config.MAP_RADIUS, Enum.Material.Grass)
	-- rua de asfalto: anel r 95–105 cujo topo é a superfície do degrau 2 (y 12). Pintada ANTES das
	-- escavações: assim o que cai dentro do centro (r < 90) é removido junto, sem sobrar lasca de voxel.
	local roadY = GEO.STEP2_Y - GEO.ROAD_THICK / 2
	terrain:FillCylinder(CFrame.new(0, roadY, 0), GEO.ROAD_THICK, GEO.ROAD_R_OUT, Enum.Material.Asphalt)
	terrain:FillCylinder(CFrame.new(0, roadY, 0), GEO.ROAD_THICK, GEO.ROAD_R_IN, Enum.Material.Grass)
	-- degrau 2 (r < 150 desce para y 12) e centro (r < 90 desce para y 0)
	local step2H = GEO.BASE_TOP - GEO.STEP2_Y
	terrain:FillCylinder(CFrame.new(0, GEO.STEP2_Y + step2H / 2, 0), step2H, GEO.STEP2_R, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(0, GEO.STEP2_Y / 2, 0), GEO.STEP2_Y, GEO.CENTER_R, Enum.Material.Air)
end

-- Campinho, spawn, rampas e paredes (§4.1/§4.2) --------------------------------------------------

local function buildCampinho(folder: Folder)
	local m = newModel("Campinho")
	local sx, sz = Config.CAMPINHO.sizeX, Config.CAMPINHO.sizeZ
	local field = newPart("Campo", Vector3.new(sx, 1, sz), CFrame.new(0, GEO.FIELD_Y, 0), PAL.Terra, m, { material = Enum.Material.Ground })
	m.PrimaryPart = field
	local lineY = GEO.FIELD_Y + 0.5 + GEO.LINE_H / 2
	local lineOpts: PartOpts = { collide = false }
	-- 2 laterais (ao longo de X), 2 fundos (ao longo de Z) e a linha do meio
	for _, s in { -1, 1 } do
		newPart("Lateral", Vector3.new(sx, GEO.LINE_H, GEO.LINE_W), CFrame.new(0, lineY, s * (sz / 2 - GEO.LINE_W / 2)), PAL.Branco, m, lineOpts)
		newPart("Fundo", Vector3.new(GEO.LINE_W, GEO.LINE_H, sz), CFrame.new(s * (sx / 2 - GEO.LINE_W / 2), lineY, 0), PAL.Branco, m, lineOpts)
	end
	newPart("Meio", Vector3.new(GEO.LINE_W, GEO.LINE_H, sz), CFrame.new(0, lineY, 0), PAL.Branco, m, lineOpts)
	-- círculo central: polígono de CIRCLE_SEGMENTS segmentos
	local segLen = 2 * GEO.CIRCLE_R * math.sin(math.pi / GEO.CIRCLE_SEGMENTS)
	for k = 0, GEO.CIRCLE_SEGMENTS - 1 do
		local a = (k + 0.5) * (2 * math.pi / GEO.CIRCLE_SEGMENTS)
		local center = Vector3.new(GEO.CIRCLE_R * math.cos(a), lineY, GEO.CIRCLE_R * math.sin(a))
		newPart("Circulo", Vector3.new(segLen, GEO.LINE_H, GEO.LINE_W), facingCenter(center), PAL.Branco, m, lineOpts)
	end
	-- 2 traves: postes em x = ±sx/2, z = ±GOAL_HALF_Z + travessão
	local postY = GEO.FIELD_Y + GEO.GOAL_POST.Y / 2
	for _, s in { -1, 1 } do
		local x = s * sx / 2
		for _, zs in { -1, 1 } do
			newPart("Trave", GEO.GOAL_POST, CFrame.new(x, postY, zs * GEO.GOAL_HALF_Z), PAL.Branco, m)
		end
		newPart("Travessao", GEO.GOAL_BAR, CFrame.new(x, GEO.GOAL_BAR_Y, 0), PAL.Branco, m)
	end
	m.Parent = folder
end

local function buildSpawn(folder: Folder)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = GEO.SPAWN_SIZE
	spawn.CFrame = CFrame.new(Config.SPAWN_POS)
	spawn.Color = PAL.Laje
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.AllowTeamChangeOnTouch = false
	partCount += 1
	spawn.Parent = folder
end

-- 4 rampas campinho ↔ degrau 2: a borda fina do WedgePart (face Front) olha para o centro.
local function buildRampas(folder: Folder)
	local m = newModel("Rampas")
	for _, deg in GEO.RAMP_ANGLES do
		local a = math.rad(deg)
		local pos = Vector3.new(GEO.RAMP_R * math.cos(a), GEO.RAMP_SIZE.Y / 2, GEO.RAMP_R * math.sin(a))
		newWedge(`Rampa_{deg}`, GEO.RAMP_SIZE, facingCenter(pos), PAL.Morro, Enum.Material.Grass, m)
	end
	m.Parent = folder
end

-- 4 paredes invisíveis em r 210 (CanCollide; a água fica do lado de fora).
local function buildParedes(folder: Folder)
	local m = newModel("Paredes")
	local opts: PartOpts = { transparency = 1, collide = true }
	local y = GEO.WALL_H / 2
	local alongZ = Vector3.new(GEO.WALL_T, GEO.WALL_H, GEO.WALL_LEN) -- 1 × 60 × 420
	local alongX = Vector3.new(GEO.WALL_LEN, GEO.WALL_H, GEO.WALL_T)
	for _, s in { -1, 1 } do
		newPart("Parede", alongZ, CFrame.new(s * GEO.WALL_R, y, 0), PAL.Cinza, m, opts)
		newPart("Parede", alongX, CFrame.new(0, y, s * GEO.WALL_R), PAL.Cinza, m, opts)
	end
	m.Parent = folder
end

-- Bar do Vento, Poste e Árvore (§4.2) ------------------------------------------------------------

local function buildBar(folder: Folder)
	local m = newModel("Bar")
	newPart("Corpo", GEO.BAR_BODY, CFrame.new(GEO.BAR_BODY_POS), PAL.Sol, m)
	-- balcão: tag Bar + prompt "Ver estoque" (ShopService valida a distância SHOP_DIST no servidor)
	local counter = newPart("Balcao", GEO.BAR_COUNTER, CFrame.new(Config.BAR_POS), PAL.Madeira, m)
	counter:AddTag("Bar")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "VerEstoque"
	prompt.ActionText = ptBR("promptStock")
	prompt.ObjectText = ptBR("bar")
	prompt.MaxActivationDistance = Config.SHOP_OPEN_DIST
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter
	-- toldo: faixas alternando vermelho/branco
	local x0 = -(GEO.BAR_AWNING_N - 1) * GEO.BAR_AWNING.X / 2
	for k = 0, GEO.BAR_AWNING_N - 1 do
		local color = if k % 2 == 0 then PAL.Pipa else PAL.Branco
		newPart("Toldo", GEO.BAR_AWNING, CFrame.new(x0 + k * GEO.BAR_AWNING.X, GEO.BAR_AWNING_Y, GEO.BAR_AWNING_Z), color, m)
	end
	-- placa "BAR DO VENTO" virada para o campinho
	local sign = newPart("Placa", GEO.BAR_SIGN, facingNorth(GEO.BAR_SIGN_POS), PAL.UIFundo, m)
	local gui = newSign(sign, nil, "Texto")
	newLabel(gui, "Titulo", ptBR("bar"), UDim2.fromScale(0.03, 0.1), UDim2.fromScale(0.94, 0.8), PAL.UITexto, Enum.Font.GothamBlack)
	m.Parent = folder
end

-- Poste do Ranking: Part 2×24×2 (tag Poste) + placa na frente. O SurfaceGui "Ranking" fica como filho do
-- Part com a tag (Adornee = placa, face −Z): o Leaderboard preenche Rei.Text e Tesoura.Text.
local function buildPoste(folder: Folder)
	local m = newModel("Poste")
	local pole = newPart("Poste", GEO.POSTE_SIZE, facingNorth(Config.POSTE_POS), PAL.Cinza, m)
	pole:AddTag("Poste")
	local board = newPart("Placa", GEO.POSTE_BOARD, facingNorth(Config.POSTE_POS + GEO.POSTE_BOARD_OFFSET), PAL.UIFundo, m)
	local gui = newSign(pole, board, "Ranking")
	newLabel(gui, "Titulo", ptBR("rankingTitle"), UDim2.fromScale(0.02, 0.02), UDim2.fromScale(0.96, 0.16), PAL.Sol, Enum.Font.GothamBlack)
	newLabel(gui, "ReiTitulo", ptBR("rankingKing"), UDim2.fromScale(0.02, 0.2), UDim2.fromScale(0.47, 0.1), PAL.UITexto, Enum.Font.GothamBlack)
	newLabel(gui, "TesouraTitulo", ptBR("rankingScissors"), UDim2.fromScale(0.51, 0.2), UDim2.fromScale(0.47, 0.1), PAL.UITexto, Enum.Font.GothamBlack)
	local columns: { { name: string, x: number } } = { { name = "Rei", x = 0.02 }, { name = "Tesoura", x = 0.51 } }
	for _, col in columns do
		local list = newLabel(gui, col.name, "—", UDim2.fromScale(col.x, 0.32), UDim2.fromScale(0.47, 0.66), PAL.UITexto, Enum.Font.GothamBold)
		list.TextXAlignment = Enum.TextXAlignment.Left
		list.TextYAlignment = Enum.TextYAlignment.Top
	end
	m.Parent = folder
end

local function buildArvore(folder: Folder)
	local m = newModel("Arvore")
	local trunk = newPart("Tronco", GEO.TREE_TRUNK, upright(CFrame.new(GEO.TREE_TRUNK_POS)), PAL.Madeira, m, { shape = Enum.PartType.Cylinder, material = Enum.Material.Wood })
	trunk:AddTag("Tree")
	trunk:SetAttribute("Top", Config.TREE_TOP)
	m.PrimaryPart = trunk
	for k, pos in GEO.TREE_BALLS do
		newPart(`Copa_{k}`, GEO.TREE_BALL, CFrame.new(pos), PAL.Folha, m, { shape = Enum.PartType.Ball })
	end
	newTruss("Escada", GEO.TREE_TRUSS, CFrame.new(GEO.TREE_TRUSS_POS), PAL.Madeira, m)
	m.Parent = folder
end

-- Lajes (§4.2) -----------------------------------------------------------------------------------

local function buildLaje(i: number, folder: Folder)
	local frame = lajeFrame(i)
	local m = newModel(`Laje_{i}`)
	m:SetAttribute("Index", i)
	m:SetAttribute("OwnerId", 0)
	m:SetAttribute("Angle", MapGen.lajeAngle(i))
	m:SetAttribute("VaralCodes", "")
	m:AddTag("Laje")

	newPart("Casa", GEO.HOUSE, frame * CFrame.new(0, GEO.HOUSE_Y, 0), PASTEL[i], m)
	local floor = newPart("Floor", GEO.FLOOR, frame * CFrame.new(0, Config.LAJE_FLOOR_Y, 0), PAL.Laje, m)
	m.PrimaryPart = floor

	-- muretas: fundo, 2 laterais e a da frente em 2 pedaços (vão GATE_W onde a escada chega)
	local muretas: { Part } = {}
	local full = GEO.FLOOR.X
	local half = GEO.MURETA_HALF
	local segLen = (full - GEO.GATE_W) / 2
	local segX = GEO.GATE_W / 2 + segLen / 2
	local function mureta(name: string, size: Vector3, offset: Vector3)
		table.insert(muretas, newPart(name, size, frame * CFrame.new(offset), PAL.Laje, m))
	end
	mureta("MuretaFundo", Vector3.new(full, GEO.MURETA_H, GEO.MURETA_T), Vector3.new(0, GEO.MURETA_Y, half))
	mureta("MuretaEsq", Vector3.new(GEO.MURETA_T, GEO.MURETA_H, full), Vector3.new(-half, GEO.MURETA_Y, 0))
	mureta("MuretaDir", Vector3.new(GEO.MURETA_T, GEO.MURETA_H, full), Vector3.new(half, GEO.MURETA_Y, 0))
	mureta("MuretaFrenteEsq", Vector3.new(segLen, GEO.MURETA_H, GEO.MURETA_T), Vector3.new(-segX, GEO.MURETA_Y, -half))
	mureta("MuretaFrenteDir", Vector3.new(segLen, GEO.MURETA_H, GEO.MURETA_T), Vector3.new(segX, GEO.MURETA_Y, -half))
	muretasOf[i] = muretas

	newPart("CaixaDagua", GEO.TANK, upright(frame * CFrame.new(GEO.TANK_LOCAL)), PAL.Agua, m, { shape = Enum.PartType.Cylinder })

	-- carretel: tag Carretel + LajeIndex + prompt (parentado ANTES de o Part entrar no workspace)
	local carretelCF = frame * CFrame.new(GEO.CARRETEL_LOCAL)
	local carretel = newPart("Carretel", GEO.CARRETEL, carretelCF, PAL.Laje, m, { shape = Enum.PartType.Cylinder })
	carretel:AddTag("Carretel")
	carretel:SetAttribute("LajeIndex", i)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PegarVento"
	prompt.ActionText = ptBR("collect")
	prompt.ObjectText = ptBR("reel")
	prompt.MaxActivationDistance = GEO.CARRETEL_PROMPT_DIST
	prompt.HoldDuration = 0
	prompt.RequiresLineOfSight = false
	prompt.Parent = carretel
	carretels[i] = carretelCF.Position

	-- varal: 2 postes + linha de 16 studs ao longo do X local (o cliente pendura as miniaturas)
	local postY = Config.LAJE_FLOOR_Y + GEO.FLOOR.Y / 2 + GEO.VARAL_POST.Y / 2
	for _, s in { -1, 1 } do
		newPart("VaralPoste", GEO.VARAL_POST, frame * CFrame.new(s * GEO.VARAL_HALF, postY, GEO.VARAL_Z), PAL.Cinza, m)
	end
	newPart("Varal", GEO.VARAL_LINE, frame * CFrame.new(0, GEO.VARAL_Y, GEO.VARAL_Z), PAL.Branco, m, { collide = false })

	-- fachada: porta e 2 janelas Neon
	newPart("Porta", GEO.DOOR, frame * CFrame.new(0, GEO.DOOR_Y, GEO.FACADE_Z), PAL.Porta, m)
	for _, s in { -1, 1 } do
		newPart("Janela", GEO.WINDOW, frame * CFrame.new(s * GEO.WINDOW_X, GEO.WINDOW_Y, GEO.FACADE_Z), PAL.Janela, m, { material = Enum.Material.Neon })
	end

	-- escada da rua (y 12) ao piso (y 27), na frente, no vão da mureta
	newTruss("Escada", GEO.TRUSS, frame * CFrame.new(GEO.TRUSS_LOCAL), PAL.Cinza, m)

	lajes[i] = m
	m.Parent = folder
end

-- Casas de enfeite e igrejinha (§4.2) ------------------------------------------------------------

local function buildEnfeites(folder: Folder, rng: Random)
	local m = newModel("Enfeites")
	local step = (360 - GEO.DECO_ARC_START) / GEO.DECO_COUNT
	for k = 1, GEO.DECO_COUNT do
		local deg = GEO.DECO_ARC_START + (k - 0.5) * step + rng:NextNumber(-GEO.DECO_JITTER, GEO.DECO_JITTER)
		local r = rng:NextNumber(GEO.DECO_R[1], GEO.DECO_R[2])
		local size = Vector3.new(rng:NextInteger(GEO.DECO_SX[1], GEO.DECO_SX[2]), rng:NextInteger(GEO.DECO_SY[1], GEO.DECO_SY[2]), rng:NextInteger(GEO.DECO_SZ[1], GEO.DECO_SZ[2]))
		local color = PASTEL[rng:NextInteger(1, #PASTEL)]
		local a = math.rad(deg)
		local frame = facingCenter(Vector3.new(r * math.cos(a), GEO.HILL_Y + size.Y / 2, r * math.sin(a)))
		newPart(`Casa_{k}`, size, frame, color, m)
		for _, s in { -1, 1 } do
			local offset = Vector3.new(s * size.X / 4, size.Y / 6, -(size.Z / 2 + GEO.DECO_WINDOW.Z / 2))
			newPart("Janela", GEO.DECO_WINDOW, frame * CFrame.new(offset), PAL.Janela, m, { material = Enum.Material.Neon })
		end
	end
	-- igrejinha branca com torre e cruz
	local a = math.rad(GEO.CHURCH_ANGLE)
	local base = Vector3.new(GEO.CHURCH_R * math.cos(a), 0, GEO.CHURCH_R * math.sin(a))
	local frame = facingCenter(base)
	newPart("Igreja", GEO.CHURCH, frame * CFrame.new(0, GEO.HILL_Y + GEO.CHURCH.Y / 2, 0), PAL.Branco, m)
	newPart("Torre", GEO.TOWER, frame * CFrame.new(GEO.TOWER_X, GEO.HILL_Y + GEO.TOWER.Y / 2, 0), PAL.Branco, m)
	local towerTop = GEO.HILL_Y + GEO.TOWER.Y
	newPart("Cruz", GEO.CROSS_V, frame * CFrame.new(GEO.TOWER_X, towerTop + GEO.CROSS_V.Y / 2, 0), PAL.Sol, m)
	newPart("Cruz", GEO.CROSS_H, frame * CFrame.new(GEO.TOWER_X, towerTop + GEO.CROSS_V.Y * 0.7, 0), PAL.Sol, m)
	m.Parent = folder
end

-- Luz e contêineres de runtime -------------------------------------------------------------------

local function setupLighting()
	Lighting.ClockTime = LIGHT.ClockTime
	Lighting.Brightness = LIGHT.Brightness
	Lighting.GlobalShadows = false
	Lighting.OutdoorAmbient = LIGHT.OutdoorAmbient
	pcall(function() -- cartoon; o Rojo 7.4.4 não conhece a propriedade, por isso é aplicada aqui
		Lighting.LightingStyle = Enum.LightingStyle.Soft
	end)
	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = LIGHT.Density
	atmo.Haze = LIGHT.Haze
	atmo.Glare = LIGHT.Glare
	atmo.Parent = Lighting
end

local function ensureFolder(name: string): Folder
	local existing = Workspace:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = Workspace
	return folder
end

-- workspace/World: cria se não existe; garante cada atributo sem apagar valores já escritos pelos serviços.
local function ensureWorld(): Configuration
	local existing = Workspace:FindFirstChild("World")
	local world: Configuration
	if existing and existing:IsA("Configuration") then
		world = existing
	else
		world = Instance.new("Configuration")
		world.Name = "World"
	end
	for key, value in WORLD_DEFAULTS do
		if world:GetAttribute(key) == nil then
			world:SetAttribute(key, value)
		end
	end
	world.Parent = Workspace
	return world
end

-- Muretas Neon do VIP (lê o atributo VIP do Player; nunca requer MonetizationService) --------------

local function refreshMuretas(i: number)
	local model = lajes[i]
	local parts = muretasOf[i]
	if not model or not parts then
		return
	end
	local raw = model:GetAttribute("OwnerId")
	local ownerId: number = if typeof(raw) == "number" then raw else 0
	local owner = if ownerId > 0 then Players:GetPlayerByUserId(ownerId) else nil
	local vip = owner ~= nil and owner:GetAttribute("VIP") == true
	for _, part in parts do
		part.Material = if vip then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.Color = if vip then PAL.Sol else PAL.Laje
	end
end

local function refreshMuretasOf(p: Player)
	for i, model in lajes do
		if model:GetAttribute("OwnerId") == p.UserId then
			refreshMuretas(i)
		end
	end
end

local function watchPlayer(p: Player)
	vipConnections[p] = p:GetAttributeChangedSignal("VIP"):Connect(function()
		refreshMuretasOf(p)
	end)
end

local function forgetPlayer(p: Player)
	local conn = vipConnections[p]
	if conn then
		conn:Disconnect()
		vipConnections[p] = nil
	end
end

local function watchVip()
	for i, model in lajes do
		table.insert(connections, model:GetAttributeChangedSignal("OwnerId"):Connect(function()
			refreshMuretas(i)
		end))
	end
	table.insert(connections, Players.PlayerAdded:Connect(watchPlayer))
	table.insert(connections, Players.PlayerRemoving:Connect(forgetPlayer))
	for _, p in Players:GetPlayers() do
		watchPlayer(p)
	end
end

local function disconnectAll()
	for _, conn in connections do
		conn:Disconnect()
	end
	table.clear(connections)
	for p in vipConnections do
		forgetPlayer(p)
	end
end

-- API pública ------------------------------------------------------------------------------------

-- Gera o mapa inteiro. Idempotente: destrói workspace.Map (e refaz o terreno) antes de gerar de novo.
function MapGen.start(): ()
	local old = Workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	disconnectAll()
	table.clear(lajes)
	table.clear(carretels)
	table.clear(muretasOf)
	partCount = 0

	local rng = Random.new(Config.SEED)
	setupLighting()
	buildTerrain()

	local map = Instance.new("Folder")
	map.Name = "Map"
	buildCampinho(map)
	buildSpawn(map)
	buildBar(map)
	buildPoste(map)
	buildArvore(map)
	local lajesFolder = Instance.new("Folder")
	lajesFolder.Name = "Lajes"
	for i = 1, Config.LAJE_COUNT do
		buildLaje(i, lajesFolder)
	end
	lajesFolder.Parent = map
	buildRampas(map)
	buildEnfeites(map, rng)
	buildParedes(map)
	map.Parent = Workspace -- Parent por último: tudo (prompts inclusive) replica de uma vez

	ensureFolder("KiteStates")
	ensureWorld()
	built = true
	watchVip()
	print(`[MapGen] Morro do Vento gerado: {partCount} Parts, {Config.LAJE_COUNT} lajes`)
end

local function ensureBuilt()
	if not built then
		warn("[MapGen] chamado antes de start(); gerando o mapa agora")
		MapGen.start()
	end
end

-- Model da laje i (tag Laje, Attributes Index/OwnerId/Angle/VaralCodes; PrimaryPart = Floor).
function MapGen.lajeModel(i: number): Model
	ensureBuilt()
	local model = lajes[i]
	if not model then
		error(`[MapGen] laje {i} não existe (1..{Config.LAJE_COUNT})`)
	end
	return model
end

-- Posição (centro) do carretel da laje i.
function MapGen.carretelPos(i: number): Vector3
	ensureBuilt()
	local pos = carretels[i]
	if not pos then
		error(`[MapGen] laje {i} não existe (1..{Config.LAJE_COUNT})`)
	end
	return pos
end

return MapGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	MonetizationService — passes e produtos (GDD §5.7).

	- Passes (Config.IDS.PASS_*): posse em cache por sessão (UserOwnsGamePassAsync em pcall ao entrar);
	  PromptGamePassPurchaseFinished atualiza o cache na hora. Efeitos: Vento em Dobro → ventoMult =
	  PASS_VENTO_DOBRO_MULT; Carretel Automático → hasAutoReel; VIP da Laje → isVIP, atributo VIP do Player e
	  offlineCap = OFFLINE_CAP_VIP; Kit Pipeiro → ShopService.grantKit no load (1×, KitClaimed).
	  Os quatro entram no DataService por DataService.hooks (registrados no start()).
	- Produtos (Config.IDS.PROD_*): MarketplaceService.ProcessReceipt idempotente (cheat sheet §7.2):
	  o PurchaseId fica em profile.Data.Purchases (últimos PURCHASE_HISTORY); conceder → profile:Save() →
	  PurchaseGranted só quando profile.LastSavedData.Purchases contém o id (até RECEIPT_SAVE_TIMEOUT s;
	  senão NotProcessedYet e a Roblox chama de novo). Rajada no Servidor / Vento Forte →
	  EventService.startServerBoost; Resgatar da Árvore → KiteService.rescueFromTree; Guardar Streak →
	  ShopService.useStreakSaver. Produto que não tinha o que conceder (nenhuma pipa na árvore, saver já usado
	  na semana) é registrado mesmo assim — o Robux já foi gasto — e o jogador recebe Toast("Erro").
	  Nenhum produto da v1 dá Vento; se algum der, use DataService.addVento(p, n, "Produto").
	- Ids 0 (placeholders até a publicação) = não configurado: o passe conta como não possuído e o produto
	  não tem handler. Nada aqui yielda fora da thread de PlayerAdded (ownsPass só espera a consulta inicial).
	Requer: Config, DataService, KiteService, ShopService, EventService (camada mais alta; ninguém o requer).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local DataService = require(script.Parent.DataService)
local KiteService = require(script.Parent.KiteService)
local ShopService = require(script.Parent.ShopService)
local EventService = require(script.Parent.EventService)

type ProfileData = Config.ProfileData
type Profile = DataService.Profile
type ReceiptInfo = { [string]: any }
type ProductHandler = (p: Player) -> boolean -- false = não havia o que conceder

local IDS = (Config.IDS :: any) :: { [string]: number }
local PASS_KEYS = { "PASS_VENTO_DOBRO", "PASS_CARRETEL_AUTO", "PASS_VIP", "PASS_KIT" }
local SAVE_POLL = 1 -- s entre checagens do LastSavedData no ProcessReceipt (não é regra de jogo)

local MonetizationService = {}

local passCache: { [Player]: { [string]: boolean } } = {}
local loading: { [Player]: boolean } = {}
local started = false

-- Produtos: chave de Config.IDS → concessão.
local PRODUCTS: { [string]: ProductHandler } = {
	PROD_RAJADA = function(p: Player): boolean
		EventService.startServerBoost("Rajada", p)
		return true
	end,
	PROD_VENTO_FORTE = function(p: Player): boolean
		EventService.startServerBoost("VentoForte", p)
		return true
	end,
	PROD_RESGATE = function(p: Player): boolean
		return KiteService.rescueFromTree(p)
	end,
	PROD_GUARDAR_STREAK = function(p: Player): boolean
		return ShopService.useStreakSaver(p)
	end,
}
-- Chave de Config.STRINGS do Toast("Erro") quando o produto não tinha o que conceder.
local PRODUCT_FAIL_KEY: { [string]: string } = { PROD_RESGATE = "errNoTree", PROD_GUARDAR_STREAK = "errSaverUsed" }

-- Passes -----------------------------------------------------------------------------------------

local function idOf(key: string): number
	return IDS[key] or 0
end

-- Consulta os passes configurados de p (pcall; falha = não possui) e guarda no cache da sessão.
local function loadPasses(p: Player)
	if loading[p] then
		return
	end
	loading[p] = true
	local owned: { [string]: boolean } = {}
	for _, key in PASS_KEYS do
		local id = idOf(key)
		if id ~= 0 then
			local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, p.UserId, id)
			if ok then
				owned[key] = result == true
			else
				warn(`[MonetizationService] UserOwnsGamePassAsync({key}) falhou para {p.Name}: {result}`)
			end
		end
	end
	local previous = passCache[p] -- compra concluída enquanto a consulta rodava
	if previous then
		for key, has in previous do
			if has then
				owned[key] = true
			end
		end
	end
	if p.Parent == Players then
		passCache[p] = owned
	end
	loading[p] = nil
end

-- Posse de um passe (key = chave de Config.IDS). Id 0 → false. Só yielda enquanto a consulta inicial de p
-- ainda roda (ou se ela nunca rodou), o que só acontece na thread de PlayerAdded do DataService.
function MonetizationService.ownsPass(p: Player, key: string): boolean
	if idOf(key) == 0 then
		return false
	end
	if passCache[p] == nil then
		if loading[p] then
			while loading[p] do
				task.wait()
			end
		else
			loadPasses(p)
		end
	end
	local owned = passCache[p]
	return owned ~= nil and owned[key] == true
end

local function onPassGranted(p: Player, key: string)
	if key == "PASS_VIP" then
		p:SetAttribute("VIP", true)
	elseif key == "PASS_KIT" then
		ShopService.grantKit(p)
	end
	-- Vento em Dobro / Carretel Automático: o DataService lê os hooks a cada INCOME_TICK
end

local function onPassPurchaseFinished(p: Player, passId: number, purchased: boolean)
	if not purchased then
		return
	end
	for _, key in PASS_KEYS do
		if idOf(key) == passId then
			local owned = passCache[p] or {}
			passCache[p] = owned
			owned[key] = true
			onPassGranted(p, key)
		end
	end
end

-- Produtos (ProcessReceipt) ----------------------------------------------------------------------

local function productKeyOf(productId: number): string?
	for key in PRODUCTS do
		local id = idOf(key)
		if id ~= 0 and id == productId then
			return key
		end
	end
	return nil
end

local function rememberPurchase(data: ProfileData, purchaseId: string)
	table.insert(data.Purchases, purchaseId)
	while #data.Purchases > Config.PURCHASE_HISTORY do
		table.remove(data.Purchases, 1)
	end
end

-- Salva e só confirma quando o id aparece no último snapshot salvo (LastSavedData).
local function confirmSaved(profile: Profile, purchaseId: string): Enum.ProductPurchaseDecision
	profile:Save()
	local deadline = os.clock() + Config.RECEIPT_SAVE_TIMEOUT
	while os.clock() < deadline and profile:IsActive() do
		if table.find(profile.LastSavedData.Purchases, purchaseId) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		task.wait(SAVE_POLL)
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet -- já está no Data: a próxima chamada confirma
end

local function processReceipt(receipt: ReceiptInfo): Enum.ProductPurchaseDecision
	local playerId, purchaseId, productId = receipt.PlayerId, receipt.PurchaseId, receipt.ProductId
	if typeof(playerId) ~= "number" or typeof(purchaseId) ~= "string" or typeof(productId) ~= "number" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = Players:GetPlayerByUserId(playerId)
	if not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- saiu: a Roblox tenta de novo quando ele voltar
	end
	local profile = DataService.get(p)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- perfil ainda não carregou
	end
	if table.find(profile.LastSavedData.Purchases, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- já concedido e salvo
	end
	local data = profile.Data
	if not table.find(data.Purchases, purchaseId) then
		local key = productKeyOf(productId)
		if not key then
			warn(`[MonetizationService] produto sem handler: {productId}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local ok, granted = pcall(PRODUCTS[key], p)
		if not ok then
			warn(`[MonetizationService] falha ao conceder {key} para {p.Name}: {granted}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if granted == false then
			local msgKey = PRODUCT_FAIL_KEY[key] or "errProduct"
			DataService.toast(p, "Erro", { msg = Config.str(msgKey, "pt-BR"), key = msgKey })
		end
		rememberPurchase(data, purchaseId)
		print(`[Economia] {p.Name} comprou {key} ({purchaseId})`)
	end
	return confirmSaved(profile, purchaseId)
end

-- API pública -------------------------------------------------------------------------------------

-- PASS_VENTO_DOBRO_MULT com Vento em Dobro, senão 1.
function MonetizationService.ventoMult(p: Player): number
	return if MonetizationService.ownsPass(p, "PASS_VENTO_DOBRO") then Config.PASS_VENTO_DOBRO_MULT else 1
end

function MonetizationService.hasAutoReel(p: Player): boolean
	return MonetizationService.ownsPass(p, "PASS_CARRETEL_AUTO")
end

function MonetizationService.isVIP(p: Player): boolean
	return MonetizationService.ownsPass(p, "PASS_VIP")
end

-- OFFLINE_CAP ou OFFLINE_CAP_VIP (segundos).
function MonetizationService.offlineCap(p: Player): number
	return if MonetizationService.isVIP(p) then Config.OFFLINE_CAP_VIP else Config.OFFLINE_CAP
end

local function onLoaded(p: Player, data: ProfileData)
	p:SetAttribute("VIP", MonetizationService.isVIP(p)) -- garante o valor caso o cache tenha chegado depois do load
	if not data.KitClaimed and MonetizationService.ownsPass(p, "PASS_KIT") then
		ShopService.grantKit(p)
	end
end

function MonetizationService.start(): ()
	DataService.hooks.ventoMult = MonetizationService.ventoMult
	DataService.hooks.hasAutoReel = MonetizationService.hasAutoReel
	DataService.hooks.isVIP = MonetizationService.isVIP
	DataService.hooks.offlineCap = MonetizationService.offlineCap
	if started then
		return
	end
	started = true
	MarketplaceService.ProcessReceipt = processReceipt -- definido uma única vez
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchaseFinished)
	Players.PlayerAdded:Connect(function(p: Player)
		task.spawn(loadPasses, p)
	end)
	Players.PlayerRemoving:Connect(function(p: Player)
		passCache[p] = nil
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(loadPasses, p)
	end
	DataService.onLoaded(onLoaded)
	local configured = 0
	for _, id in IDS do
		if id ~= 0 then
			configured += 1
		end
	end
	if configured == 0 then
		warn("[MonetizationService] Config.IDS são placeholders (0): passes e produtos desativados até a publicação")
	end
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --> [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --> [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -> (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --> is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --> [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --> [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --> is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --> [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --> [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -> ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --> next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --> loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --> loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList > 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T> = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -> ()) -> ({Disconnect: (self: any) -> ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -> (boolean),
	Reconcile: (self: any) -> (),
	EndSession: (self: any) -> (),
	AddUserId: (self: any, user_id: number) -> (),
	RemoveUserId: (self: any, user_id: number) -> (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -> ()) -> ()) -> (),
	Save: (self: any) -> (),
	SetAsync: (self: any) -> (),
}

export type VersionQuery&lt;T> = {
	NextAsync: (self: any) -> (Profile&lt;T>?),
}

type ProfileStoreStandard&lt;T> = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -> (Profile&lt;T>?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -> (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -> (Profile&lt;T>?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -> (VersionQuery&lt;T>),
	RemoveAsync: (self: any, profile_key: string) -> (boolean),
}

export type ProfileStore&lt;T> = {
	Mock: ProfileStoreStandard&lt;T>,
} &amp; ProfileStoreStandard&lt;T>

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -> ()) -> ({Disconnect: (self: any) -> ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -> ()) -> ({Disconnect: (self: any) -> ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T>(store_name: string, template: (T &amp; JSONAcceptable)?) -> (ProfileStore&lt;T>),
	SetConstant: (name: ConstantName, value: number) -> ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) > 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message > 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update > ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps >= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() >= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start >= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list > MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) > 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue > 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length > 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave > auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex > auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp >= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex > auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue >= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart > CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time > CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count > 0 or ActiveProfileLoadJobs > 0 or ActiveProfileSaveJobs > 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ShopService — a economia do jogador: Bar do Vento, Linha, vagas, streak, dailies, renascer e Kit.

	- Bar do Vento (GDD §5.2): estoque de SHOP_SLOTS_NORMAL slots normais (SHOP_TABLE) + SHOP_SLOTS_SPECIAL
	  especiais (SHOP_SPECIAL_TABLE). seed = os.time() // RESTOCK_SECONDS e Random.new(seed) → o mesmo
	  estoque em todo servidor; RestockAt = (seed + 1) × RESTOCK_SECONDS (epoch em segundos: o mesmo relógio
	  de os.time() e de workspace:GetServerTimeNow(), escrito em workspace.World.RestockAt). Cada slot é
	  comprado 1× por jogador por restock. ShopStock vai ao jogador no join e a todos no restock.
	- Linha de Vento (Config.linhaPrice, até LINHA_MAX) e vagas do varal (VAGA_PRICE, até VAGAS_MAX) a preço
	  fixo (§3.4). Toda compra exige HumanoidRootPart a ≤ SHOP_DIST do balcão (Config.BAR_POS) e Vento
	  (DataService.spendVento). Pipas compradas ganham cor cosmética 1..COSMETIC_COLORS.
	- Correio da Laje (§5.4): streak diário (dia = os.time() // DAY_SECONDS) D1-D7 = STREAK, D5/D7 também
	  STREAK_KITE, D8-D28 repetem o ciclo com Vento × STREAK_REPEAT_MULT, trava em STREAK_CAP_DAY;
	  2 dias sem resgatar → volta ao D1, salvo Guardar Streak usado na semana (Streak.SaverWeek).
	  Dailies "Corte 3 selvagens" / "Pegue 1 pipa" com reset diário (Dailies.Day); o progresso chega por
	  KiteService.onDuelEnd (vencedor humano contra selvagem) e KiteService.onCatch.
	- Renascer "Nova Temporada" (§3.6) e Kit Pipeiro (§5.7; grantKit, 1× por KitClaimed).

	Todo preço vem do Config; todo remote é hostil (tipo, faixa, distância e saldo validados aqui).
	Quem muda profile.Data chama DataService.pushState com os campos alterados; profile:Save() em compra,
	renascer e Kit. Toast("Erro", {msg, key, vars}): msg em pt-BR, key/vars para o HUD localizar.
	Requer: Config, Remotes, DataService, KiteService. NUNCA requer EventService/MonetizationService
	(VIP via DataService.hooks.isVIP).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local AnalyticsService = game:GetService("AnalyticsService")
local BadgeService = game:GetService("BadgeService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local DataService = require(script.Parent.DataService)
local KiteService = require(script.Parent.KiteService)

export type StockSlot = { model: string, rarity: number, price: number, special: boolean }
export type Stock = { seed: number, restockAt: number, slots: { StockSlot } }
export type BuyKind = "Kite" | "Linha" | "Vaga"
export type DailyKind = "Cortes" | "Pegas"

type ProfileData = Config.ProfileData
type KiteData = Config.KiteData
type Streak = { Day: number, LastClaimDay: number, SaverWeek: number }
type Dailies = { Day: number, Cortes: number, Pegas: number, ClaimedCortes: boolean, ClaimedPegas: boolean }
type BoughtSlots = { seed: number, slots: { [number]: boolean } }

local BUY_KINDS = { "Kite", "Linha", "Vaga" }
local DAILY_KINDS = { "Cortes", "Pegas" }
local SEASON_MODEL = "Temporada" -- modelo da Pipa de Temporada (§3.2)
local STATUS_FLYING = "Flying"
local RESTOCK_POLL = 1 -- s entre checagens do relógio do restock (não é regra de jogo)

local ShopService = {}

local rng = Random.new()
local stock: Stock = { seed = 0, restockAt = 0, slots = {} }
local bought: { [Player]: BoughtSlots } = {}
local stockRemote: RemoteEvent? = nil

local buyLimiter = Remotes.limiter(Config.RATE.Buy[1], Config.RATE.Buy[2])
local streakLimiter = Remotes.limiter(Config.RATE.ClaimStreak[1], Config.RATE.ClaimStreak[2])
local dailyLimiter = Remotes.limiter(Config.RATE.ClaimDaily[1], Config.RATE.ClaimDaily[2])
local rebirthLimiter = Remotes.limiter(Config.RATE.Rebirth[1], Config.RATE.Rebirth[2])
local petLimiter = Remotes.limiter(Config.RATE.SetPet[1], Config.RATE.SetPet[2])
local readyLimiter = Remotes.limiter(Config.RATE.Ready[1], Config.RATE.Ready[2])

-- Ajudantes ---------------------------------------------------------------------------------------

local function dataOf(p: Player): ProfileData?
	local profile = DataService.get(p)
	return if profile then profile.Data else nil
end

-- Dia UTC: os.time() // DAY_SECONDS.
local function today(): number
	return os.time() // Config.DAY_SECONDS
end

-- Semana desde segunda 00:00 UTC (mesma fórmula do Leaderboard, que não pode ser requerido daqui).
local function weekIndex(): number
	return (os.time() - Config.WEEK_EPOCH_OFFSET) // Config.WEEK_SECONDS
end

-- workspace/World (Configuration criada pelo MapGen; criada aqui se faltar).
local function world(): Configuration
	local found = Workspace:FindFirstChild("World")
	if found and found:IsA("Configuration") then
		return found
	end
	local conf = Instance.new("Configuration")
	conf.Name = "World"
	conf.Parent = Workspace
	return conf
end

-- HumanoidRootPart a ≤ SHOP_DIST do balcão do Bar (o cliente pode disparar Buy de qualquer lugar).
local function nearBar(p: Player): boolean
	local character = p.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if not root or not root:IsA("BasePart") then
		return false
	end
	return (root.Position - Config.BAR_POS).Magnitude <= Config.SHOP_DIST
end

-- Toast "Erro" (texto pt-BR + chave para o HUD localizar) e retorna false para encurtar os `return`.
local function fail(p: Player, key: string, vars: { [string]: any }?): boolean
	DataService.toast(p, "Erro", { msg = Config.str(key, "pt-BR", vars), key = key, vars = vars })
	return false
end

-- Passo do funil (§5.8): só avança; loga no AnalyticsService.
local function onboarding(p: Player, data: ProfileData, stepName: string)
	local step = table.find(Config.ONBOARDING_STEPS, stepName)
	if not step or data.Onboarding >= step then
		return
	end
	data.Onboarding = step
	DataService.pushState(p, { Onboarding = step })
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(p, step, stepName)
	end)
end

-- Badge (ids 0 = ainda não criada no Creator Hub → ignora).
local function awardBadge(p: Player, badgeId: number)
	if badgeId == 0 then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function(): boolean
			return BadgeService:AwardBadgeAsync(p.UserId, badgeId)
		end)
		if not ok then
			warn(`[ShopService] badge {badgeId} falhou para {p.Name}: {err}`)
		end
	end)
end

-- Bar do Vento: estoque ---------------------------------------------------------------------------------

-- Sorteia uma raridade pelos pesos (pesos 0 nunca saem).
local function rollRarity(r: Random, weights: { number }): number
	local total = 0
	for _, w in weights do
		total += w
	end
	local x = r:NextNumber() * total
	local acc = 0
	local last = 1
	for rarity, w in weights do
		if w > 0 then
			acc += w
			last = rarity
			if x < acc then
				return rarity
			end
		end
	end
	return last
end

local function newSlot(r: Random, weights: { number }, special: boolean): StockSlot
	local rarity = rollRarity(r, weights)
	return { model = Config.MODEL_BY_RARITY[rarity], rarity = rarity, price = Config.SHOP_PRICE[rarity], special = special }
end

-- Estoque determinístico da janela `seed` (igual em todo servidor).
local function buildStock(seed: number): Stock
	local r = Random.new(seed)
	local slots: { StockSlot } = {}
	for _ = 1, Config.SHOP_SLOTS_NORMAL do
		table.insert(slots, newSlot(r, Config.SHOP_TABLE, false))
	end
	for _ = 1, Config.SHOP_SLOTS_SPECIAL do
		table.insert(slots, newSlot(r, Config.SHOP_SPECIAL_TABLE, true))
	end
	return { seed = seed, restockAt = (seed + 1) * Config.RESTOCK_SECONDS, slots = slots }
end

-- Slots já comprados por p neste restock (zera quando o seed muda).
local function boughtSlots(p: Player): { [number]: boolean }
	local mine = bought[p]
	if mine and mine.seed == stock.seed then
		return mine.slots
	end
	local fresh: BoughtSlots = { seed = stock.seed, slots = {} }
	bought[p] = fresh
	return fresh.slots
end

-- Payload de ShopStock (§7.3): os slots com o campo bought do próprio jogador.
local function stockFor(p: Player): { [string]: any }
	local mine = boughtSlots(p)
	local slots = {}
	for i, s in stock.slots do
		slots[i] = { model = s.model, rarity = s.rarity, price = s.price, special = s.special, bought = mine[i] == true }
	end
	return { seed = stock.seed, restockAt = stock.restockAt, slots = slots }
end

local function sendStock(p: Player)
	if stockRemote then
		stockRemote:FireClient(p, stockFor(p))
	end
end

-- Troca o estoque, zera as compras do restock anterior e avisa todo mundo.
local function restock(seed: number)
	stock = buildStock(seed)
	table.clear(bought)
	world():SetAttribute("RestockAt", stock.restockAt)
	for _, p in Players:GetPlayers() do
		sendStock(p)
	end
end

local function restockLoop()
	while true do
		task.wait(RESTOCK_POLL)
		local seed = os.time() // Config.RESTOCK_SECONDS
		if seed ~= stock.seed then
			restock(seed)
		end
	end
end

-- Bar do Vento: compras ---------------------------------------------------------------------------------

local function buyKite(p: Player, slot: number?): boolean
	local s = if slot then stock.slots[slot] else nil
	if not s or not slot then
		return false
	end
	local mine = boughtSlots(p)
	if mine[slot] then
		return fail(p, "errBought")
	end
	if s.price == math.huge then
		return false -- raridade sem preço (a Mítica não é vendida)
	end
	if not DataService.spendVento(p, s.price, "Pipa") then
		return fail(p, "errVento", { n = s.price })
	end
	mine[slot] = true
	DataService.addKite(p, s.model, s.rarity, rng:NextInteger(1, Config.COSMETIC_COLORS), false)
	sendStock(p)
	return true
end

local function buyLinha(p: Player, data: ProfileData): boolean
	local level = data.Linha + 1
	if level > Config.LINHA_MAX then
		return fail(p, "errMaxLinha")
	end
	local price = Config.linhaPrice(level)
	if not DataService.spendVento(p, price, "Linha") then
		return fail(p, "errVento", { n = price })
	end
	data.Linha = level
	DataService.pushState(p, { Linha = level })
	return true
end

local function buyVaga(p: Player, data: ProfileData): boolean
	local vagas = data.Vagas + 1
	local price = Config.VAGA_PRICE[vagas]
	if vagas > Config.VAGAS_MAX or not price then
		return fail(p, "errMaxVagas")
	end
	if not DataService.spendVento(p, price, "Vaga") then
		return fail(p, "errVento", { n = price })
	end
	data.Vagas = vagas
	DataService.pushState(p, { Vagas = vagas })
	return true
end

-- Compra no Bar: Kite (slot 1..5 do estoque), Linha (próximo nível) ou Vaga (próxima vaga).
function ShopService.buy(p: Player, kind: BuyKind, slot: number?): boolean
	local profile = DataService.get(p)
	if not profile then
		return false
	end
	if not nearBar(p) then
		return fail(p, "errFarBar")
	end
	local data = profile.Data
	local ok = false
	if kind == "Kite" then
		ok = buyKite(p, slot)
	elseif kind == "Linha" then
		ok = buyLinha(p, data)
	elseif kind == "Vaga" then
		ok = buyVaga(p, data)
	end
	if ok then
		onboarding(p, data, "PrimeiraCompra")
		profile:Save()
	end
	return ok
end

-- Estoque atual (seed = os.time() // RESTOCK_SECONDS; igual em todos os servidores).
function ShopService.stock(): Stock
	return stock
end

-- Correio da Laje: streak (§5.4) --------------------------------------------------------------------------

-- Dia do streak a pagar hoje: D1 na 1ª vez ou depois de 2+ dias sem resgatar (salvo Guardar Streak usado
-- nesta semana); senão o dia seguinte, travado em STREAK_CAP_DAY.
local function nextStreakDay(s: Streak): number
	if s.LastClaimDay == 0 then
		return 1
	end
	local gap = today() - s.LastClaimDay
	if gap >= 2 and s.SaverWeek ~= weekIndex() then
		return 1
	end
	return math.min(s.Day + 1, Config.STREAK_CAP_DAY)
end

-- Resgata o dia de hoje: Vento (D8+ × STREAK_REPEAT_MULT) e, nos dias de STREAK_KITE, uma pipa.
function ShopService.claimStreak(p: Player): boolean
	local data = dataOf(p)
	if not data then
		return false
	end
	local s = data.Streak
	local day = today()
	if day <= s.LastClaimDay then
		return fail(p, "errStreak")
	end
	local d = nextStreakDay(s)
	local cycle = (d - 1) % #Config.STREAK + 1 -- posição D1..D7 dentro do ciclo
	local mult = if d > #Config.STREAK then Config.STREAK_REPEAT_MULT else 1
	local vento = Config.STREAK[cycle] * mult
	s.Day = d
	s.LastClaimDay = day
	DataService.addVento(p, vento, "Streak")
	local args: { [string]: any } = { day = d, n = vento }
	local kite = Config.STREAK_KITE[cycle]
	if kite then
		local color = kite.color or rng:NextInteger(1, Config.COSMETIC_COLORS)
		DataService.addKite(p, kite.model, kite.rarity, color, false)
		args.kite = kite.model
	end
	DataService.pushState(p, { Streak = s })
	DataService.toast(p, "Streak", args)
	return true
end

-- Guardar Streak (produto, 1×/semana): protege o streak contra uma falta nesta semana.
function ShopService.useStreakSaver(p: Player): boolean
	local data = dataOf(p)
	if not data then
		return false
	end
	local week = weekIndex()
	if data.Streak.SaverWeek == week then
		return false
	end
	data.Streak.SaverWeek = week
	DataService.pushState(p, { Streak = data.Streak })
	return true
end

-- Correio da Laje: dailies ---------------------------------------------------------------------------------

-- Zera as dailies quando o dia mudou. Retorna true se zerou.
local function ensureDailies(data: ProfileData): boolean
	local d = data.Dailies
	local day = today()
	if d.Day == day then
		return false
	end
	d.Day = day
	d.Cortes = 0
	d.Pegas = 0
	d.ClaimedCortes = false
	d.ClaimedPegas = false
	return true
end

local function dailyDef(which: DailyKind): { goal: number, reward: number }
	return if which == "Cortes" then Config.DAILY.Cortes else Config.DAILY.Pegas
end

local function dailyProgress(d: Dailies, which: DailyKind): number
	return if which == "Cortes" then d.Cortes else d.Pegas
end

local function dailyClaimed(d: Dailies, which: DailyKind): boolean
	return if which == "Cortes" then d.ClaimedCortes else d.ClaimedPegas
end

-- Chamado via KiteService.onDuelEnd (Cortes em selvagens) e KiteService.onCatch (Pegas).
function ShopService.progressDaily(p: Player, which: DailyKind, n: number): ()
	local data = dataOf(p)
	if not data or n <= 0 then
		return
	end
	ensureDailies(data)
	local d = data.Dailies
	if which == "Cortes" then
		d.Cortes += n
	else
		d.Pegas += n
	end
	DataService.pushState(p, { Dailies = d })
end

-- Paga Config.DAILY[which].reward se a meta foi batida e ainda não foi resgatada hoje.
function ShopService.claimDaily(p: Player, which: DailyKind): boolean
	local data = dataOf(p)
	if not data then
		return false
	end
	ensureDailies(data)
	local d = data.Dailies
	local def = dailyDef(which)
	if dailyClaimed(d, which) or dailyProgress(d, which) < def.goal then
		return fail(p, "errDaily")
	end
	if which == "Cortes" then
		d.ClaimedCortes = true
	else
		d.ClaimedPegas = true
	end
	DataService.addVento(p, def.reward, "Daily")
	DataService.pushState(p, { Dailies = d })
	return true
end

-- Renascer "Nova Temporada" (§3.6) --------------------------------------------------------------------------

-- Custo da temporada seguinte: REBIRTH_BASE × REBIRTH_GROWTH^(n-1), com n = Temporadas + 1.
local function rebirthCost(temporadas: number): number
	return Config.REBIRTH_BASE * Config.REBIRTH_GROWTH ^ temporadas
end

-- A pipa consumida: a de menor valor com raridade ≥ REBIRTH_NEED_RARITY (Jornal e Pipas de Temporada ficam de fora).
local function findEpic(data: ProfileData): KiteData?
	local best: KiteData? = nil
	for _, k in data.Kites do
		if k.rarity >= Config.REBIRTH_NEED_RARITY and not k.starter and k.season == 0 then
			if not best or Config.baseRate(k) < Config.baseRate(best) then
				best = k
			end
		end
	end
	return best
end

-- Pipa de maior base × (dourada ? GOLDEN_MULT : 1): a mesma regra da seleção padrão (§2.1).
local function bestKite(kites: { KiteData }): KiteData?
	local best: KiteData? = nil
	for _, k in kites do
		if not best or Config.baseRate(k) > Config.baseRate(best) then
			best = k
		end
	end
	return best
end

-- Estimações mantidas no renascer: PETS_KEPT (PETS_KEPT_VIP com VIP).
local function petLimit(p: Player): number
	return if DataService.hooks.isVIP(p) then Config.PETS_KEPT_VIP else Config.PETS_KEPT
end

-- O que fica no varal (§3.6): Jornal, Pipas de Temporada, Arraia Pipeiro e as petLimit(p) estimações de maior
-- valor. A Épica consumida não entra aqui (vira a Pipa de Temporada nova).
local function keptKites(p: Player, data: ProfileData, consumed: KiteData): { KiteData }
	local maxPets = petLimit(p)
	local kept: { KiteData } = {}
	local pets: { KiteData } = {}
	for _, k in data.Kites do
		if k == consumed then
			continue
		end
		if k.starter or k.season > 0 or k.model == Config.KIT.model then
			table.insert(kept, k)
		elseif k.pet then
			table.insert(pets, k)
		end
	end
	table.sort(pets, function(a: KiteData, b: KiteData): boolean
		return Config.baseRate(a) > Config.baseRate(b)
	end)
	for i = 1, math.min(maxPets, #pets) do
		table.insert(kept, pets[i])
	end
	return kept
end

-- Renascer: exige Vento ≥ custo e uma Épica no varal; consome TODO o Vento e o Carretel, reduz o varal ao
-- que fica (§3.6), cria a Pipa de Temporada n (cor SEASON_COLOR_BASE + n) e soma 1 em Temporadas.
function ShopService.rebirth(p: Player): boolean
	local profile = DataService.get(p)
	if not profile then
		return false
	end
	local data = profile.Data
	if data.Temporadas >= Config.REBIRTH_MAX then
		return fail(p, "errRebirthMax")
	end
	local cost = rebirthCost(data.Temporadas)
	local epic = findEpic(data)
	if data.Vento < cost or not epic then
		return fail(p, "errRebirth", { vento = cost })
	end
	local flying = KiteService.flyingOf(p)
	if flying and flying.status ~= STATUS_FLYING then
		return fail(p, "errDuel") -- em duelo a pipa no ar ainda pode mudar de dono
	end
	local n = data.Temporadas + 1
	KiteService.recall(p)
	DataService.spendVento(p, data.Vento, "Renascer") -- todo o Vento vai embora, não só o custo
	local kites = keptKites(p, data, epic)
	local season: KiteData = {
		id = data.NextKiteId,
		model = SEASON_MODEL,
		rarity = Config.rarityOf(SEASON_MODEL),
		color = Config.SEASON_COLOR_BASE + n,
		golden = epic.golden,
		pet = epic.pet,
		season = n,
		starter = false,
	}
	data.NextKiteId += 1
	table.insert(kites, season)
	data.Kites = kites
	data.Carretel = 0
	data.Temporadas = n
	local best = bestKite(kites)
	data.Selected = if best then best.id else 0
	DataService.pushState(p, { Vento = data.Vento, Carretel = 0, Temporadas = n, Kites = kites, Selected = data.Selected })
	if best then
		KiteService.select(p, best.id) -- sobe a nova selecionada na faixa 0
	end
	DataService.toast(p, "Renasceu", { n = n })
	if n == 1 then
		awardBadge(p, Config.BADGES.Temporada1)
	end
	profile:Save()
	return true
end

-- Kit Pipeiro (§5.7) ---------------------------------------------------------------------------------------------

-- Arraia Pipeiro + KIT.vento + Linha mínima KIT.linhaMin; 1× por conta (KitClaimed).
function ShopService.grantKit(p: Player): ()
	local profile = DataService.get(p)
	if not profile or profile.Data.KitClaimed then
		return
	end
	local data = profile.Data
	data.KitClaimed = true
	DataService.addKite(p, Config.KIT.model, Config.KIT.rarity, Config.KIT.color, false)
	DataService.addVento(p, Config.KIT.vento, "Kit")
	if data.Linha < Config.KIT.linhaMin then
		data.Linha = Config.KIT.linhaMin
		DataService.pushState(p, { Linha = data.Linha })
	end
	profile:Save()
end

-- Estimação (remote SetPet) ----------------------------------------------------------------------------------------

-- Marca/desmarca a pipa como estimação (toque longo na carta, §3.6/§6). Jornal e Pipas de Temporada já ficam no
-- renascer, então não podem ser marcadas; no máximo petLimit(p) marcadas ao mesmo tempo.
function ShopService.setPet(p: Player, kiteId: number): boolean
	local data = dataOf(p)
	local k = DataService.findKite(p, kiteId)
	if not data or not k or k.starter or k.season > 0 then
		return false
	end
	if not k.pet then
		local limit = petLimit(p)
		local marked = 0
		for _, other in data.Kites do
			if other.pet then
				marked += 1
			end
		end
		if marked >= limit then
			return fail(p, "errPetMax", { n = limit })
		end
	end
	k.pet = not k.pet
	DataService.pushState(p, { Kites = data.Kites })
	return true
end

-- Remotes e início ---------------------------------------------------------------------------------------------

local function onSetPet(p: Player, kiteId: unknown)
	if not petLimiter:allow(p) then
		return
	end
	local data = dataOf(p)
	if not data or not Remotes.isInt(kiteId, 1, data.NextKiteId) then
		return
	end
	ShopService.setPet(p, (kiteId :: any) :: number)
end

local function onBuy(p: Player, kind: unknown, slot: unknown)
	if not buyLimiter:allow(p) then
		return
	end
	if typeof(kind) ~= "string" or not table.find(BUY_KINDS, kind) then
		return
	end
	if kind == "Kite" and not Remotes.isInt(slot, 1, #stock.slots) then
		return
	end
	local buyKind: BuyKind = (kind :: any) :: BuyKind -- anotação explícita: sem ela o analisador alarga para string
	ShopService.buy(p, buyKind, if buyKind == "Kite" then (slot :: any) :: number else nil)
end

local function onClaimDaily(p: Player, which: unknown)
	if not dailyLimiter:allow(p) then
		return
	end
	if typeof(which) ~= "string" or not table.find(DAILY_KINDS, which) then
		return
	end
	ShopService.claimDaily(p, (which :: any) :: DailyKind)
end

local function onLoaded(p: Player, data: ProfileData)
	if ensureDailies(data) then
		DataService.pushState(p, { Dailies = data.Dailies })
	end
	sendStock(p)
end

local function onPlayerRemoving(p: Player)
	bought[p] = nil
	buyLimiter:forget(p)
	streakLimiter:forget(p)
	dailyLimiter:forget(p)
	rebirthLimiter:forget(p)
	petLimiter:forget(p)
	readyLimiter:forget(p)
end

function ShopService.start(): ()
	stockRemote = Remotes.get("ShopStock")
	restock(os.time() // Config.RESTOCK_SECONDS)
	Remotes.get("Buy").OnServerEvent:Connect(onBuy)
	Remotes.get("ClaimStreak").OnServerEvent:Connect(function(p: Player)
		if streakLimiter:allow(p) then
			ShopService.claimStreak(p)
		end
	end)
	Remotes.get("ClaimDaily").OnServerEvent:Connect(onClaimDaily)
	Remotes.get("Rebirth").OnServerEvent:Connect(function(p: Player)
		if rebirthLimiter:allow(p) then
			ShopService.rebirth(p)
		end
	end)
	KiteService.onDuelEnd(function(winner: Player?, _loser: Player?, wild: boolean)
		if winner and wild then
			ShopService.progressDaily(winner, "Cortes", 1) -- "Corte 3 selvagens"
		end
	end)
	KiteService.onCatch(function(p: Player, _k: KiteService.KiteState)
		ShopService.progressDaily(p, "Pegas", 1) -- "Pegue 1 pipa no campinho"
	end)
	Remotes.get("SetPet").OnServerEvent:Connect(onSetPet)
	Remotes.get("Ready").OnServerEvent:Connect(function(p: Player) -- o cliente acabou de conectar ShopStock
		if readyLimiter:allow(p) then
			sendStock(p)
		end
	end)
	DataService.onLoaded(onLoaded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	task.spawn(restockLoop)
end

return ShopService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Bootstrap do cliente (LocalScript; HUD e KiteRenderer são filhos: script.HUD / script.KiteRenderer).

	• Inicia HUD e KiteRenderer (cada um em pcall: um módulo quebrado não derruba o outro).
	• Input → Pull: InputBegan/InputEnded no botão PUXAR (HUD.onPull), tecla Espaço e Gamepad ButtonA
	  (ContextActionService) → Remotes "Pull" com "Down"/"Up" + HUD.setPressed. Nunca manda "Down" duas vezes.
	• Callbacks do HUD → remotes: SelectKite(kiteId), Buy(kind, slot), ClaimStreak(), ClaimDaily(which),
	  Rebirth(), Emote(id), Collect() (+ burst do carretel), SetPet(kiteId).
	• Remotes S→C: State → HUD.applyState; Toast → HUD.toast (+ vibração no "Voou", marcador no "Voada");
	  ShopStock → HUD.setStock. Por fim dispara "Ready" para o servidor reenviar State/ShopStock.
	• SoundService.ListenerLocation = Character (áudio 3D segue o personagem).
	Usa só Remotes.get (WaitForChild com timeout) e Config.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local HapticService = game:GetService("HapticService")
local SoundService = game:GetService("SoundService")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local HUD = require(script.HUD)
local KiteRenderer = require(script.KiteRenderer)

local C = Config.CLIENT
local PAL = Config.PALETTE
local localPlayer = Players.LocalPlayer

-- Áudio 3D segue o personagem (propriedade nova da Audio API; pcall para builds sem ela).
pcall(function()
	(SoundService :: any).ListenerLocation = Enum.ListenerLocation.Character
end)

-- Módulos ---------------------------------------------------------------------------------------------------

local function boot(name: string, fn: () -> ())
	local ok, err = pcall(function(): string?
		fn()
		return nil
	end)
	if not ok then
		warn(`[Cliente] {name} falhou: {err}`)
	end
end

boot("HUD", HUD.start)
boot("KiteRenderer", KiteRenderer.start)

-- Remotes ---------------------------------------------------------------------------------------------------

local pullRemote = Remotes.get("Pull")
local selectRemote = Remotes.get("SelectKite")
local collectRemote = Remotes.get("Collect")
local buyRemote = Remotes.get("Buy")
local claimStreakRemote = Remotes.get("ClaimStreak")
local claimDailyRemote = Remotes.get("ClaimDaily")
local rebirthRemote = Remotes.get("Rebirth")
local emoteRemote = Remotes.get("Emote")
local setPetRemote = Remotes.get("SetPet")
local readyRemote = Remotes.get("Ready")
local stateRemote = Remotes.get("State")
local toastRemote = Remotes.get("Toast")
local shopRemote = Remotes.get("ShopStock")

-- Botão PUXAR (§2.3): "Down" ao apertar, "Up" ao soltar; nunca repete a mesma fase.
local pressed = false

local function pull(down: boolean)
	if down == pressed then
		return
	end
	pressed = down
	pullRemote:FireServer(if down then "Down" else "Up")
	HUD.setPressed(down)
end

HUD.onPull = pull

-- Espaço e Gamepad ButtonA; Pass para não roubar o pulo nem a UI; ignora com caixa de texto focada.
ContextActionService:BindAction("PegaPipaPuxar", function(_actionName: string, inputState: Enum.UserInputState, _input: InputObject): Enum.ContextActionResult?
	if inputState == Enum.UserInputState.Begin then
		if UserInputService:GetFocusedTextBox() then
			return Enum.ContextActionResult.Pass
		end
		pull(true)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		pull(false)
	end
	return Enum.ContextActionResult.Pass
end, false, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)

UserInputService.WindowFocusReleased:Connect(function()
	pull(false)
end)

-- Posição do próprio carretel (para o burst da coleta).
local function carretelPos(): Vector3?
	local laje = localPlayer:GetAttribute("Laje")
	for _, inst in CollectionService:GetTagged("Carretel") do
		if inst:IsA("BasePart") and inst:GetAttribute("LajeIndex") == laje then
			return inst.Position
		end
	end
	return nil
end

-- Callbacks do HUD → remotes (o servidor valida tudo).
HUD.onSelect = function(id: number)
	selectRemote:FireServer(id)
end
HUD.onBuy = function(kind: string, slot: number?)
	buyRemote:FireServer(kind, slot)
end
HUD.onClaim = function(which: string)
	if which == "Streak" then
		claimStreakRemote:FireServer()
	else
		claimDailyRemote:FireServer(which)
	end
end
HUD.onRebirth = function()
	rebirthRemote:FireServer()
end
HUD.onEmote = function(id: number)
	emoteRemote:FireServer(id)
end
HUD.onPet = function(id: number)
	setPetRemote:FireServer(id)
end
-- 8 Parts amarelas voam do próprio carretel para a câmera (§2.9): botão PEGAR VENTO e prompt do carretel.
local function burstAtCarretel()
	local pos = carretelPos()
	if pos then
		KiteRenderer.burst(pos + Vector3.new(0, C.LINE_ANCHOR_UP, 0), PAL.Sun, C.BURST_PARTS)
	end
end
HUD.onCollect = function()
	collectRemote:FireServer()
	burstAtCarretel()
end
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
	local part = prompt.Parent
	if prompt.Name == "PegarVento" and part and part:GetAttribute("LajeIndex") == localPlayer:GetAttribute("Laje") then
		burstAtCarretel() -- o servidor já coletou pelo Triggered do prompt
	end
end)

-- Vibração no gamepad ao perder um duelo (§2.9).
local function haptic()
	pcall(function()
		HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.LeftHand, 1)
		task.delay(C.HAPTIC_SECONDS, function()
			pcall(function()
				HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.LeftHand, 0)
			end)
		end)
	end)
end

-- S→C -------------------------------------------------------------------------------------------------------

stateRemote.OnClientEvent:Connect(function(patch: any)
	if typeof(patch) == "table" then
		HUD.applyState(patch)
	end
end)

toastRemote.OnClientEvent:Connect(function(kind: any, args: any)
	if typeof(kind) ~= "string" then
		return
	end
	local a: { [string]: any } = if typeof(args) == "table" then args else {}
	HUD.toast(kind, a)
	if kind == "Voou" then
		haptic()
	elseif kind == "Voada" and typeof(a.landPos) == "Vector3" then
		local untilTime = if typeof(a.untilTime) == "number" then a.untilTime else 0
		local rarity = if typeof(a.rarity) == "number" then a.rarity else 1
		KiteRenderer.showMarker(a.landPos, untilTime, rarity)
	end
end)

shopRemote.OnClientEvent:Connect(function(stock: any)
	if typeof(stock) == "table" then
		HUD.setStock(stock)
	end
end)

-- Personagem: ao renascer, solta o botão (o estado do HUD/render não depende do personagem).
localPlayer.CharacterAdded:Connect(function()
	pull(false)
end)

-- Tudo ligado: pede o State completo e o estoque (o load do perfil pode ter disparado antes de ouvirmos).
readyRemote:FireServer()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--!strict
--[[
	HUD — toda a interface 2D (GDD §6), mobile-first e construída em código: ScreenGui (IgnoreGuiInset,
	DeviceSafeInsets) + Frame/TextLabel/TextButton, UICorner, UIStroke 3 px, UDim2.fromScale +
	UIAspectRatioConstraint, GothamBlack/GothamBold, TextScaled com mínimo de 14 px (UITextSizeConstraint),
	sem imagens. Strings via HUD.t (Config.str no locale do jogador: "en…" → inglês, senão pt-BR).

	Elementos: botão PUXAR (0,16 da altura, ≥ 128 px; encolhe ao apertar; "SEGURA!" piscando no duelo; anel
	pulsante no onboarding), Vento com count-up e "+n/s" com pop, barra do Carretel + PEGAR VENTO (só a
	≤ COLLECT_DIST do próprio carretel), cartas do varal (toque = selecionar, toque longo = estimação),
	faixa (cinza 0-2 / laranja 3-4), escudo com contagem, 4 emotes, botões de topo (BAR só perto do balcão,
	CORREIO com badge, RENASCER, LOJA, SOM), banner de evento (atributos de workspace.World), barra de
	duelo, tela cheia (CORTOU!/VOOU!/VOCÊ PEGOU/SORTE!), toasts, painéis do Bar, Correio da Laje, Renascer,
	Loja de passes (preços via GetProductInfoAsync em pcall), popup Offline e onboarding (dica + setas 3D).
	Os callbacks on* são definidos por init.client, que fala com os remotes. Requer Config e KiteRenderer.
	Todo número vive em Config.CLIENT; toda cor em Config.PALETTE / RARITY_COLORS.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local SocialService = game:GetService("SocialService")
local LocalizationService = game:GetService("LocalizationService")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))
local KiteRenderer = require(script.Parent.KiteRenderer)

type KiteData = Config.KiteData
type Patch = { [string]: any }

local C = Config.CLIENT
local PAL = Config.PALETTE
local FONT_BLACK = Font.fromEnum(Enum.Font.GothamBlack)
local FONT_BOLD = Font.fromEnum(Enum.Font.GothamBold)
local IDS = (Config.IDS :: any) :: { [string]: number }
local DAILY = (Config.DAILY :: any) :: { [string]: { goal: number, reward: number } }

local localPlayer = Players.LocalPlayer
local locale = LocalizationService.RobloxLocaleId
local isEn = string.sub(locale, 1, 2) == "en"

local HUD = {}

-- Callbacks definidos por init.client (falam com os remotes).
HUD.onPull = nil :: ((down: boolean) -> ())?
HUD.onSelect = nil :: ((id: number) -> ())?
HUD.onBuy = nil :: ((kind: string, slot: number?) -> ())?
HUD.onClaim = nil :: ((which: string) -> ())? -- "Streak" | "Cortes" | "Pegas"
HUD.onRebirth = nil :: (() -> ())?
HUD.onEmote = nil :: ((id: number) -> ())?
HUD.onCollect = nil :: (() -> ())? -- botão PEGAR VENTO → Collect
HUD.onPet = nil :: ((id: number) -> ())? -- toque longo na carta → SetPet

-- Referências da UI (criadas de uma vez em build()).
type UI = {
	gui: ScreenGui,
	root: Frame,
	vento: TextLabel,
	rate: TextLabel,
	rateScale: UIScale,
	carretelFill: Frame,
	carretelText: TextLabel,
	collectBtn: TextButton,
	banner: TextLabel,
	toasts: Frame,
	cards: Frame,
	pullBtn: TextButton,
	pullText: TextLabel,
	pullScale: UIScale,
	pullRing: Frame,
	pullRingStroke: UIStroke,
	faixa: TextLabel,
	shield: TextLabel,
	hint: TextLabel,
	btnBar: TextButton,
	btnMail: TextButton,
	mailBadge: Frame,
	btnRebirth: TextButton,
	btnShop: TextButton,
	btnSound: TextButton,
	duel: Frame,
	duelNames: TextLabel,
	duelHold: TextLabel,
	duelFill: Frame,
	flash: TextLabel,
	flashScale: UIScale,
	dim: Frame,
	barPanel: Frame,
	barClock: TextLabel,
	barSlots: Frame,
	barLinha: TextButton,
	barVaga: TextButton,
	mailPanel: Frame,
	mailDays: Frame,
	mailStreakBtn: TextButton,
	mailCuts: TextLabel,
	mailCutsBtn: TextButton,
	mailCatch: TextLabel,
	mailCatchBtn: TextButton,
	rebirthPanel: Frame,
	rebirthTitle: TextLabel,
	rebirthNeed: TextLabel,
	rebirthEpic: TextLabel,
	rebirthBtn: TextButton,
	shopPanel: Frame,
	shopList: Frame,
	offlinePanel: Frame,
	offlineText: TextLabel,
}

local ui: UI? = nil

-- Estado espelhado do State (§7.3) + estado local do HUD.
local S = {
	Vento = 0,
	shownVento = -1, -- count-up
	Carretel = 0,
	CarretelCap = 0,
	Rate = 0,
	Linha = 1,
	Vagas = Config.VAGAS_START,
	Temporadas = 0,
	Kites = {} :: { KiteData },
	Selected = 0,
	Streak = { Day = 0, LastClaimDay = 0, SaverWeek = 0 },
	Dailies = { Day = 0, Cortes = 0, Pegas = 0, ClaimedCortes = false, ClaimedPegas = false },
	Novato = false,
	NovatoUntil = 0,
	Onboarding = 0,
	faixa = 0,
	ownStatus = "",
	lastLandPos = nil :: Vector3?,
	lastLandUntil = 0,
	duelActive = false,
	duelEndsAt = 0,
	duelLinha = 0,
	stock = nil :: Patch?,
	nearCarretel = false,
	nearBar = false,
	soundOn = true,
	panel = "",
	onbStep = -1,
	onbKey = "",
	arrowRemove = nil :: (() -> ())?,
	flashSeq = 0,
	toastSeq = 0,
	prices = {} :: { [string]: string },
	pricesAt = 0,
	pressedByButton = false,
}

-- Strings e formatação ---------------------------------------------------------------------------------

function HUD.t(key: string, vars: { [string]: any }?): string
	return Config.str(key, locale, vars)
end

local t = HUD.t

-- "1.240" / "12,4 K" / "1,2 M" (en: "1,240" / "12.4 K").
local function fmtNumber(n: number): string
	local dec = if isEn then "." else ","
	local grp = if isEn then "," else "."
	local abs = math.abs(n)
	local sign = if n < 0 then "-" else ""
	local function short(v: number, suffix: string): string
		local s = string.format("%.1f", v)
		s = string.gsub(s, "%.0$", "")
		s = string.gsub(s, "%.", dec)
		return sign .. s .. " " .. suffix
	end
	if abs >= 1e9 then
		return short(abs / 1e9, "B")
	elseif abs >= 1e6 then
		return short(abs / 1e6, "M")
	elseif abs >= 1e4 then
		return short(abs / 1e3, "K")
	end
	local digits = tostring(math.floor(abs + 0.5))
	local out = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1" .. grp)))
	if string.sub(out, 1, 1) == grp then
		out = string.sub(out, 2)
	end
	return sign .. out
end

-- "0,25" / "1,6" / "37,5" (en: "0.25"): até 2 casas, sem zeros à direita — V/s e multiplicadores de faixa.
local function fmtDecimal(n: number): string
	if math.abs(n) >= 1e4 then
		return fmtNumber(n)
	end
	local s = string.format("%.2f", n)
	s = string.gsub(s, "0+$", "")
	s = string.gsub(s, "%.$", "")
	return (string.gsub(s, "%.", if isEn then "." else ","))
end

-- "m:ss"
local function fmtClock(seconds: number): string
	local s = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", s // 60, s % 60)
end

-- "3 h 12" / "12 min"
local function fmtLong(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s >= 3600 then
		return t("hours", { h = s // 3600, m = string.format("%02d", (s % 3600) // 60) })
	end
	return t("minutes", { m = s // 60 })
end

local function kiteName(model: string, season: number?): string
	return t("kite_" .. model, { n = season or 0 })
end

local function rarityName(rarity: number): string
	return t("rarity" .. rarity)
end

local function kiteColor(k: KiteData): Color3
	if k.golden then
		return Config.RARITY_COLORS[5]
	end
	if k.color >= Config.SEASON_COLOR_BASE then
		return Color3.fromHSV(((k.color - Config.SEASON_COLOR_BASE) * Config.SEASON_HUE.step) % 1, Config.SEASON_HUE.sat, Config.SEASON_HUE.val)
	end
	return Config.COLORS[k.color] or Config.COLORS[0]
end

local function today(): number
	return os.time() // Config.DAY_SECONDS
end

-- Semana desde segunda 00:00 UTC (a mesma fórmula do servidor): Guardar Streak vale por semana.
local function weekIndex(): number
	return (os.time() - Config.WEEK_EPOCH_OFFSET) // Config.WEEK_SECONDS
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function num(v: any, default: number): number
	return if typeof(v) == "number" then v else default
end

local function attrNumber(inst: Instance, name: string, default: number): number
	return num(inst:GetAttribute(name), default)
end

local function attrString(inst: Instance, name: string, default: string): string
	local v = inst:GetAttribute(name)
	return if typeof(v) == "string" then v else default
end

local function rootPart(): BasePart?
	local character = localPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Posição do próprio carretel (Part com tag Carretel e LajeIndex == atributo Laje do jogador).
local function carretelPos(): Vector3?
	local laje = attrNumber(localPlayer, "Laje", 0)
	if laje == 0 then
		return nil
	end
	for _, inst in CollectionService:GetTagged("Carretel") do
		if inst:IsA("BasePart") and attrNumber(inst, "LajeIndex", 0) == laje then
			return inst.Position
		end
	end
	return nil
end

-- Configuration da própria pipa no ar (Owner == UserId), se houver.
local function ownConf(): Instance?
	for _, inst in CollectionService:GetTagged("Kite") do
		if attrNumber(inst, "Owner", 0) == localPlayer.UserId then
			return inst
		end
	end
	return nil
end

local function isPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

-- Construtores de UI -----------------------------------------------------------------------------------

local function apply(inst: Instance, props: { [string]: any })
	for k, v in props do
		(inst :: any)[k] = v
	end
end

local function textMin(inst: Instance)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = C.MIN_TEXT_PX
	constraint.Parent = inst
end

local function corner(inst: Instance, radius: UDim?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or UDim.new(0.2, 0)
	c.Parent = inst
	return c
end

local function stroke(inst: Instance, color: Color3?, px: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Thickness = px or C.STROKE_PX
	s.Color = color or PAL.Outline
	s.Parent = inst
	return s
end

local function aspect(inst: Instance, ratio: number)
	local a = Instance.new("UIAspectRatioConstraint")
	a.AspectRatio = ratio
	a.Parent = inst
end

local function frame(name: string, props: { [string]: any }, parent: Instance?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundColor3 = PAL.UIBg
	apply(f, props)
	f.Parent = parent
	return f
end

local function label(name: string, text: string, props: { [string]: any }, parent: Instance?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = UDim2.fromScale(1, 1)
	l.FontFace = FONT_BOLD
	l.TextColor3 = PAL.UIText
	l.TextScaled = true
	l.Text = text
	apply(l, props)
	textMin(l)
	l.Parent = parent
	return l
end

local function button(name: string, text: string, props: { [string]: any }, parent: Instance?): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.BackgroundColor3 = PAL.Laje
	b.FontFace = FONT_BLACK
	b.TextColor3 = PAL.UIText
	b.TextScaled = true
	b.Text = text
	apply(b, props)
	textMin(b)
	b.Parent = parent
	return b
end

-- Botão "cartão": fundo colorido, canto (radius, padrão 20 %), contorno 3 px.
local function pillButton(name: string, text: string, color: Color3, props: { [string]: any }, parent: Instance?, radius: UDim?): TextButton
	local b = button(name, text, props, parent)
	b.BackgroundColor3 = color
	corner(b, radius)
	stroke(b)
	return b
end

local function setEnabled(b: TextButton, enabled: boolean)
	b.Active = enabled
	b.AutoButtonColor = enabled
	b.BackgroundTransparency = if enabled then 0 else 0.5
	b.TextTransparency = if enabled then 0 else 0.4
end

local function list(parent: Instance, direction: Enum.FillDirection, padding: number, align: Enum.HorizontalAlignment?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(padding, 0)
	l.HorizontalAlignment = align or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.Parent = parent
	return l
end

local function clearChildren(parent: Instance, className: string)
	for _, child in parent:GetChildren() do
		if child:IsA(className) then
			child:Destroy()
		end
	end
end

-- Painel modal: Frame com título e botão X; devolve (painel, conteúdo).
local function panel(name: string, size: UDim2, anchor: Vector2, pos: UDim2, title: string, parent: Instance, onClose: () -> ()): (Frame, Frame)
	local p = frame(name, { Size = size, AnchorPoint = anchor, Position = pos, Visible = false }, parent)
	corner(p)
	stroke(p, PAL.Sun)
	local scale = Instance.new("UIScale")
	scale.Name = "Escala"
	scale.Parent = p
	label("Titulo", title, { Size = UDim2.fromScale(0.8, 0.12), Position = UDim2.fromScale(0.03, 0.02), FontFace = FONT_BLACK, TextXAlignment = Enum.TextXAlignment.Left }, p)
	local close = pillButton("Fechar", "X", PAL.Red, { Size = UDim2.fromScale(0, 0.1), Position = UDim2.fromScale(0.97, 0.03), AnchorPoint = Vector2.new(1, 0) }, p)
	aspect(close, 1)
	close.Activated:Connect(onClose)
	local content = frame("Conteudo", { Size = UDim2.fromScale(0.94, 0.82), Position = UDim2.fromScale(0.03, 0.16), BackgroundTransparency = 1 }, p)
	return p, content
end

-- Construção ---------------------------------------------------------------------------------------------

local function build(): UI
	local gui = Instance.new("ScreenGui")
	gui.Name = "PegaPipaHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10

	local root = frame("Root", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)

	-- Topo centro: Vento, V/s, Carretel, PEGAR VENTO, banner, toasts
	local vento = label("Vento", "0 " .. t("wind"), { Size = UDim2.fromScale(0.34, 0.06), Position = UDim2.fromScale(0.5, 0.015), AnchorPoint = Vector2.new(0.5, 0), FontFace = FONT_BLACK }, root)
	stroke(vento, PAL.Outline, 2)
	local rate = label("Rate", t("perSec", { n = "0" }), { Size = UDim2.fromScale(0.2, 0.035), Position = UDim2.fromScale(0.5, 0.078), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = PAL.Sun }, root)
	stroke(rate, PAL.Outline, 2)
	local rateScale = Instance.new("UIScale")
	rateScale.Parent = rate

	local carretel = frame("Carretel", { Size = UDim2.fromScale(0.28, 0.035), Position = UDim2.fromScale(0.5, 0.118), AnchorPoint = Vector2.new(0.5, 0) }, root)
	corner(carretel, UDim.new(0.5, 0))
	stroke(carretel)
	local carretelFill = frame("Cheio", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = PAL.Laje }, carretel)
	corner(carretelFill, UDim.new(0.5, 0))
	local carretelText = label("Texto", "", { ZIndex = 2 }, carretel)
	stroke(carretelText, PAL.Outline, 2)

	local collectBtn = pillButton("PegarVento", t("collect"), PAL.Sun, { Size = UDim2.fromScale(0.2, 0.05), Position = UDim2.fromScale(0.5, 0.16), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = PAL.Outline, Visible = false }, root)

	local banner = label("Banner", "", { Size = UDim2.fromScale(0.38, 0.045), Position = UDim2.fromScale(0.5, 0.215), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 0, BackgroundColor3 = PAL.Red, FontFace = FONT_BLACK, Visible = false }, root)
	corner(banner)
	stroke(banner)

	local toasts = frame("Toasts", { Size = UDim2.fromScale(0.5, 0.2), Position = UDim2.fromScale(0.5, 0.27), AnchorPoint = Vector2.new(0.5, 0), BackgroundTransparency = 1 }, root)
	list(toasts, Enum.FillDirection.Vertical, 0.02)

	-- Coluna esquerda: cartas do varal
	local cards = frame("Cartas", { Size = UDim2.fromScale(0.105, 0.64), Position = UDim2.fromScale(0.012, 0.12), BackgroundTransparency = 1 }, root)
	local cardsList = list(cards, Enum.FillDirection.Vertical, 0.008)
	cardsList.VerticalAlignment = Enum.VerticalAlignment.Top

	-- Direita: PUXAR (tamanho em px calculado por fitButton: 0,16 da altura, nunca < BUTTON_MIN_PX), faixa, escudo, dica
	local pullRing = frame("Anel", { Position = UDim2.fromScale(0.985, 0.975), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 0 }, root)
	corner(pullRing, UDim.new(0.5, 0))
	local pullRingStroke = stroke(pullRing, PAL.Sun, C.STROKE_PX + 1)

	local pullBtn = button("Puxar", "", { Position = UDim2.fromScale(0.985, 0.975), AnchorPoint = Vector2.new(1, 1), AutoButtonColor = false, ZIndex = 1 }, root)
	corner(pullBtn, UDim.new(0.5, 0))
	stroke(pullBtn, PAL.Outline, C.STROKE_PX + 1)
	local pullScale = Instance.new("UIScale")
	pullScale.Parent = pullBtn
	local pullText = label("Texto", t("pull"), { Size = UDim2.fromScale(0.8, 0.4), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), FontFace = FONT_BLACK }, pullBtn)
	stroke(pullText, PAL.Outline, 2)

	local faixa = label("Faixa", "", { Size = UDim2.fromScale(0.24, 0.045), Position = UDim2.fromScale(0.985, 0.79), AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 0, FontFace = FONT_BLACK }, root)
	corner(faixa)
	stroke(faixa)
	local shield = label("Escudo", "", { Size = UDim2.fromScale(0.24, 0.04), Position = UDim2.fromScale(0.985, 0.74), AnchorPoint = Vector2.new(1, 1), TextColor3 = PAL.Sky, Visible = false }, root)
	stroke(shield, PAL.Outline, 2)
	local hint = label("Dica", "", { Size = UDim2.fromScale(0.32, 0.05), Position = UDim2.fromScale(0.985, 0.695), AnchorPoint = Vector2.new(1, 1), TextColor3 = PAL.Sun, FontFace = FONT_BLACK, Visible = false }, root)
	stroke(hint, PAL.Outline, 2)

	-- Topo direito: BAR, CORREIO, RENASCER, LOJA, SOM
	local topBtns = frame("TopoDireito", { Size = UDim2.fromScale(0.42, 0.07), Position = UDim2.fromScale(0.985, 0.015), AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1 }, root)
	list(topBtns, Enum.FillDirection.Horizontal, 0.012, Enum.HorizontalAlignment.Right)
	local function topButton(name: string, text: string, color: Color3, order: number): TextButton
		local b = pillButton(name, text, color, { Size = UDim2.fromScale(0, 1), LayoutOrder = order }, topBtns)
		aspect(b, 1)
		return b
	end
	local btnBar = topButton("Bar", t("btnBar"), PAL.Red, 1)
	btnBar.Visible = false
	local btnMail = topButton("Correio", t("btnMail"), PAL.Sky, 2)
	local mailBadge = frame("Badge", { Size = UDim2.fromScale(0.3, 0.3), Position = UDim2.fromScale(0.95, 0.05), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = PAL.Red, Visible = false, ZIndex = 3 }, btnMail)
	corner(mailBadge, UDim.new(0.5, 0))
	stroke(mailBadge, PAL.Outline, 2)
	local btnRebirth = topButton("Renascer", t("btnRebirth"), PAL.Lilac, 3)
	local btnShop = topButton("Loja", t("btnShop"), PAL.Hill, 4)
	local btnSound = topButton("Som", t("btnSound"), PAL.Asphalt, 5)

	-- Canto inferior esquerdo: 4 emotes
	local emotes = frame("Emotes", { Size = UDim2.fromScale(0.34, 0.07), Position = UDim2.fromScale(0.012, 0.975), AnchorPoint = Vector2.new(0, 1), BackgroundTransparency = 1 }, root)
	list(emotes, Enum.FillDirection.Horizontal, 0.012, Enum.HorizontalAlignment.Left)
	for i = 1, 4 do
		local b = pillButton(`Emote{i}`, t(`emote{i}`), if i % 2 == 1 then PAL.Pink else PAL.Lilac, { Size = UDim2.fromScale(0, 1), LayoutOrder = i }, emotes, UDim.new(0.5, 0))
		aspect(b, 1)
		b.Activated:Connect(function()
			local cb = HUD.onEmote
			if cb then
				cb(i)
			end
		end)
	end

	-- Centro: barra de duelo e tela cheia
	local duel = frame("Duelo", { Size = UDim2.fromScale(0.5, 0.07), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false }, root)
	corner(duel)
	stroke(duel, PAL.Sun)
	local duelNames = label("Nomes", "", { Size = UDim2.fromScale(0.96, 0.4), Position = UDim2.fromScale(0.02, 0.04) }, duel)
	local duelHold = label("Segura", t("hold"), { Size = UDim2.fromScale(0.96, 0.4), Position = UDim2.fromScale(0.02, 0.4), TextColor3 = PAL.Sun, FontFace = FONT_BLACK }, duel)
	local duelTrack = frame("Trilho", { Size = UDim2.fromScale(0.96, 0.14), Position = UDim2.fromScale(0.02, 0.82), BackgroundColor3 = PAL.Asphalt }, duel)
	corner(duelTrack, UDim.new(0.5, 0))
	local duelFill = frame("Cheio", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = PAL.Sun }, duelTrack)
	corner(duelFill, UDim.new(0.5, 0))

	local flash = label("TelaCheia", "", { Size = UDim2.fromScale(0.8, 0.14), Position = UDim2.fromScale(0.5, 0.33), AnchorPoint = Vector2.new(0.5, 0.5), FontFace = FONT_BLACK, Visible = false, ZIndex = 5 }, root)
	stroke(flash, PAL.Outline, C.STROKE_PX)
	local flashScale = Instance.new("UIScale")
	flashScale.Parent = flash

	-- Painéis (sobre um escurecimento)
	local dim = frame("Escuro", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = PAL.Outline, BackgroundTransparency = 0.4, Visible = false, ZIndex = 10 }, root)
	local function closeAll()
		S.panel = ""
		dim.Visible = false
	end

	local barPanel, barContent = panel("Bar", UDim2.fromScale(0.74, 0.6), Vector2.new(0.5, 1), UDim2.fromScale(0.5, 1), t("bar"), dim, closeAll)
	local barClock = label("Relogio", "", { Size = UDim2.fromScale(0.4, 0.1), Position = UDim2.fromScale(0.5, 0.02), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = PAL.Sun }, barPanel)
	local barSlots = frame("Slots", { Size = UDim2.fromScale(1, 0.62), BackgroundTransparency = 1 }, barContent)
	list(barSlots, Enum.FillDirection.Horizontal, 0.012)
	local barBottom = frame("Fixos", { Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.68), BackgroundTransparency = 1 }, barContent)
	list(barBottom, Enum.FillDirection.Horizontal, 0.02)
	local barLinha = pillButton("Linha", "", PAL.Sky, { Size = UDim2.fromScale(0.46, 0.9), LayoutOrder = 1 }, barBottom)
	local barVaga = pillButton("Vaga", "", PAL.Hill, { Size = UDim2.fromScale(0.46, 0.9), LayoutOrder = 2 }, barBottom)

	local mailPanel, mailContent = panel("Correio", UDim2.fromScale(0.7, 0.6), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), t("mail"), dim, closeAll)
	local mailDays = frame("Dias", { Size = UDim2.fromScale(1, 0.42), BackgroundTransparency = 1 }, mailContent)
	list(mailDays, Enum.FillDirection.Horizontal, 0.01)
	local mailStreakBtn = pillButton("ResgatarStreak", t("claim"), PAL.Sun, { Size = UDim2.fromScale(0.3, 0.14), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = PAL.Outline }, mailContent)
	local mailCuts = label("Cortes", "", { Size = UDim2.fromScale(0.62, 0.14), Position = UDim2.fromScale(0, 0.66), TextXAlignment = Enum.TextXAlignment.Left }, mailContent)
	local mailCutsBtn = pillButton("ResgatarCortes", t("claim"), PAL.Sun, { Size = UDim2.fromScale(0.3, 0.14), Position = UDim2.fromScale(1, 0.66), AnchorPoint = Vector2.new(1, 0), TextColor3 = PAL.Outline }, mailContent)
	local mailCatch = label("Pegas", "", { Size = UDim2.fromScale(0.62, 0.14), Position = UDim2.fromScale(0, 0.84), TextXAlignment = Enum.TextXAlignment.Left }, mailContent)
	local mailCatchBtn = pillButton("ResgatarPegas", t("claim"), PAL.Sun, { Size = UDim2.fromScale(0.3, 0.14), Position = UDim2.fromScale(1, 0.84), AnchorPoint = Vector2.new(1, 0), TextColor3 = PAL.Outline }, mailContent)

	local rebirthPanel, rebirthContent = panel("Renascer", UDim2.fromScale(0.6, 0.42), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), "", dim, closeAll)
	local rebirthTitle = rebirthPanel:FindFirstChild("Titulo") :: TextLabel
	local rebirthNeed = label("Custo", "", { Size = UDim2.fromScale(1, 0.18), Position = UDim2.fromScale(0, 0), TextColor3 = PAL.Sun }, rebirthContent)
	local rebirthEpic = label("Epica", "", { Size = UDim2.fromScale(1, 0.16), Position = UDim2.fromScale(0, 0.2) }, rebirthContent)
	label("Bonus", t("rebirthBonus"), { Size = UDim2.fromScale(1, 0.16), Position = UDim2.fromScale(0, 0.38), TextColor3 = PAL.Green }, rebirthContent)
	label("Fica", t("rebirthKeep"), { Size = UDim2.fromScale(1, 0.14), Position = UDim2.fromScale(0, 0.56), TextColor3 = PAL.Gray }, rebirthContent)
	local rebirthBtn = pillButton("Confirmar", t("confirm"), PAL.Lilac, { Size = UDim2.fromScale(0.4, 0.22), Position = UDim2.fromScale(0.5, 0.76), AnchorPoint = Vector2.new(0.5, 0) }, rebirthContent)

	local shopPanel, shopContent = panel("Loja", UDim2.fromScale(0.62, 0.78), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), t("btnShop"), dim, closeAll)
	local shopList = frame("Lista", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, shopContent)
	local shopLayout = list(shopList, Enum.FillDirection.Vertical, 0.012)
	shopLayout.VerticalAlignment = Enum.VerticalAlignment.Top

	local offlinePanel, offlineContent = panel("Offline", UDim2.fromScale(0.6, 0.36), Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), t("offlineTitle"), dim, closeAll)
	local offlineText = label("Texto", "", { Size = UDim2.fromScale(1, 0.5), Position = UDim2.fromScale(0, 0.02), TextWrapped = true }, offlineContent)
	local offlineBtn = pillButton("Receber", t("receive"), PAL.Sun, { Size = UDim2.fromScale(0.4, 0.3), Position = UDim2.fromScale(0.5, 0.65), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = PAL.Outline }, offlineContent)
	offlineBtn.Activated:Connect(closeAll)

	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	return {
		gui = gui, root = root,
		vento = vento, rate = rate, rateScale = rateScale,
		carretelFill = carretelFill, carretelText = carretelText, collectBtn = collectBtn,
		banner = banner, toasts = toasts, cards = cards,
		pullBtn = pullBtn, pullText = pullText, pullScale = pullScale, pullRing = pullRing, pullRingStroke = pullRingStroke,
		faixa = faixa, shield = shield, hint = hint,
		btnBar = btnBar, btnMail = btnMail, mailBadge = mailBadge, btnRebirth = btnRebirth, btnShop = btnShop, btnSound = btnSound,
		duel = duel, duelNames = duelNames, duelHold = duelHold, duelFill = duelFill,
		flash = flash, flashScale = flashScale, dim = dim,
		barPanel = barPanel, barClock = barClock, barSlots = barSlots, barLinha = barLinha, barVaga = barVaga,
		mailPanel = mailPanel, mailDays = mailDays, mailStreakBtn = mailStreakBtn,
		mailCuts = mailCuts, mailCutsBtn = mailCutsBtn, mailCatch = mailCatch, mailCatchBtn = mailCatchBtn,
		rebirthPanel = rebirthPanel, rebirthTitle = rebirthTitle, rebirthNeed = rebirthNeed, rebirthEpic = rebirthEpic, rebirthBtn = rebirthBtn,
		shopPanel = shopPanel, shopList = shopList,
		offlinePanel = offlinePanel, offlineText = offlineText,
	}
end

-- Efeitos de UI --------------------------------------------------------------------------------------------

local function pop(scale: UIScale)
	scale.Scale = C.POP_SCALE
	TweenService:Create(scale, TweenInfo.new(C.POP_SECONDS, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Texto em tela cheia por FULLSCREEN_SECONDS (escala FULLSCREEN_FROM → 1, Back/Out).
local function flash(u: UI, text: string, color: Color3)
	u.flash.Text = text
	u.flash.TextColor3 = color
	u.flash.Visible = true
	u.flashScale.Scale = C.FULLSCREEN_FROM
	TweenService:Create(u.flashScale, TweenInfo.new(C.POP_SECONDS, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	S.flashSeq += 1
	local seq = S.flashSeq
	task.delay(C.FULLSCREEN_SECONDS, function()
		if S.flashSeq == seq then
			u.flash.Visible = false
		end
	end)
end

-- Toast pequeno na pilha do topo (some em TOAST_SECONDS; no máximo TOAST_MAX).
local function toastText(u: UI, text: string, color: Color3?)
	local l = label("Toast", text, { Size = UDim2.fromScale(1, 1 / C.TOAST_MAX), TextColor3 = color or PAL.UIText, FontFace = FONT_BLACK, LayoutOrder = S.toastSeq }, u.toasts)
	stroke(l, PAL.Outline, 2)
	S.toastSeq += 1
	local labels: { TextLabel } = {}
	for _, child in u.toasts:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(labels, child)
		end
	end
	table.sort(labels, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #labels - C.TOAST_MAX do
		labels[i]:Destroy()
	end
	task.delay(C.TOAST_SECONDS, function()
		l:Destroy()
	end)
end

-- Painéis ---------------------------------------------------------------------------------------------------

local function panelOf(u: UI, name: string): Frame?
	if name == "bar" then
		return u.barPanel
	elseif name == "mail" then
		return u.mailPanel
	elseif name == "rebirth" then
		return u.rebirthPanel
	elseif name == "shop" then
		return u.shopPanel
	elseif name == "offline" then
		return u.offlinePanel
	end
	return nil
end

local function closePanels(u: UI)
	S.panel = ""
	u.dim.Visible = false
end

local refreshBar, refreshMail, refreshRebirth, refreshShop -- definidas abaixo

local function openPanel(u: UI, name: string)
	if S.panel == name then
		closePanels(u)
		return
	end
	for _, other in { "bar", "mail", "rebirth", "shop", "offline" } do
		local p = panelOf(u, other)
		if p then
			p.Visible = other == name
		end
	end
	S.panel = name
	u.dim.Visible = true
	local p = panelOf(u, name)
	if p then
		local scale = p:FindFirstChild("Escala")
		if scale and scale:IsA("UIScale") then
			scale.Scale = 0.9
			TweenService:Create(scale, TweenInfo.new(C.PANEL_TWEEN, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	end
	if name == "bar" then
		refreshBar(u)
	elseif name == "mail" then
		refreshMail(u)
	elseif name == "rebirth" then
		refreshRebirth(u)
	elseif name == "shop" then
		refreshShop(u)
	end
end

-- Bar do Vento (§5.2): 5 cartas + Linha + Vaga + relógio.
local function refreshBarClock(u: UI)
	local stock = S.stock
	local restockAt = if stock then num(stock.restockAt, 0) else 0
	u.barClock.Text = t("restock", { time = fmtClock(restockAt - os.time()) })
end

refreshBar = function(u: UI)
	clearChildren(u.barSlots, "Frame")
	local stock = S.stock
	local slots: { Patch } = if stock and typeof(stock.slots) == "table" then stock.slots else {}
	if #slots == 0 then
		label("Vazio", t("stockEmpty"), { TextColor3 = PAL.Gray }, u.barSlots)
	end
	for i, slot in slots do
		local rarity = num(slot.rarity, 1)
		local price = num(slot.price, 0)
		local bought = slot.bought == true
		local rc = Config.RARITY_COLORS[rarity] or PAL.Gray
		local card = frame(`Slot{i}`, { Size = UDim2.fromScale(0.19, 1), LayoutOrder = i, BackgroundColor3 = PAL.Outline }, u.barSlots)
		corner(card)
		stroke(card, rc)
		local model = if typeof(slot.model) == "string" then slot.model else "Lisa"
		label("Nome", kiteName(model, nil), { Size = UDim2.fromScale(0.9, 0.22), Position = UDim2.fromScale(0.05, 0.04), FontFace = FONT_BLACK }, card)
		label("Raridade", rarityName(rarity), { Size = UDim2.fromScale(0.9, 0.14), Position = UDim2.fromScale(0.05, 0.28), TextColor3 = rc }, card)
		label("Preco", t("vento", { n = fmtNumber(price) }), { Size = UDim2.fromScale(0.9, 0.16), Position = UDim2.fromScale(0.05, 0.44), TextColor3 = PAL.Sun }, card)
		if slot.special == true then
			label("Especial", t("special"), { Size = UDim2.fromScale(0.9, 0.12), Position = UDim2.fromScale(0.05, 0.6), TextColor3 = PAL.Pink, FontFace = FONT_BLACK }, card)
		end
		local b = pillButton("Comprar", if bought then t("bought") else t("buy"), PAL.Laje, { Size = UDim2.fromScale(0.9, 0.2), Position = UDim2.fromScale(0.05, 0.76) }, card)
		setEnabled(b, not bought and S.Vento >= price)
		b.Activated:Connect(function()
			local cb = HUD.onBuy
			if cb and not bought then
				cb("Kite", i)
			end
		end)
	end
	-- Linha (próximo nível) e vaga (próxima)
	local nextLinha = S.Linha + 1
	if nextLinha > Config.LINHA_MAX then
		u.barLinha.Text = t("linhaMax")
		setEnabled(u.barLinha, false)
	else
		local price = Config.linhaPrice(nextLinha)
		u.barLinha.Text = `{t("line", { n = nextLinha, name = Config.LINHA_NAMES[nextLinha] })}\n{t("vento", { n = fmtNumber(price) })}`
		setEnabled(u.barLinha, S.Vento >= price)
	end
	local nextVaga = S.Vagas + 1
	local vagaPrice = Config.VAGA_PRICE[nextVaga]
	if nextVaga > Config.VAGAS_MAX or not vagaPrice then
		u.barVaga.Text = t("vagaMax")
		setEnabled(u.barVaga, false)
	else
		u.barVaga.Text = `{t("slot", { n = nextVaga })}\n{t("vento", { n = fmtNumber(vagaPrice) })}`
		setEnabled(u.barVaga, S.Vento >= vagaPrice)
	end
	refreshBarClock(u)
end

-- Correio da Laje (§5.4): fila D1-D7 do ciclo atual + 2 dailies.
local function streakClaimable(): boolean -- o servidor decide o resto (reset após 2 dias, trava no D28)
	return today() > num(S.Streak.LastClaimDay, 0)
end

local function dailyProgress(which: string): (number, boolean)
	if num(S.Dailies.Day, 0) ~= today() then
		return 0, false
	end
	local progress = num((S.Dailies :: any)[which], 0)
	local claimed = (S.Dailies :: any)["Claimed" .. which] == true
	return progress, claimed
end

local function dailyClaimable(which: string): boolean
	local progress, claimed = dailyProgress(which)
	return progress >= DAILY[which].goal and not claimed
end

local function refreshBadge(u: UI)
	u.mailBadge.Visible = streakClaimable() or dailyClaimable("Cortes") or dailyClaimable("Pegas")
end

refreshMail = function(u: UI)
	clearChildren(u.mailDays, "Frame")
	local day = num(S.Streak.Day, 0)
	local lastClaim = num(S.Streak.LastClaimDay, 0)
	local saved = num(S.Streak.SaverWeek, 0) == weekIndex() -- Guardar Streak usado nesta semana
	local broke = lastClaim == 0 or (today() - lastClaim >= 2 and not saved)
	local nextDay = if broke then 1 else math.min(day + 1, Config.STREAK_CAP_DAY)
	local cycleStart = ((nextDay - 1) // #Config.STREAK) * #Config.STREAK
	local mult = if cycleStart > 0 then 2 else 1
	for i, amount in Config.STREAK do
		local d = cycleStart + i
		local isNext = d == nextDay
		local done = d < nextDay
		local tile = frame(`Dia{i}`, { Size = UDim2.fromScale(0.135, 1), LayoutOrder = i, BackgroundColor3 = if isNext then PAL.Laje else PAL.Outline, BackgroundTransparency = if done then 0.5 else 0 }, u.mailDays)
		corner(tile)
		stroke(tile, if isNext then PAL.Sun else PAL.Outline)
		label("Dia", t("day", { n = d }), { Size = UDim2.fromScale(0.9, 0.3), Position = UDim2.fromScale(0.05, 0.05), FontFace = FONT_BLACK }, tile)
		label("Valor", fmtNumber(amount * mult), { Size = UDim2.fromScale(0.9, 0.3), Position = UDim2.fromScale(0.05, 0.38), TextColor3 = PAL.Sun }, tile)
		local kite = Config.STREAK_KITE[i]
		if kite then
			label("Pipa", "+ " .. kiteName(kite.model, nil), { Size = UDim2.fromScale(0.9, 0.25), Position = UDim2.fromScale(0.05, 0.7), TextColor3 = Config.RARITY_COLORS[kite.rarity] or PAL.Gray }, tile)
		end
	end
	setEnabled(u.mailStreakBtn, streakClaimable())
	local cuts, cutsClaimed = dailyProgress("Cortes")
	u.mailCuts.Text = t("dailyCuts", { n = cuts })
	u.mailCutsBtn.Text = if cutsClaimed then t("claimed") else t("claim")
	setEnabled(u.mailCutsBtn, dailyClaimable("Cortes"))
	local catches, catchClaimed = dailyProgress("Pegas")
	u.mailCatch.Text = t("dailyCatch", { n = catches })
	u.mailCatchBtn.Text = if catchClaimed then t("claimed") else t("claim")
	setEnabled(u.mailCatchBtn, dailyClaimable("Pegas"))
	refreshBadge(u)
end

-- Renascer (§3.6): custo, Épica no varal, bônus, CONFIRMAR.
local function rebirthCost(): number
	return Config.REBIRTH_BASE * Config.REBIRTH_GROWTH ^ S.Temporadas
end

-- Mesma regra do ShopService.findEpic: Épica ou melhor que não seja a Jornal nem uma Pipa de Temporada.
local function hasEpic(): boolean
	for _, k in S.Kites do
		if k.rarity >= Config.REBIRTH_NEED_RARITY and not k.starter and k.season == 0 then
			return true
		end
	end
	return false
end

refreshRebirth = function(u: UI)
	local maxed = S.Temporadas >= Config.REBIRTH_MAX
	u.rebirthTitle.Text = if maxed then t("rebirthMax") else t("rebirth", { n = S.Temporadas + 1 })
	u.rebirthNeed.Text = t("rebirthNeed", { vento = fmtNumber(rebirthCost()) })
	local epic = hasEpic()
	u.rebirthEpic.Text = if epic then t("epicOk") else t("epicNo")
	u.rebirthEpic.TextColor3 = if epic then PAL.Green else PAL.Red
	setEnabled(u.rebirthBtn, not maxed and epic and S.Vento >= rebirthCost())
end

-- Loja de passes (§5.7): 4 passes + 4 produtos (preço via GetProductInfoAsync em pcall) + Chamar amigo.
local function fetchPrice(key: string, id: number, isPass: boolean, target: TextLabel)
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(id, if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product)
		end)
		local price = if ok and typeof(info) == "table" then num(info.PriceInRobux, 0) else 0
		local text = if price > 0 then t("robux", { n = price }) else t("soon")
		S.prices[key] = text
		if target.Parent then
			target.Text = text
		end
	end)
end

local function shopRow(u: UI, key: string, isPass: boolean, order: number)
	local id = IDS[key] or 0
	local row = frame(key, { Size = UDim2.fromScale(1, 0.085), LayoutOrder = order, BackgroundColor3 = PAL.Outline }, u.shopList)
	corner(row)
	stroke(row, if isPass then PAL.Sun else PAL.Sky, 2)
	label("Nome", t("item_" .. key), { Size = UDim2.fromScale(0.52, 0.8), Position = UDim2.fromScale(0.02, 0.1), TextXAlignment = Enum.TextXAlignment.Left }, row)
	local price = label("Preco", S.prices[key] or (if id == 0 then t("soon") else "…"), { Size = UDim2.fromScale(0.2, 0.8), Position = UDim2.fromScale(0.55, 0.1), TextColor3 = PAL.Sun }, row)
	local b = pillButton("Comprar", t("buy"), PAL.Laje, { Size = UDim2.fromScale(0.2, 0.8), Position = UDim2.fromScale(0.98, 0.1), AnchorPoint = Vector2.new(1, 0) }, row)
	setEnabled(b, id ~= 0)
	if id ~= 0 and not S.prices[key] then
		fetchPrice(key, id, isPass, price)
	end
	b.Activated:Connect(function()
		if id == 0 then
			return
		end
		pcall(function()
			if isPass then
				MarketplaceService:PromptGamePassPurchase(localPlayer, id)
			else
				MarketplaceService:PromptProductPurchase(localPlayer, id)
			end
		end)
	end)
end

refreshShop = function(u: UI)
	clearChildren(u.shopList, "Frame")
	clearChildren(u.shopList, "TextLabel")
	clearChildren(u.shopList, "TextButton")
	if os.time() - S.pricesAt > C.PRICE_CACHE then
		S.prices = {}
		S.pricesAt = os.time()
	end
	local order = 0
	local function header(text: string)
		order += 1
		label("Cabecalho", text, { Size = UDim2.fromScale(1, 0.06), LayoutOrder = order, TextColor3 = PAL.Gray, TextXAlignment = Enum.TextXAlignment.Left }, u.shopList)
	end
	header(t("passes"))
	for _, key in Config.PASS_ORDER do
		order += 1
		shopRow(u, key, true, order)
	end
	header(t("products"))
	for _, key in Config.PRODUCT_ORDER do
		order += 1
		shopRow(u, key, false, order)
	end
	order += 1
	local invite = pillButton("Convidar", t("invite"), PAL.Hill, { Size = UDim2.fromScale(1, 0.085), LayoutOrder = order }, u.shopList)
	invite.Activated:Connect(function()
		pcall(function()
			SocialService:PromptGameInvite(localPlayer)
		end)
	end)
end

-- Elementos do HUD ------------------------------------------------------------------------------------------

local function refreshCarretel(u: UI)
	local cap = math.max(1, S.CarretelCap)
	local frac = math.clamp(S.Carretel / cap, 0, 1)
	u.carretelFill.Size = UDim2.fromScale(frac, 1)
	u.carretelText.Text = `{t("reel")} {fmtNumber(S.Carretel)} / {fmtNumber(S.CarretelCap)}`
end

local function refreshRate(u: UI)
	u.rate.Text = t("perSec", { n = fmtDecimal(S.Rate) })
end

local function refreshFaixa(u: UI)
	local n = S.faixa
	local mult = Config.FAIXA_MULT[n] or Config.VARAL_MULT
	u.faixa.Text = t("band", { n = n, name = t("band" .. n), mult = fmtDecimal(mult) })
	local fight = n >= 3
	u.faixa.BackgroundColor3 = if fight then PAL.Laje else PAL.UIBg
	u.faixa.TextColor3 = if fight then PAL.UIText else PAL.Gray
end

local function refreshShield(u: UI, now: number)
	local left = S.NovatoUntil - now
	local visible = S.Novato and left > 0
	u.shield.Visible = visible
	if visible then
		u.shield.Text = t("shield", { time = fmtClock(left) })
	end
end

-- Banner de evento/boost pelos atributos de workspace.World (§7.4).
local function refreshBanner(u: UI, now: number)
	local world = Workspace:FindFirstChild("World")
	local text, color = "", PAL.Red
	if world then
		local name = attrString(world, "EventName", "")
		local phase = attrString(world, "EventPhase", "")
		local endsAt = attrNumber(world, "EventEndsAt", 0)
		local rajadaUntil = attrNumber(world, "BoostRajadaUntil", 0)
		local ventoUntil = attrNumber(world, "BoostVentoUntil", 0)
		if name ~= "" and phase ~= "" and endsAt > now then
			local vars = { event = t("event_" .. name), time = fmtClock(endsAt - now) }
			text = if phase == "Warn" then t("eventWarn", vars) else t("eventNow", vars)
			color = if phase == "Warn" then PAL.Lilac else PAL.Red
		elseif world:GetAttribute("Festival") == true then
			text = "▲ " .. t("event_Festival")
			color = PAL.Pink
		elseif rajadaUntil > now then
			text = t("boostBanner", { event = t("event_Rajada"), time = fmtClock(rajadaUntil - now), name = attrString(world, "BoostBy", "") })
			color = PAL.Sky
		elseif ventoUntil > now then
			text = t("boostBanner", { event = t("item_PROD_VENTO_FORTE"), time = fmtClock(ventoUntil - now), name = attrString(world, "BoostBy", "") })
			color = PAL.Sky
		end
	end
	u.banner.Visible = text ~= ""
	if text ~= "" then
		u.banner.Text = text
		u.banner.BackgroundColor3 = color
	end
end

-- Cartas do varal: toque = selecionar, toque longo (PET_HOLD) = estimação.
local function refreshCards(u: UI)
	clearChildren(u.cards, "Frame")
	local cardH = 0.07 / 0.64 -- carta de 0,07 da tela dentro da coluna de 0,64
	for i, k in S.Kites do
		local rc = Config.RARITY_COLORS[k.rarity] or PAL.Gray
		local selected = k.id == S.Selected
		local card = frame(`Carta{k.id}`, { Size = UDim2.fromScale(1, cardH), LayoutOrder = i }, u.cards)
		corner(card)
		stroke(card, if selected then PAL.UIText else rc)
		local swatch = frame("Cor", { Size = UDim2.fromScale(0, 0.26), Position = UDim2.fromScale(0.88, 0.22), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45, BackgroundColor3 = kiteColor(k) }, card)
		aspect(swatch, 1)
		stroke(swatch, PAL.Outline, 1)
		label("Nome", kiteName(k.model, k.season), { Size = UDim2.fromScale(0.74, 0.42), Position = UDim2.fromScale(0.04, 0.03), TextXAlignment = Enum.TextXAlignment.Left, FontFace = FONT_BLACK }, card)
		label("Raridade", rarityName(k.rarity) .. (if k.pet then " " .. t("pet") else ""), { Size = UDim2.fromScale(0.92, 0.26), Position = UDim2.fromScale(0.04, 0.45), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rc }, card)
		local posMult = if selected then (Config.FAIXA_MULT[S.faixa] or Config.VARAL_MULT) else Config.VARAL_MULT
		local renda = if selected then t("inAir") .. " " else ""
		label("Renda", renda .. t("perSec", { n = fmtDecimal(Config.baseRate(k) * posMult) }), { Size = UDim2.fromScale(0.92, 0.24), Position = UDim2.fromScale(0.04, 0.72), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = PAL.Sun }, card)
		local hit = button("Toque", "", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, card)
		local t0 = 0
		hit.InputBegan:Connect(function(input: InputObject)
			if isPress(input) then
				t0 = os.clock()
			end
		end)
		hit.InputEnded:Connect(function(input: InputObject)
			if not isPress(input) or t0 == 0 then
				return
			end
			local held = os.clock() - t0
			t0 = 0
			if held >= C.PET_HOLD then
				local cb = HUD.onPet
				if cb then
					cb(k.id)
				end
			elseif not selected then
				local cb = HUD.onSelect
				if cb then
					cb(k.id)
				end
			end
		end)
	end
end

-- Onboarding (§6): dica + anel no botão (1-3) ou seta 3D (4-6) conforme o passo do funil e a faixa.
local function onboardingTarget(step: number): Vector3?
	if step == 4 then
		return S.lastLandPos
	elseif step == 5 then
		return carretelPos()
	elseif step == 6 then
		return Config.BAR_POS
	end
	return nil
end

function HUD.onboardingStep(n: number): ()
	local u = ui
	if not u then
		return
	end
	S.onbStep = n
	local remover = S.arrowRemove
	if remover then
		remover()
		S.arrowRemove = nil
	end
	local show = n >= 1 and n <= 6
	u.hint.Visible = show
	u.pullRing.Visible = n >= 1 and n <= 3
	if not show then
		return
	end
	local text = t("onb" .. n)
	u.hint.Text = text
	local target = onboardingTarget(n)
	if target then
		S.arrowRemove = KiteRenderer.arrow3D(target, text)
	end
end

local function refreshOnboarding(now: number)
	if S.lastLandPos and now > S.lastLandUntil then
		S.lastLandPos = nil
	end
	local step = 0
	if S.Novato and S.Onboarding < 6 then
		local o = S.Onboarding
		if o <= 1 then
			step = 1
		elseif o == 2 or o == 3 then
			step = if S.faixa >= 2 then 3 else 2
		elseif o == 4 then
			step = 4
		else
			step = if S.Carretel > 0 then 5 else 6
		end
	end
	local target = onboardingTarget(step)
	local key = `{step}:{if target then tostring(target) else ""}`
	if step ~= S.onbStep or key ~= S.onbKey then
		S.onbKey = key
		HUD.onboardingStep(step)
	end
end

-- API pública -------------------------------------------------------------------------------------------------

function HUD.setPressed(down: boolean): ()
	local u = ui
	if not u then
		return
	end
	local info = TweenInfo.new(C.PRESS_SECONDS)
	TweenService:Create(u.pullScale, info, { Scale = if down then C.PRESS_SCALE else 1 }):Play()
	u.pullBtn.BackgroundColor3 = if down then PAL.Laje:Lerp(PAL.Outline, 0.3) else PAL.Laje
end

function HUD.setDuel(active: boolean, endsAt: number, opponent: string?): ()
	local u = ui
	if not u then
		return
	end
	S.duelActive = active
	S.duelEndsAt = endsAt
	u.duel.Visible = active
	if active then
		u.duelNames.Text = t("duelVs", { a = t("you"), b = opponent or "?", linha = S.duelLinha })
		u.duelFill.Size = UDim2.fromScale(1, 1)
	end
	u.pullText.Text = if active then t("hold") else t("pull")
	u.pullText.TextTransparency = 0
end

-- {seed, restockAt, slots = {StockSlot & {bought}}}
function HUD.setStock(stock: { [string]: any }): ()
	S.stock = stock
	local u = ui
	if u and S.panel == "bar" then
		refreshBar(u)
	end
end

-- Patch de State (§7.3): só os campos presentes mudam.
function HUD.applyState(patch: { [string]: any }): ()
	local rateChanged = patch.Rate ~= nil and num(patch.Rate, S.Rate) ~= S.Rate
	S.Vento = num(patch.Vento, S.Vento)
	S.Carretel = num(patch.Carretel, S.Carretel)
	S.CarretelCap = num(patch.CarretelCap, S.CarretelCap)
	S.Rate = num(patch.Rate, S.Rate)
	S.Linha = num(patch.Linha, S.Linha)
	S.Vagas = num(patch.Vagas, S.Vagas)
	S.Temporadas = num(patch.Temporadas, S.Temporadas)
	S.Selected = num(patch.Selected, S.Selected)
	S.NovatoUntil = num(patch.NovatoUntil, S.NovatoUntil)
	S.Onboarding = num(patch.Onboarding, S.Onboarding)
	if typeof(patch.Kites) == "table" then
		S.Kites = patch.Kites
	end
	if typeof(patch.Streak) == "table" then
		S.Streak = patch.Streak
	end
	if typeof(patch.Dailies) == "table" then
		S.Dailies = patch.Dailies
	end
	if patch.Novato ~= nil then
		S.Novato = patch.Novato == true
	end
	local u = ui
	if not u then
		return
	end
	if S.shownVento < 0 then
		S.shownVento = S.Vento
	end
	if rateChanged then
		refreshRate(u)
		pop(u.rateScale)
	end
	if patch.Carretel ~= nil or patch.CarretelCap ~= nil then
		refreshCarretel(u)
	end
	if patch.Kites ~= nil or patch.Selected ~= nil then
		refreshCards(u)
	end
	if patch.Streak ~= nil or patch.Dailies ~= nil then
		refreshBadge(u)
		if S.panel == "mail" then
			refreshMail(u)
		end
	end
	if S.panel == "bar" and (patch.Vento ~= nil or patch.Linha ~= nil or patch.Vagas ~= nil) then
		refreshBar(u)
	end
	if S.panel == "rebirth" and (patch.Vento ~= nil or patch.Kites ~= nil or patch.Temporadas ~= nil) then
		refreshRebirth(u)
	end
end

-- Toasts (§7.3): cada kind com os args combinados com o servidor.
function HUD.toast(kind: string, args: { [string]: any }): ()
	local u = ui
	if not u then
		return
	end
	local a: Patch = if typeof(args) == "table" then args else {}
	local kite = if typeof(a.kite) == "string" then kiteName(a.kite, nil) else ""
	local rarity = num(a.rarity, 0)
	local name = if typeof(a.name) == "string" then a.name else ""
	if kind == "Cortou" then
		flash(u, t("cut"), PAL.Green)
		HUD.setDuel(false, 0, nil)
	elseif kind == "Voou" then
		flash(u, t("flew"), PAL.Red)
		if a.shield == true then
			toastText(u, t("shieldBack"), PAL.Sky)
		end
		HUD.setDuel(false, 0, nil)
	elseif kind == "Sorte" then
		flash(u, t("luck"), PAL.Sun)
	elseif kind == "Pegou" then
		flash(u, t("caught", { kite = kite, rarity = string.upper(rarityName(rarity)) }), Config.RARITY_COLORS[rarity] or PAL.Sun)
	elseif kind == "PegaramSua" then
		toastText(u, t("someoneCaught", { name = name, kite = kite }), PAL.Red)
	elseif kind == "Voada" then
		local wild = a.wild == true or name == ""
		toastText(u, if wild then t("flewWild", { kite = kite }) else t("flewBanner", { kite = kite, name = name }), Config.RARITY_COLORS[rarity] or PAL.UIText)
		if typeof(a.landPos) == "Vector3" then
			S.lastLandPos = a.landPos
			S.lastLandUntil = num(a.untilTime, serverNow() + C.LAND_MEMORY)
		end
	elseif kind == "Duelo" then
		S.duelLinha = num(a.linha, 0)
		local opponent = if a.wild == true then t("wild") elseif typeof(a.opponent) == "string" then a.opponent else nil
		HUD.setDuel(true, num(a.endsAt, serverNow() + Config.RABEIO_TIME + Config.DUEL_TIME), opponent)
	elseif kind == "Dourada" then
		if a.blank == true then
			toastText(u, t("goldenBlank"), PAL.Gray)
		else
			toastText(u, t("golden", { kite = kite, name = name }), Config.RARITY_COLORS[5])
		end
	elseif kind == "Arvore" then
		toastText(u, t("tree", { time = fmtClock(num(a.time, Config.TREE_TIME)) }), PAL.Hill)
	elseif kind == "VendaAuto" then
		toastText(u, t("autoSold", { kite = kite, n = fmtNumber(num(a.n, 0)) }), PAL.Sun)
	elseif kind == "Offline" then
		u.offlineText.Text = t("offline", { n = fmtNumber(num(a.n, 0)), time = fmtLong(num(a.time, 0)) })
		openPanel(u, "offline")
	elseif kind == "Streak" then
		local text = t("streakGot", { day = num(a.day, 0), n = fmtNumber(num(a.n, 0)) })
		if kite ~= "" then
			text ..= " + " .. kite
		end
		toastText(u, text, PAL.Sun)
	elseif kind == "Evento" then
		local event = if typeof(a.event) == "string" then t("event_" .. a.event) else ""
		local endsAt = num(a.endsAt, serverNow())
		local vars = { event = event, time = fmtClock(endsAt - serverNow()) }
		toastText(u, if a.phase == "Warn" then t("eventWarn", vars) else t("eventNow", vars), PAL.Lilac)
		refreshBanner(u, serverNow())
	elseif kind == "Renasceu" then
		flash(u, t("renasceu", { n = num(a.n, S.Temporadas) }), PAL.Lilac)
	elseif kind == "Boost" then
		toastText(u, t(if a.kind == "Rajada" then "boostRajada" else "boostVento", { name = name }), PAL.Sky)
	elseif kind == "Erro" then
		toastText(u, if typeof(a.msg) == "string" then a.msg else t("errDefault"), PAL.Red)
	else
		toastText(u, kind, PAL.Gray)
	end
end

-- Conexões dos botões ---------------------------------------------------------------------------------------

local function wire(u: UI)
	-- PUXAR: InputBegan/InputEnded no botão; soltura global por segurança (dedo que sai do botão)
	u.pullBtn.InputBegan:Connect(function(input: InputObject)
		if isPress(input) then
			S.pressedByButton = true
			local cb = HUD.onPull
			if cb then
				cb(true)
			end
		end
	end)
	local function release(input: InputObject)
		if isPress(input) and S.pressedByButton then
			S.pressedByButton = false
			local cb = HUD.onPull
			if cb then
				cb(false)
			end
		end
	end
	u.pullBtn.InputEnded:Connect(release)
	UserInputService.InputEnded:Connect(release)

	u.collectBtn.Activated:Connect(function()
		local cb = HUD.onCollect
		if cb then
			cb()
		end
	end)
	u.btnBar.Activated:Connect(function()
		openPanel(u, "bar")
	end)
	u.btnMail.Activated:Connect(function()
		openPanel(u, "mail")
	end)
	u.btnRebirth.Activated:Connect(function()
		openPanel(u, "rebirth")
	end)
	u.btnShop.Activated:Connect(function()
		openPanel(u, "shop")
	end)
	-- Som: a v1 não tem áudio (sem assets externos); o botão guarda a preferência em HUD.soundOn.
	u.btnSound.Activated:Connect(function()
		S.soundOn = not S.soundOn
		HUD.soundOn = S.soundOn
		toastText(u, t("soundState", { state = t(if S.soundOn then "on" else "off") }), PAL.Gray)
		u.btnSound.BackgroundTransparency = if S.soundOn then 0 else 0.4
	end)
	u.barLinha.Activated:Connect(function()
		local cb = HUD.onBuy
		if cb then
			cb("Linha", nil)
		end
	end)
	u.barVaga.Activated:Connect(function()
		local cb = HUD.onBuy
		if cb then
			cb("Vaga", nil)
		end
	end)
	local function claim(which: string)
		return function()
			local cb = HUD.onClaim
			if cb then
				cb(which)
			end
		end
	end
	u.mailStreakBtn.Activated:Connect(claim("Streak"))
	u.mailCutsBtn.Activated:Connect(claim("Cortes"))
	u.mailCatchBtn.Activated:Connect(claim("Pegas"))
	u.rebirthBtn.Activated:Connect(function()
		local cb = HUD.onRebirth
		if cb then
			cb()
		end
		closePanels(u)
	end)
	-- Prompt "Ver estoque" do balcão (MapGen): abre o painel do Bar como o botão BAR.
	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		if prompt.Name == "VerEstoque" and S.panel ~= "bar" then
			openPanel(u, "bar")
		end
	end)
end

HUD.soundOn = true

-- Loops --------------------------------------------------------------------------------------------------------

-- A cada frame: count-up do Vento, barra do duelo, piscar de "SEGURA!", anel do onboarding.
local function frameTick(u: UI, dt: number)
	if S.shownVento ~= S.Vento then
		local before = math.floor(S.shownVento)
		S.shownVento += (S.Vento - S.shownVento) * math.min(1, dt * C.COUNT_UP)
		if math.abs(S.Vento - S.shownVento) < 0.5 then
			S.shownVento = S.Vento
		end
		if math.floor(S.shownVento) ~= before or S.shownVento == S.Vento then
			u.vento.Text = `{fmtNumber(S.shownVento)} {t("wind")}`
		end
	end
	local clock = os.clock()
	if S.duelActive then
		local left = math.clamp((S.duelEndsAt - serverNow()) / Config.DUEL_TIME, 0, 1)
		u.duelFill.Size = UDim2.fromScale(left, 1)
		local on = math.sin(clock * 2 * math.pi * C.BLINK_HZ) > 0
		u.duelHold.TextTransparency = if on then 0 else 0.6
		u.pullText.TextTransparency = if on then 0 else 0.5
	end
	if u.pullRing.Visible then
		u.pullRingStroke.Transparency = 0.5 + 0.5 * math.sin(clock * 2 * math.pi * C.RING_HZ)
	end
end

-- A cada SLOW_TICK: faixa da própria pipa, distâncias, escudo, banner, relógio do Bar, fim do duelo, onboarding.
local function slowTick(u: UI)
	local now = serverNow()
	local conf = ownConf()
	local faixa = if conf then attrNumber(conf, "Faixa", 0) else 0
	local status = if conf then attrString(conf, "Status", "") else ""
	if faixa ~= S.faixa or status ~= S.ownStatus then
		S.faixa = faixa
		S.ownStatus = status
		refreshFaixa(u)
		refreshCards(u)
	end

	local root = rootPart()
	local nearCarretel, nearBar = false, false
	if root then
		local c = carretelPos()
		nearCarretel = c ~= nil and (root.Position - c).Magnitude <= Config.COLLECT_DIST
		nearBar = (root.Position - Config.BAR_POS).Magnitude <= Config.SHOP_OPEN_DIST
	end
	if nearCarretel ~= S.nearCarretel then
		S.nearCarretel = nearCarretel
		u.collectBtn.Visible = nearCarretel
	end
	if nearBar ~= S.nearBar then
		S.nearBar = nearBar
		u.btnBar.Visible = nearBar
		if not nearBar and S.panel == "bar" then
			closePanels(u)
		end
	end

	refreshShield(u, now)
	refreshBanner(u, now)
	if S.panel == "bar" then
		refreshBarClock(u)
	end
	if S.duelActive and now > S.duelEndsAt + Config.HOLD_GRACE + Config.DUEL_TIME then
		HUD.setDuel(false, 0, nil) -- resultado não chegou: fecha a barra
	end
	refreshOnboarding(now)
end

-- Botão PUXAR em px: BUTTON_HEIGHT da altura da tela, nunca menor que BUTTON_MIN_PX (§6); o anel é 18 % maior.
local function fitButton(u: UI)
	local px = math.max(C.BUTTON_MIN_PX, math.floor(u.gui.AbsoluteSize.Y * C.BUTTON_HEIGHT))
	u.pullBtn.Size = UDim2.fromOffset(px, px)
	local ring = math.floor(px * 1.18)
	u.pullRing.Size = UDim2.fromOffset(ring, ring)
end

local function refreshAll(u: UI)
	fitButton(u)
	u.vento.Text = `{fmtNumber(math.max(0, S.shownVento))} {t("wind")}`
	refreshRate(u)
	refreshCarretel(u)
	refreshFaixa(u)
	refreshCards(u)
	refreshBadge(u)
end

-- Constrói a UI, liga os botões e os loops. Idempotente.
function HUD.start(): ()
	if ui then
		return
	end
	local u = build()
	ui = u
	wire(u)
	if S.shownVento < 0 then
		S.shownVento = S.Vento
	end
	refreshAll(u)
	u.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		fitButton(u)
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		frameTick(u, dt)
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= C.SLOW_TICK then
			acc = 0
			slowTick(u)
		end
	end)
	-- respawn: o ScreenGui não reseta (ResetOnSpawn = false); só solta o botão se estava apertado
	localPlayer.CharacterAdded:Connect(function()
		if S.pressedByButton then
			S.pressedByButton = false
			local cb = HUD.onPull
			if cb then
				cb(false)
			end
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">KiteRenderer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	KiteRenderer — tudo o que o cliente desenha em 3D, só com Parts, Tweens e BillboardGuis (GDD §2.9, §4, §7.2).

	• Pipas: assina a tag "Kite" (Configurations em workspace.KiteStates, atributos §7.4) → attach/detach.
	  Cada raridade tem forma própria (losango / Estrela / Arraia / Morcegão / Luz / Capivara), cor
	  Config.COLORS[color] (Temporada n = HSV), dourada = Neon dourado + ParticleEmitter padrão (sem textura).
	  Linha = Cylinder do carretel da laje do dono até o corpo; rabiola com balanço senoidal (escondida a mais
	  de TAIL_HIDE_DIST da câmera); BillboardGui "dono · pipa (raridade) · Ln" ou "Selvagem · pipa (raridade)".
	  Pos é lida a cada frame para a própria pipa e a Config.SYNC_HZ para as outras; o render interpola a
	  KITE_MOVE_SPEED (mais rápido se ficou para trás; salto > SNAP_DIST não interpola).
	  Status: Dueling → linha/pipa tremem e 4 faíscas no ponto médio; Falling → gira 360°/s Y e 90°/s Z e
	  acende o marcador no LandPos; Ground/Tree → parada; detach (pega) → encolhe em SHRINK_SECONDS.
	• Varal: assina a tag "Laje" e o atributo VaralCodes → miniaturas (1 Part cada) penduradas no Part "Varal".
	• Marcador (coluna Neon no LandPos), setas 3D do onboarding, rastro do rabeio, burst da coleta e
	  balões de emote (atributo Emote do Player, GDD §5.8).
	Requer SÓ Config. Orçamento de Parts no cliente ≈ 450 (GDD §4.3). Muretas Neon do VIP ficam com o MapGen.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local LocalizationService = game:GetService("LocalizationService")
local Workspace = game:GetService("Workspace")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local C = Config.CLIENT
local PAL = Config.PALETTE
local GOLD = Config.RARITY_COLORS[5] -- dourado = cor da Lendária (255,190,40)
local FONT_BOLD = Font.fromEnum(Enum.Font.GothamBold)
local FONT_BLACK = Font.fromEnum(Enum.Font.GothamBlack)

local STATUS_FLYING, STATUS_DUELING, STATUS_FALLING, STATUS_GROUND, STATUS_TREE = "Flying", "Dueling", "Falling", "Ground", "Tree"

local KiteRenderer = {}

-- Render de uma pipa no ar (um por Configuration com tag Kite).
type Render = {
	conf: Configuration,
	id: number,
	owner: number, -- userId (0 = selvagem)
	own: boolean, -- é a pipa do jogador local (lerp a cada frame)
	wild: boolean,
	model: string,
	rarity: number,
	color: number,
	golden: boolean,
	rig: Model, -- corpo + peças + rabiola
	body: BasePart,
	line: Part, -- Cylinder carretel → corpo
	tail: { Part },
	label: TextLabel,
	pos: Vector3, -- posição renderizada
	target: Vector3, -- último Pos lido do atributo
	nextSync: number, -- os.clock() da próxima leitura (outras pipas)
	snapped: boolean,
	status: string,
	lastStatus: string,
	spinT: number, -- segundos caindo (giro)
	tailHidden: boolean,
	sparks: { Part }?, -- faíscas do duelo (só na pipa de menor Id do par)
	conns: { RBXScriptConnection },
}

-- Peça de uma pipa: tamanho, deslocamento e giro em Z relativos ao corpo (plano XY, fina em Z).
type Piece = { size: Vector3, offset: Vector3, rotZ: number, color: Color3?, material: Enum.Material?, shape: Enum.PartType? }

local localPlayer = Players.LocalPlayer
local locale = LocalizationService.RobloxLocaleId

local renders: { [Configuration]: Render } = {}
local byId: { [number]: Render } = {}
local carretelByLaje: { [number]: BasePart } = {}
local varalMinis: { [Model]: { Model } } = {}
local varalConns: { [Model]: RBXScriptConnection } = {}
local markers: { [string]: { part: Part, untilTime: number } } = {}
local arrows: { [WedgePart]: { base: Vector3, phase: number } } = {}
local emoteConns: { [Player]: RBXScriptConnection } = {}
local emoteBubbles: { [Player]: BillboardGui } = {}
local fxFolder: Folder? = nil
local started = false

-- Ajudantes --------------------------------------------------------------------------------------

local function str(key: string, vars: { [string]: any }?): string
	return Config.str(key, locale, vars)
end

-- Pasta workspace/KiteRender com tudo o que este módulo cria.
local function fx(): Folder
	local folder = fxFolder
	if folder and folder.Parent then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = "KiteRender"
	created.Parent = Workspace
	fxFolder = created
	return created
end

local function attrNumber(inst: Instance, name: string, default: number): number
	local v = inst:GetAttribute(name)
	return if typeof(v) == "number" then v else default
end

local function attrString(inst: Instance, name: string, default: string): string
	local v = inst:GetAttribute(name)
	return if typeof(v) == "string" then v else default
end

local function attrBool(inst: Instance, name: string): boolean
	return inst:GetAttribute(name) == true
end

local function attrVector(inst: Instance, name: string): Vector3?
	local v = inst:GetAttribute(name)
	if typeof(v) == "Vector3" then
		return v
	end
	return nil
end

local function hex(c: Color3): string
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

-- Cor da pipa: dourada → ouro; Temporada n → HSV; senão Config.COLORS[color] (0 = Jornal).
local function colorOf(color: number, golden: boolean): Color3
	if golden then
		return GOLD
	end
	if color >= Config.SEASON_COLOR_BASE then
		local n = color - Config.SEASON_COLOR_BASE
		return Color3.fromHSV((n * Config.SEASON_HUE.step) % 1, Config.SEASON_HUE.sat, Config.SEASON_HUE.val)
	end
	return Config.COLORS[color] or Config.COLORS[0]
end

local function stylePart(part: BasePart, color: Color3, material: Enum.Material)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function newPart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	stylePart(part, color, material)
	part.Parent = parent
	return part
end

local function newLabel(text: string, color: Color3, font: Font, parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.RichText = true
	label.FontFace = font
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = PAL.Outline
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function newBillboard(name: string, size: UDim2, up: number, maxDist: number, onTop: boolean): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = size
	gui.StudsOffset = Vector3.new(0, up, 0)
	gui.MaxDistance = maxDist
	gui.LightInfluence = 0
	gui.AlwaysOnTop = onTop
	gui.ResetOnSpawn = false
	return gui
end

-- Formas (uma por raridade; Raio/Pipeiro = Arraia, Temporada = Morcegão) -----------------------------

local function piecesFor(rarity: number): { Piece }
	local thin = 0.12
	if rarity == 2 then -- Estrela: losango + 2 barras cruzadas
		return {
			{ size = Vector3.new(1.7, 1.7, thin), offset = Vector3.zero, rotZ = 45 },
			{ size = Vector3.new(2.8, 0.7, thin), offset = Vector3.zero, rotZ = 30 },
			{ size = Vector3.new(2.8, 0.7, thin), offset = Vector3.zero, rotZ = -30 },
		}
	elseif rarity == 3 then -- Arraia: corpo largo, 2 asas e ferrão
		return {
			{ size = Vector3.new(2.6, 1.3, thin), offset = Vector3.zero, rotZ = 0 },
			{ size = Vector3.new(1.6, 0.6, thin), offset = Vector3.new(-1.5, 0.35, 0), rotZ = 30 },
			{ size = Vector3.new(1.6, 0.6, thin), offset = Vector3.new(1.5, 0.35, 0), rotZ = -30 },
			{ size = Vector3.new(0.15, 1.3, thin), offset = Vector3.new(0, -1.2, 0), rotZ = 0 },
		}
	elseif rarity == 4 then -- Morcegão: corpo largo, 2 asas angulosas, 2 orelhas
		return {
			{ size = Vector3.new(3.0, 1.3, thin), offset = Vector3.zero, rotZ = 0 },
			{ size = Vector3.new(2.0, 1.0, thin), offset = Vector3.new(-2.1, 0.2, 0), rotZ = 25 },
			{ size = Vector3.new(2.0, 1.0, thin), offset = Vector3.new(2.1, 0.2, 0), rotZ = -25 },
			{ size = Vector3.new(0.35, 0.6, thin), offset = Vector3.new(-0.7, 0.9, 0), rotZ = 15 },
			{ size = Vector3.new(0.35, 0.6, thin), offset = Vector3.new(0.7, 0.9, 0), rotZ = -15 },
		}
	elseif rarity == 5 then -- Pipa de Luz: losango Neon + 2 barras Neon brancas cruzadas
		return {
			{ size = Vector3.new(2.2, 2.2, thin), offset = Vector3.zero, rotZ = 45, material = Enum.Material.Neon },
			{ size = Vector3.new(3.2, 0.25, thin + 0.02), offset = Vector3.zero, rotZ = 45, material = Enum.Material.Neon, color = PAL.White },
			{ size = Vector3.new(3.2, 0.25, thin + 0.02), offset = Vector3.zero, rotZ = -45, material = Enum.Material.Neon, color = PAL.White },
		}
	elseif rarity == 6 then -- Capivara Voadora: bicho marrom com vela losango na cor da pipa
		return {
			{ size = Vector3.new(2.0, 1.1, 1.0), offset = Vector3.new(0, -0.3, 0), rotZ = 0, color = PAL.Dirt },
			{ size = Vector3.new(0.9, 0.9, 0.9), offset = Vector3.new(1.2, 0.1, 0), rotZ = 0, color = PAL.Dirt, shape = Enum.PartType.Ball },
			{ size = Vector3.new(0.25, 0.3, 0.25), offset = Vector3.new(1.35, 0.6, 0.25), rotZ = 0, color = PAL.Dirt },
			{ size = Vector3.new(0.25, 0.3, 0.25), offset = Vector3.new(1.35, 0.6, -0.25), rotZ = 0, color = PAL.Dirt },
			{ size = Vector3.new(1.8, 1.8, thin), offset = Vector3.new(-0.3, 1.2, 0), rotZ = 45 },
		}
	end
	-- Comum (Jornal / Lisa): losango
	return { { size = Vector3.new(2.2, 2.2, thin), offset = Vector3.zero, rotZ = 45 } }
end

-- Model da pipa com PrimaryPart "Body" na origem. scale < 0.6 (miniaturas do varal) usa só a peça principal.
function KiteRenderer.build(model: string, rarity: number, color: number, golden: boolean, scale: number): Model
	local rig = Instance.new("Model")
	rig.Name = model
	local base = colorOf(color, golden)
	local detailed = scale >= 0.6
	for i, piece in piecesFor(rarity) do
		if i > 1 and not detailed then
			break
		end
		local part = Instance.new("Part")
		part.Name = if i == 1 then "Body" else `Peca{i}`
		part.Size = piece.size * scale
		if piece.shape then
			part.Shape = piece.shape
		end
		local pieceColor = if golden then GOLD else (piece.color or base)
		local material = if golden then Enum.Material.Neon else (piece.material or Enum.Material.SmoothPlastic)
		stylePart(part, pieceColor, material)
		part.CFrame = CFrame.new(piece.offset * scale) * CFrame.Angles(0, 0, math.rad(piece.rotZ))
		part.Parent = rig
		if i == 1 then
			rig.PrimaryPart = part
		end
	end
	if golden and detailed then -- Dourada: partículas padrão (sem textura) GOLDEN_PARTICLES/s
		local emitter = Instance.new("ParticleEmitter")
		emitter.Rate = C.GOLDEN_PARTICLES
		emitter.Lifetime = NumberRange.new(0.8, 1.4)
		emitter.Speed = NumberRange.new(1, 2)
		emitter.Size = NumberSequence.new(0.35)
		emitter.Color = ColorSequence.new(GOLD)
		emitter.LightEmission = 1
		emitter.Parent = rig.PrimaryPart
	end
	return rig
end

-- Efeitos ------------------------------------------------------------------------------------------

-- Rastro do rabeio: TRAIL_PARTS Parts brancas Neon ao longo do caminho, somem em TRAIL_SECONDS.
local function trail(from: Vector3, to: Vector3)
	local size = Vector3.new(C.TRAIL_SIZE, C.TRAIL_SIZE, C.TRAIL_SIZE)
	local info = TweenInfo.new(C.TRAIL_SECONDS)
	for i = 1, C.TRAIL_PARTS do
		local part = newPart("Rastro", size, PAL.White, Enum.Material.Neon, nil)
		local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5)
		part.Position = from:Lerp(to, i / C.TRAIL_PARTS) + jitter
		part.Parent = fx()
		local tween = TweenService:Create(part, info, { Transparency = 1 })
		tween.Completed:Connect(function()
			part:Destroy()
		end)
		tween:Play()
	end
end

-- n Parts Neon de `color` voam de pos até a câmera em BURST_SECONDS (coleta no carretel).
function KiteRenderer.burst(pos: Vector3, color: Color3, n: number): ()
	local cam = Workspace.CurrentCamera
	local to = if cam then cam.CFrame.Position + cam.CFrame.LookVector * 3 else pos + Vector3.new(0, 10, 0)
	local size = Vector3.new(C.BURST_SIZE, C.BURST_SIZE, C.BURST_SIZE)
	local info = TweenInfo.new(C.BURST_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for _ = 1, n do
		local part = newPart("Burst", size, color, Enum.Material.Neon, nil)
		local spread = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 2
		part.Position = pos + spread
		part.Parent = fx()
		local tween = TweenService:Create(part, info, { Position = to + spread, Transparency = 1 })
		tween.Completed:Connect(function()
			part:Destroy()
		end)
		tween:Play()
	end
end

-- Coluna Neon MARKER_SIZE na cor da raridade em pos até untilTime (GetServerTimeNow). Mesmo ponto → só estende.
function KiteRenderer.showMarker(pos: Vector3, untilTime: number, rarity: number): ()
	local key = `{math.floor(pos.X)}_{math.floor(pos.Z)}`
	local existing = markers[key]
	if existing then
		existing.untilTime = math.max(existing.untilTime, untilTime)
		return
	end
	local part = newPart("Marcador", C.MARKER_SIZE, Config.RARITY_COLORS[rarity] or PAL.Gray, Enum.Material.Neon, nil)
	part.Transparency = C.MARKER_TRANSPARENCY
	part.Position = Vector3.new(pos.X, pos.Y + C.MARKER_SIZE.Y / 2, pos.Z)
	part.Parent = fx()
	markers[key] = { part = part, untilTime = untilTime }
end

-- Seta de onboarding: WedgePart Neon flutuando ARROW_HEIGHT acima de pos com bob ±ARROW_BOB + texto. Devolve o removedor.
function KiteRenderer.arrow3D(pos: Vector3, text: string): () -> ()
	local wedge = Instance.new("WedgePart")
	wedge.Name = "Seta"
	wedge.Size = C.ARROW_SIZE
	stylePart(wedge, PAL.Sun, Enum.Material.Neon)
	local gui = newBillboard("Texto", UDim2.fromOffset(260, 50), 2.5, 500, true)
	newLabel(text, PAL.Sun, FONT_BLACK, gui)
	gui.Parent = wedge
	wedge.CFrame = CFrame.new(pos + Vector3.new(0, C.ARROW_HEIGHT, 0))
	wedge.Parent = fx()
	arrows[wedge] = { base = pos, phase = math.random() * 2 * math.pi }
	return function()
		arrows[wedge] = nil
		wedge:Destroy()
	end
end

-- Pega: a pipa encolhe até sumir em SHRINK_SECONDS e é destruída.
local function shrinkAndDestroy(rig: Model)
	task.spawn(function()
		local t0 = os.clock()
		while rig.Parent do
			local k = (os.clock() - t0) / C.SHRINK_SECONDS
			if k >= 1 then
				break
			end
			rig:ScaleTo(math.max(0.01, 1 - k))
			RunService.Heartbeat:Wait()
		end
		rig:Destroy()
	end)
end

-- Linha, rabiola e Billboard ---------------------------------------------------------------------------

local function ownerPlayer(r: Render): Player?
	if r.owner == 0 then
		return nil
	end
	return Players:GetPlayerByUserId(r.owner)
end

-- Topo do carretel da laje do dono (atributo Laje do Player → Part com tag Carretel e LajeIndex igual).
local function lineAnchor(r: Render): Vector3?
	local p = ownerPlayer(r)
	if not p then
		return nil
	end
	local carretel = carretelByLaje[attrNumber(p, "Laje", 0)]
	if not carretel then
		return nil
	end
	return carretel.Position + Vector3.new(0, C.LINE_ANCHOR_UP, 0)
end

local function kiteName(model: string, color: number): string
	return str("kite_" .. model, { n = math.max(0, color - Config.SEASON_COLOR_BASE) })
end

local function billboardText(r: Render): string
	local kite = kiteName(r.model, r.color)
	local rarity = str("rarity" .. r.rarity)
	if r.wild then
		return `{str("wild")} · {kite} ({rarity})`
	end
	local name = attrString(r.conf, "OwnerName", "")
	local p = ownerPlayer(r)
	if p and attrBool(p, "VIP") then -- VIP: nome dourado
		name = `<font color="{hex(GOLD)}">{name}</font>`
	end
	return `{name} · {kite} ({rarity}) · L{attrNumber(r.conf, "Linha", 1)}`
end

-- Cor/material da rabiola: RabiolaRank 1-3 (ouro/prata/bronze), VIP Neon dourada, senão branca.
local function tailStyle(r: Render): (Color3, Enum.Material)
	local p = ownerPlayer(r)
	if p then
		local rankColor = Config.RABIOLA_COLORS[attrNumber(p, "RabiolaRank", 0)]
		if rankColor then
			return rankColor, Enum.Material.Neon
		end
		if attrBool(p, "VIP") then
			return GOLD, Enum.Material.Neon
		end
	end
	return PAL.White, Enum.Material.SmoothPlastic
end

-- CFrame do corpo: olha para o carretel (ou para o centro), inclinada TILT_DEG; Dueling treme; Falling gira; Ground deitada.
local function kiteCFrame(r: Render, anchor: Vector3?, now: number): CFrame
	local pos = r.pos
	if r.status == STATUS_FALLING then
		return CFrame.new(pos) * CFrame.Angles(0, math.rad(C.FALL_SPIN_Y) * r.spinT, math.rad(C.FALL_SPIN_Z) * r.spinT)
	elseif r.status == STATUS_GROUND then
		return CFrame.new(pos) * CFrame.Angles(-math.pi / 2, 0, 0)
	end
	local face = anchor or Vector3.zero
	local flat = Vector3.new(face.X, pos.Y, face.Z)
	if (flat - pos).Magnitude < 0.5 then
		flat = pos + Vector3.new(0, 0, 1)
	end
	local cf = CFrame.lookAt(pos, flat) * CFrame.Angles(math.rad(-C.TILT_DEG), 0, 0)
	if r.status == STATUS_DUELING then
		cf = cf * CFrame.new(math.sin(now * 2 * math.pi * C.DUEL_SHAKE_HZ) * C.DUEL_SHAKE, 0, 0)
	end
	return cf
end

local function updateLine(r: Render, anchor: Vector3?, bodyPos: Vector3)
	local visible = anchor ~= nil and (r.status == STATUS_FLYING or r.status == STATUS_DUELING)
	if not visible or not anchor then
		r.line.Transparency = 1
		return
	end
	local delta = bodyPos - anchor
	local len = delta.Magnitude
	if len < 0.1 then
		r.line.Transparency = 1
		return
	end
	r.line.Transparency = 0
	r.line.Size = Vector3.new(len, C.LINE_THICKNESS, C.LINE_THICKNESS)
	r.line.CFrame = CFrame.lookAt(anchor + delta / 2, bodyPos) * CFrame.Angles(0, math.pi / 2, 0)
end

local function updateTail(r: Render, cf: CFrame, now: number, camPos: Vector3)
	local far = (cf.Position - camPos).Magnitude > C.TAIL_HIDE_DIST
	local hidden = far or r.status == STATUS_GROUND or r.status == STATUS_TREE
	if hidden ~= r.tailHidden then
		r.tailHidden = hidden
		for _, part in r.tail do
			part.Transparency = if hidden then 1 else 0
		end
	end
	if hidden then
		return
	end
	for i, part in r.tail do
		local x = math.sin(now * 2 * math.pi * C.TAIL_HZ + i * 0.9) * C.TAIL_SWAY
		part.CFrame = cf * CFrame.new(x, -(0.9 + 0.6 * i), 0)
	end
end

-- Faíscas do duelo (4 Parts amarelas piscando no ponto médio entre as duas pipas).
local function ensureSparks(r: Render)
	if r.sparks then
		return
	end
	local list: { Part } = {}
	local size = Vector3.new(C.DUEL_SPARK_SIZE, C.DUEL_SPARK_SIZE, C.DUEL_SPARK_SIZE)
	for _ = 1, C.DUEL_SPARKS do
		table.insert(list, newPart("Faisca", size, PAL.Sun, Enum.Material.Neon, fx()))
	end
	r.sparks = list
end

local function clearSparks(r: Render)
	local sparks = r.sparks
	if not sparks then
		return
	end
	for _, part in sparks do
		part:Destroy()
	end
	r.sparks = nil
end

local function updateSparks(r: Render, now: number)
	local sparks = r.sparks
	if not sparks then
		return
	end
	local partner = byId[attrNumber(r.conf, "DuelWith", 0)]
	local mid = if partner then (r.pos + partner.pos) / 2 else r.pos
	for i, part in sparks do
		local a = now * 3 + i * (2 * math.pi / #sparks)
		part.Position = mid + Vector3.new(math.cos(a) * 1.2, math.sin(a * 1.7) * 0.8, math.sin(a) * 1.2)
		part.Transparency = if math.sin(now * 2 * math.pi * C.DUEL_BLINK_HZ + i) > 0 then 0 else 0.7
	end
end

-- Mudança de Status: rastro + faíscas ao entrar em duelo; marcador ao começar a cair.
local function onStatusChanged(r: Render, serverNow: number)
	local s = r.status
	if s == STATUS_DUELING then
		local duelWith = attrNumber(r.conf, "DuelWith", 0)
		if duelWith == 0 or r.id < duelWith then
			ensureSparks(r)
		end
		if (r.target - r.pos).Magnitude > 2 then -- quem mergulhou deixa rastro
			trail(r.pos, r.target)
		end
	else
		clearSparks(r)
	end
	if s == STATUS_FALLING then
		r.spinT = 0
		local land = attrVector(r.conf, "LandPos")
		if land and land.Magnitude > 0 then
			KiteRenderer.showMarker(land, attrNumber(r.conf, "StatusUntil", serverNow) + Config.GROUND_TIME, r.rarity)
		end
	end
	r.lastStatus = s
end

-- attach / detach --------------------------------------------------------------------------------------

local function remove(r: Render, shrink: boolean)
	renders[r.conf] = nil
	if byId[r.id] == r then
		byId[r.id] = nil
	end
	for _, conn in r.conns do
		conn:Disconnect()
	end
	clearSparks(r)
	r.line:Destroy()
	if shrink then
		shrinkAndDestroy(r.rig)
	else
		r.rig:Destroy()
	end
end

-- Cria o render de um KiteState (Configuration com atributos §7.4) e começa a interpolar.
function KiteRenderer.attach(conf: Configuration): ()
	if renders[conf] then
		return
	end
	local owner = attrNumber(conf, "Owner", 0)
	local model = attrString(conf, "Model", "Lisa")
	local rarity = attrNumber(conf, "Rarity", 1)
	local color = attrNumber(conf, "Color", 1)
	local golden = attrBool(conf, "Golden")
	local rig = KiteRenderer.build(model, rarity, color, golden, 1)
	local body = rig.PrimaryPart
	if not body then
		rig:Destroy()
		return
	end
	local pos = attrVector(conf, "Pos") or Vector3.zero
	rig:PivotTo(CFrame.new(pos))

	local line = newPart("Linha", Vector3.new(1, C.LINE_THICKNESS, C.LINE_THICKNESS), PAL.White, Enum.Material.SmoothPlastic, nil)
	line.Shape = Enum.PartType.Cylinder
	line.Transparency = 1

	local gui = newBillboard("Nome", UDim2.fromOffset(220, 44), C.BILLBOARD_UP, C.BILLBOARD_DIST, false)
	local label = newLabel("", Config.RARITY_COLORS[rarity] or PAL.White, FONT_BOLD, gui)
	gui.Parent = body

	local r: Render = {
		conf = conf,
		id = attrNumber(conf, "Id", 0),
		owner = owner,
		own = owner ~= 0 and owner == localPlayer.UserId,
		wild = attrBool(conf, "Wild"),
		model = model,
		rarity = rarity,
		color = color,
		golden = golden,
		rig = rig,
		body = body,
		line = line,
		tail = {},
		label = label,
		pos = pos,
		target = pos,
		nextSync = 0,
		snapped = true,
		status = attrString(conf, "Status", STATUS_FLYING),
		lastStatus = "",
		spinT = 0,
		tailHidden = false,
		sparks = nil,
		conns = {},
	}
	local tailColor, tailMaterial = tailStyle(r)
	for i = 1, C.TAIL_PARTS do
		local part = newPart(`Rabiola{i}`, Vector3.new(0.25, 0.25, 0.25), tailColor, tailMaterial, rig)
		table.insert(r.tail, part)
	end
	r.label.Text = billboardText(r)
	renders[conf] = r
	byId[r.id] = r
	rig.Parent = fx()
	line.Parent = fx()

	table.insert(r.conns, conf:GetAttributeChangedSignal("Linha"):Connect(function()
		r.label.Text = billboardText(r)
	end))
	table.insert(r.conns, conf:GetAttributeChangedSignal("Golden"):Connect(function() -- Vento Dourado: reconstrói
		if attrBool(conf, "Golden") ~= r.golden then
			remove(r, false)
			KiteRenderer.attach(conf)
		end
	end))
end

-- Remove o render (pega: encolhe antes de sumir).
function KiteRenderer.detach(conf: Configuration): ()
	local r = renders[conf]
	if r then
		remove(r, true)
	end
end

-- Varal (tag Laje + atributo VaralCodes) ------------------------------------------------------------------

-- codes = "model:rarity:color:golden,…" → miniaturas penduradas no Part "Varal" da laje, a cada VARAL_STEP studs.
function KiteRenderer.renderVaral(laje: Model, codes: string): ()
	local old = varalMinis[laje]
	if old then
		for _, mini in old do
			mini:Destroy()
		end
	end
	varalMinis[laje] = nil
	local varal = laje:FindFirstChild("Varal")
	if not varal or not varal:IsA("BasePart") or codes == "" then
		return
	end
	local minis: { Model } = {}
	for code in string.gmatch(codes, "[^,]+") do
		if #minis >= Config.VAGAS_MAX then
			break
		end
		local model, rarity, color, golden = string.match(code, "^(%w+):(%d+):(%d+):(%a+)$")
		if model and rarity and color and golden then
			table.insert(minis, KiteRenderer.build(model, tonumber(rarity) or 1, tonumber(color) or 0, golden == "true", C.VARAL_SCALE))
		end
	end
	local count = #minis
	for i, mini in minis do
		local x = (i - 1 - (count - 1) / 2) * C.VARAL_STEP
		mini:PivotTo(varal.CFrame * CFrame.new(x, -C.VARAL_HANG, 0))
		mini.Parent = fx()
	end
	varalMinis[laje] = minis
end

local function hookLaje(inst: Instance)
	if not inst:IsA("Model") or varalConns[inst] then
		return
	end
	local function refresh()
		KiteRenderer.renderVaral(inst, attrString(inst, "VaralCodes", ""))
	end
	varalConns[inst] = inst:GetAttributeChangedSignal("VaralCodes"):Connect(refresh)
	refresh()
end

local function unhookLaje(inst: Instance)
	if not inst:IsA("Model") then
		return
	end
	local conn = varalConns[inst]
	if conn then
		conn:Disconnect()
	end
	varalConns[inst] = nil
	local minis = varalMinis[inst]
	if minis then
		for _, mini in minis do
			mini:Destroy()
		end
	end
	varalMinis[inst] = nil
end

-- Carretéis (tag Carretel + LajeIndex): âncora da linha ----------------------------------------------------

local function hookCarretel(inst: Instance)
	if inst:IsA("BasePart") then
		carretelByLaje[attrNumber(inst, "LajeIndex", 0)] = inst
	end
end

local function unhookCarretel(inst: Instance)
	if inst:IsA("BasePart") then
		local i = attrNumber(inst, "LajeIndex", 0)
		if carretelByLaje[i] == inst then
			carretelByLaje[i] = nil
		end
	end
end

-- Emotes-balão (atributo Emote do Player = "emoteN" por EMOTE_SECONDS) -------------------------------------

local function showEmote(p: Player, key: string)
	local old = emoteBubbles[p]
	if old then
		old:Destroy()
		emoteBubbles[p] = nil
	end
	if key == "" then
		return
	end
	local character = p.Character
	local head = if character then character:FindFirstChild("Head") else nil
	if not head or not head:IsA("BasePart") then
		return
	end
	local gui = newBillboard("Emote", UDim2.fromOffset(180, 56), C.EMOTE_BUBBLE_UP, 200, true)
	local bubble = Instance.new("Frame")
	bubble.Size = UDim2.fromScale(1, 1)
	bubble.BackgroundColor3 = PAL.UIBg
	bubble.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = bubble
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = C.STROKE_PX
	stroke.Color = PAL.Sun
	stroke.Parent = bubble
	newLabel(str(key), PAL.UIText, FONT_BLACK, bubble)
	bubble.Parent = gui
	gui.Parent = head
	emoteBubbles[p] = gui
	task.delay(Config.EMOTE_SECONDS, function()
		if emoteBubbles[p] == gui then
			emoteBubbles[p] = nil
			gui:Destroy()
		end
	end)
end

local function hookPlayer(p: Player)
	emoteConns[p] = p:GetAttributeChangedSignal("Emote"):Connect(function()
		showEmote(p, attrString(p, "Emote", ""))
	end)
end

local function unhookPlayer(p: Player)
	local conn = emoteConns[p]
	if conn then
		conn:Disconnect()
	end
	emoteConns[p] = nil
	local bubble = emoteBubbles[p]
	if bubble then
		bubble:Destroy()
	end
	emoteBubbles[p] = nil
end

-- Loop por frame -----------------------------------------------------------------------------------------

local function step(dt: number)
	local now = os.clock()
	local serverNow = Workspace:GetServerTimeNow()
	local cam = Workspace.CurrentCamera
	local camPos = if cam then cam.CFrame.Position else Vector3.zero

	for conf, r in renders do
		-- leitura do alvo: própria pipa a cada frame, as outras a SYNC_HZ
		if r.own or now >= r.nextSync then
			r.nextSync = now + 1 / Config.SYNC_HZ
			local p = attrVector(conf, "Pos")
			if p then
				r.target = p
			end
			r.status = attrString(conf, "Status", r.status)
		end
		-- interpolação a KITE_MOVE_SPEED (ou mais rápido se ficou para trás); salto grande não interpola
		local delta = r.target - r.pos
		local dist = delta.Magnitude
		if not r.snapped or dist > C.SNAP_DIST then
			r.pos = r.target
			r.snapped = true
		elseif dist > 0.001 then
			local speed = math.max(Config.KITE_MOVE_SPEED, dist * C.CATCHUP)
			local stepLen = math.min(dist, speed * dt)
			r.pos = r.pos + delta * (stepLen / dist)
		end
		if r.status ~= r.lastStatus then
			onStatusChanged(r, serverNow)
		end
		if r.status == STATUS_FALLING then
			r.spinT += dt
		end
		local anchor = lineAnchor(r)
		local cf = kiteCFrame(r, anchor, now)
		r.rig:PivotTo(cf)
		updateLine(r, anchor, cf.Position)
		updateTail(r, cf, now, camPos)
		if r.sparks then
			updateSparks(r, now)
		end
	end

	for key, marker in markers do -- marcadores vencidos
		if serverNow > marker.untilTime then
			marker.part:Destroy()
			markers[key] = nil
		end
	end

	for wedge, a in arrows do -- setas: bob + giro lento, ponta para baixo
		local y = C.ARROW_HEIGHT + math.sin(now * 2 + a.phase) * C.ARROW_BOB
		wedge.CFrame = CFrame.new(a.base + Vector3.new(0, y, 0)) * CFrame.Angles(0, now * C.ARROW_SPIN, 0) * CFrame.Angles(math.pi / 2, 0, 0)
	end
end

local function onKiteAdded(inst: Instance)
	if inst:IsA("Configuration") then
		KiteRenderer.attach(inst)
	end
end

local function onKiteRemoved(inst: Instance)
	if inst:IsA("Configuration") then
		KiteRenderer.detach(inst)
	end
end

-- Assina as tags Kite, Laje e Carretel, os emotes dos jogadores e o loop por frame.
function KiteRenderer.start(): ()
	if started then
		return
	end
	started = true
	fx()
	for _, inst in CollectionService:GetTagged("Carretel") do
		hookCarretel(inst)
	end
	CollectionService:GetInstanceAddedSignal("Carretel"):Connect(hookCarretel)
	CollectionService:GetInstanceRemovedSignal("Carretel"):Connect(unhookCarretel)

	for _, inst in CollectionService:GetTagged("Laje") do
		hookLaje(inst)
	end
	CollectionService:GetInstanceAddedSignal("Laje"):Connect(hookLaje)
	CollectionService:GetInstanceRemovedSignal("Laje"):Connect(unhookLaje)

	for _, inst in CollectionService:GetTagged("Kite") do
		onKiteAdded(inst)
	end
	CollectionService:GetInstanceAddedSignal("Kite"):Connect(onKiteAdded)
	CollectionService:GetInstanceRemovedSignal("Kite"):Connect(onKiteRemoved)

	for _, p in Players:GetPlayers() do
		hookPlayer(p)
	end
	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(unhookPlayer)

	RunService.RenderStepped:Connect(step)
end

return KiteRenderer
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
