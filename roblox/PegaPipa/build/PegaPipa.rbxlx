ptBR.item_PASS_VENTO_DOBRO, en.item_PASS_VENTO_DOBRO = "Vento em Dobro", "Double Wind"
ptBR.item_PASS_CARRETEL_AUTO, en.item_PASS_CARRETEL_AUTO = "Carretel Automático", "Auto Reel"
